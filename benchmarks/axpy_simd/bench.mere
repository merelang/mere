// axpy_simd -- the axpy row written with explicit f64x2 lanes: two elements per
// step through f64x2_load / f64x2_mul / f64x2_add / f64x2_store. The C row is
// the same scalar program, which clang auto-vectorizes; the expectation is a
// TIE between the two, and with the axpy row -- explicit lanes must not lose
// to what the optimizer finds on its own, or they are not worth writing.
// Same construction, arithmetic order and bit-pattern output as axpy. The row that forced range-check versioning (Q-108): with a
// bounds check per element the loop has three early exits and clang leaves it
// scalar; with the range checked once before the loop it is vectorized, and
// the passes TIE with C. Memory-bound at this size, so SIMD itself is worth
// ~1.3x here; the check's shape was the rest of the gap. What the row carries
// above C is building the two Vecs by vec_push (about 10 ms at v0.1.421: the
// LCG plus the buffer's growth steps), which the C row does into a malloc'd
// array -- so the pass count is high enough for the loop to be the number.
//
// Same LCG, same non-dyadic inputs and same bit-pattern output as matmul, for
// the same reason: the answer has to be the same bytes on every row before any
// time is reported, and a formatted double hides the bits where fusion or a
// different summation order would show.
let n = match args () with | Cons (a, _) -> int_of_str a | Nil -> 2000000;
let reps = 100;

let mk = fn (seed: int) ->
  let v = vec_new () in
  let rec fill = fn (i: int) -> fn (x: int) ->
    if i == n then ()
    else
      let x2 = (1103515245 * x + 12345) % 2147483648 in
      let _ = vec_push v (f_div (float_of_int (x2 % 2001 - 1000)) 1000.0) in
      fill (i + 1) x2 in
  let _ = fill 0 seed in
  v;

let a = mk 20260905;
let c = mk 77770707;
let alpha = 1.5;

let alpha2 = f64x2_splat alpha;
let rec axpy = fn (i: int) ->
  if i == n then ()
  else
    let _ = f64x2_store c i (f64x2_add (f64x2_load c i) (f64x2_mul alpha2 (f64x2_load a i))) in
    axpy (i + 2);
let rec rep = fn (r: int) -> if r == reps then () else let _ = axpy 0 in rep (r + 1);
let _ = rep 0;

let rec total = fn (i: int) -> fn (acc: float) ->
  if i == n then acc else total (i + 1) (f_add acc (vec_get c i));
let s = total 0 0.0;
let _ = print ("n " ++ str_of_int n) in
let _ = print ("checksum " ++ str_of_int (float_bits_hi s) ++ " " ++ str_of_int (float_bits_lo s)) in
exit 0
