// binarytrees, with a region per TREE instead of a region per batch.
//
// bench_region.mere draws the boundary around a whole depth's batch, so one
// arena holds every tree of that depth until the batch ends: 2^20 nodes of
// 24 bytes, a 28 MiB peak. Drawing it around the single expression that
// builds and checks one tree -- `check (build d)` -- reclaims each tree the
// moment its answer is an int. The batch loop is unchanged and stays a tail
// call: the region wraps the ARGUMENT of the recursive call, not the call.
//
// What it costs: 87,376 arena acquire/release pairs, each a pointer swap and a
// bump reset from the per-thread cache. What it buys: the peak falls to the
// long-lived tree plus one tree in flight. Measured at v0.1.413 on arm64:
// 5.8 MiB peak RSS against the batch block's 28.1 MiB and the naive program's
// 169 MiB -- the same footprint as the Rust row, and a third of the C row's
// wall clock, because a bump allocator that hands each tree back never grows a
// working set. One line differs from bench_region.mere.

type tree = Leaf | Branch of tree * tree;

let rec build = fn (d: int) ->
  if d == 0 then Leaf else Branch (build (d - 1), build (d - 1));

let rec check = fn (t: tree) ->
  match t with
  | Leaf -> 1
  | Branch (l, r) -> 1 + check l + check r;

let rec pow2 = fn (n: int) -> if n == 0 then 1 else 2 * pow2 (n - 1);

let maxdepth = match args () with | Cons (a, _) -> int_of_str a | Nil -> 14;

let longlived = build maxdepth;

let rec batch = fn (d: int) -> fn (iters: int) -> fn (acc: int) ->
  // Each tree is born in R and dies with it; only the int leaves.
  if iters == 0 then acc else batch d (iters - 1) (acc + (region R { check (build d) }));

let rec depths = fn (d: int) ->
  if d > maxdepth then ()
  else
    let iters = pow2 (maxdepth - d + 4) in
    let total = batch d iters 0 in
    let _ = print (str_of_int iters ++ " trees of depth " ++ str_of_int d
                   ++ " check " ++ str_of_int total) in
    depths (d + 2);

let _ = depths 4 in
let _ = print ("long-lived tree of depth " ++ str_of_int maxdepth
               ++ " check " ++ str_of_int (check longlived)) in
exit 0
