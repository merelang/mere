// crc32 -- compute-bound over a byte stream, almost no allocation.
//
// The comparison this workload exists for is against C: Mere lowers to C and
// is then compiled by the same clang, so the honest expectation here is a TIE,
// and the number worth watching is any gap that opens up. Against the managed
// runtimes it is a per-byte interpreter-loop comparison and the outcome is not
// in doubt; it is recorded anyway so the table has a scale on it.
//
// Written on `bytes` (v0.1.216) and not on `read_file_bytes`. The first
// version of this benchmark used the latter, which returns `Vec[R, int]` --
// one 64-bit int per byte -- and reported Mere at 2.9x C and 12x its memory.
// That was a measurement of the wrong API: the stdlib reference says of
// `read_file_bytes`, in the same table row, "costs eight bytes per byte;
// prefer read_bytes". A benchmark author reaching for the obviously-named
// builtin is exactly who that sentence is for, and exactly who did not read
// it. bench_vecint.mere keeps the old version, because the gap between the
// two rows is the actual finding.

let mask32 = 0xFFFFFFFF;

let crc_byte = fn crc -> fn b ->
  let x = bit_xor crc b in
  let rec go = fn i -> fn c ->
    if i == 8 then c
    else
      let c2 = if bit_and c 1 == 1
               then bit_xor (bit_shr c 1) 0xEDB88320
               else bit_shr c 1 in
      go (i + 1) c2 in
  go 0 x;

let args_v = args ();
let path = match args_v with | Cons (p, _) -> p | Nil -> "" in
if str_eq path "" then print "usage: bench <file>"
else
  let data = read_bytes path in
  let n = bytes_len data in
  let rec go = fn i -> fn crc ->
    if i == n then crc
    else go (i + 1) (crc_byte crc (bytes_get data i)) in
  let crc = bit_xor (go 0 mask32) mask32 in
  let _ = print ("bytes " ++ str_of_int n) in
  let _ = print ("crc32 " ++ str_of_int crc) in
  // Every Mere program echoes its final expression, and `print` evaluates to
  // unit -- so without this the process would emit a trailing "()" that no
  // other implementation emits. Suppressing it here rather than filtering it
  // in the runner keeps the same-answer check a plain equality.
  exit 0
