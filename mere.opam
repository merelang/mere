# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis:
  "An ML-family language with explicit regions and capability effects"
description:
  "Mere is a small ML-family programming language implemented in OCaml. It features Hindley-Milner type inference with let-polymorphism, a region/view-based memory model with refined borrow modes, capability-passing effects, a tree-walking interpreter, and code generation for C, LLVM IR, Wasm and RISC-V. The repository documents backend-specific support and validation."
maintainer: ["Kazuma Furuhashi <k.furuhashi10@gmail.com>"]
authors: ["Kazuma Furuhashi <k.furuhashi10@gmail.com>"]
license: "MIT"
homepage: "https://github.com/merelang/mere"
bug-reports: "https://github.com/merelang/mere/issues"
depends: [
  "ocaml" {>= "5.1"}
  "dune" {>= "3.0" & >= "3.0"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/merelang/mere.git"
