// Explicit answers cover branch selection, traversal order and byte boundaries.
type Pair = { a: int, b: int };
type Box = Box of int;
let _ = print (show (match (2, 9) with (1, x) | (x, 9) -> x | _ -> 0));
let _ = print (show (match (1, 9) with (1, x) | (x, 9) -> x | _ -> 0));
let _ = print (show (match (3, 9) with (1, x) | (2, x) | (x, 9) -> x | _ -> 0));
let _ = print (show (match (1, 2) with (x, _) | (_, x) when x == 2 -> 7 | _ -> 99));
let _ = print (show (match (1, 2) with (_x, _) | (_, _x) when (let _ = print "guard" in false) -> 7 | _ -> 98));
let _ = print (show (match (1, 2) with (x, x) -> x));
let _ = print (show (match (1, "abc") with (x, x) -> str_len x));
let _ = print (show (match (1, 2) with ((x, x) as x) -> x));
let _ = print (show (match Box 14 with ((Box x) as whole) -> x + (match whole with Box y -> y)));
let _ = print (show (match 2 with (1 | 2) -> 7 | _ -> 0));
let _ = print (show (match (2, 4) with ((1 | 2), (3 | 4)) -> 8 | _ -> 0));
let _ = print (show (match Box 2 with Box (1 | 2) -> 9 | _ -> 0));
let _ = print (show (match Pair { a = 2, b = 4 } with Pair { a = (1 | 2), b = (3 | 4) } -> 10 | _ -> 0));
let _ = print (show (match [2, 4] with [(1 | 2), (3 | 4)] -> 11 | _ -> 0));
let _ = print (show (match Pair { a = 1, b = 2 } with Pair { b = x, a = x } -> x));
let _ = print (show (let ((1, x) | (x, 9)) = (2, 9) in x));
let ((1, top) | (top, 9)) = (3, 9);
let later = fn () -> top;
let _ = print (show (later ()));
let _ = print (show (match "abc" with "a" <> tail -> str_len tail | _ -> 99));
let _ = print (show (match "abc" with "x" <> tail | "a" <> tail -> str_len tail | _ -> 99));
let _ = print (show (match "abc" with "a" <> tail | "ab" <> tail when str_len tail == 1 -> 7 | _ -> 97));
let _ = print (show (match ("abc", 5) with (("x" <> tail | "a" <> tail), n) -> str_len tail + n | _ -> 99));
let _ = print (show (match "abc" with ("a" <> tail as whole) -> str_len tail + str_len whole | _ -> 99));
let _ = print (show (match "abc" with "abcd" <> _ -> 99 | "" <> tail -> str_len tail | _ -> 98));
let _ = print (show (match "" with "" <> _ -> 12 | _ -> 99));
let _ = print (show (match "あい" with "あ" <> tail -> str_len tail | _ -> 99));
let _ = print (show (match "a\0bz" with "a\0b" <> tail -> str_len tail | _ -> 99));
let _ = print (show (match "a\0bz" with "a\0c" <> _ -> 99 | _ -> 13));
let _ = print (show (match "a" with "a\0" <> _ -> 99 | _ -> 14));
let __pfx1 = 20;
let _ = print (show (match "abc" with "a" <> tail -> __pfx1 + str_len tail | _ -> 99));
let captured = match (2, 9) with (1, x) | (x, 9) -> fn () -> x | _ -> fn () -> 0;
let _ = print (show (captured ()));
let captured_tail = match "abc" with "x" <> tail | "a" <> tail -> fn () -> str_len tail | _ -> fn () -> 99;
let _ = print (show (captured_tail ()));
let _ = print (show (match (let _ = print "subject" in (2, 9)) with (1, x) | (x, 9) -> x | _ -> 99));
let _ = print (show (match "a\0b" with "a\0c" -> 99 | _ -> 15));
let _ = print (show (match "a\0b" with "a" <> tail -> str_len tail | _ -> 99));
let _ = print (show (let x = 10 in let y = (let ((1, x) | (x, 9)) = (2, 9) in x) in x + y));
let _ = print (show (let x = 10 in let y = (let "a" <> x = "abc" in str_len x) in x + y));
()
