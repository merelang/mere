// Sockets, readiness and resource limits on RISC-V (v0.1.641): the C runtime's
// own calls, which memu answers from the host. A listener on loopback (port 0,
// so the kernel picks), its address, a client connected to it, bytes across
// both ways through fd_write / fd_read, a readiness set that sees them, a
// socket pair, and a resource limit read back. rv_exec compares every line with
// the C backend's. (No errno is printed: the guest's are Linux's numbers, the
// C reference's the host's.)
extern fn tcp_listen_at: str -> int -> int -> int;
extern fn tcp_connect: str -> int -> int;
extern fn tcp_accept: int -> int;
extern fn tcp_close: int -> unit;
extern fn sock_local_addr: int -> str;
extern fn sock_pair: int -> int;
extern fn sock_unix_bind: int -> str -> int;
extern fn sock_unix_connect: int -> str -> int;
extern fn sys_openlog: str -> int -> int -> int;
extern fn sys_setlogmask: int -> int;
extern fn sys_closelog: unit -> int;
extern fn sock_getopt: int -> int -> int -> str;
extern fn sock_setopt: int -> int -> int -> str -> int;
extern fn io_poll_new: int -> int;
extern fn io_poll_add: int -> int -> int -> int;
extern fn io_poll_wait: int -> int -> int;
extern fn io_poll_get: int -> int -> int;
extern fn proc_rlimit_resource: str -> int;
extern fn proc_getrlimit: str -> int;
extern fn proc_rlimit_field: int -> int;
extern fn fd_write: int -> int -> int -> int;
extern fn fd_read: int -> int -> int -> int;
extern fn fd_close: int -> int;
extern fn socket: int -> int -> int -> int;
extern fn shutdown: int -> int -> int;
extern fn listen: int -> int -> int;
extern fn getppid: unit -> int;
extern fn getpgid: int -> int;
extern fn getsid: int -> int;
extern fn mem_alloc: int -> int;
extern fn mem_copy_str: int -> int -> str -> int;
extern fn mem_to_str: int -> int -> str;
let buf = mem_alloc 128;
let srv = tcp_listen_at "127.0.0.1" 0 8;
let _ = print_int (if srv > 2 then 1 else 0);
let addr = sock_local_addr srv;
// "inet <port> <address>"
let _ = print (if str_starts_with addr "inet " && str_ends_with addr " 127.0.0.1" then "inet, loopback" else "elsewhere: " ++ addr);
let port = int_of_str (substring addr 5 (str_last_index_of addr " "));
let _ = print_int (if port > 0 then 1 else 0);
let cli = tcp_connect "127.0.0.1" port;
let con = tcp_accept srv;
let _ = print_int (if cli > 2 && con > 2 then 1 else 0);
let _ = print_int (fd_write cli buf (mem_copy_str buf 0 "ping"));
let ps = io_poll_new 0;
let _ = print_int (io_poll_add ps con 1);
let _ = print_int (io_poll_wait ps 2000);
let _ = print_int (if io_poll_get ps 0 == con * 8 + 1 then 1 else 0);
let n = fd_read con buf 64;
let _ = print (mem_to_str buf n);
let _ = print_int (fd_write con buf (mem_copy_str buf 0 "pong!"));
let m = fd_read cli buf 64;
let _ = print (mem_to_str buf m);
let _ = print_int (shutdown cli 1);
let _ = print_int (fd_read con buf 64);
let _ = tcp_close cli;
let _ = print_int (fd_read con buf 64);
let _ = tcp_close con;
let _ = tcp_close srv;
let p = sock_pair 1;
let a = p / 1048576;
let b = p % 1048576;
let _ = print_int (fd_write a buf (mem_copy_str buf 0 "pair"));
let k = fd_read b buf 64;
let _ = print (mem_to_str buf k);
let _ = fd_close a;
let _ = fd_close b;
// AF_INET (2, on every platform), SOCK_STREAM
let s4 = socket 2 1 0;
let _ = print_int (if s4 > 2 then 1 else 0);
let _ = print_int (listen s4 5);
// v0.1.643: whose they are differs between the two runs (the C program's
// parent is a shell, the emulator's a timer); that there is one does not
let _ = print_int (if getppid () >= 1 then 1 else 0);
let _ = print_int (if getpgid 0 > 0 then 1 else 0);
let _ = print_int (if getsid 0 > 0 then 1 else 0);
let _ = fd_close s4;
// v0.1.676: a socket at a path (AF_UNIX is 1 on every platform), its
// address, and a connection to it
let up = "/tmp/mere-host-net.sock";
let _ = file_delete up;
let us = socket 1 1 0;
let _ = print_int (sock_unix_bind us up);
let _ = print (sock_local_addr us);
let _ = print_int (listen us 5);
let uc = socket 1 1 0;
let _ = print_int (sock_unix_connect uc up);
let ua = tcp_accept us;
let _ = print_int (fd_write uc buf (mem_copy_str buf 0 "unix"));
let uk = fd_read ua buf 64;
let _ = print (mem_to_str buf uk);
let _ = fd_close ua;
let _ = fd_close uc;
let _ = fd_close us;
let _ = file_delete up;
let _ = print_int (sock_unix_connect (socket 1 1 0) up);
// v0.1.678: socket options -- the numbers are the platform's (sys_os is
// "linux" in the guest, and memu asks the host by its own)
let dw = str_eq (sys_os ()) "darwin";
let os4 = socket 2 1 0;
let _ = print_int (sock_setopt os4 (if dw then 65535 else 1) (if dw then 128 else 13) "0100000007000000");
let _ = print (sock_getopt os4 (if dw then 65535 else 1) (if dw then 128 else 13));
let _ = print (sock_getopt os4 (if dw then 65535 else 1) (if dw then 4104 else 3));
let _ = print_int (sock_setopt os4 6 1 "01000000");
let _ = print_int (if str_eq (sock_getopt os4 6 1) "00000000" then 0 else 1);
let _ = print_int (sock_setopt os4 6 1 "0");
let _ = fd_close os4;
// v0.1.677: the system log's mask, through the host
let _ = print_int (sys_openlog "merehostnet" 0 8);
let _ = print_int (sys_setlogmask 0);
let _ = print_int (sys_setlogmask 31);
let _ = print_int (sys_setlogmask 0);
let _ = sys_setlogmask 255;
let _ = print_int (sys_closelog ());
let _ = print_int (if proc_rlimit_resource "NOFILE" >= 0 then 1 else 0);
let _ = print_int (proc_getrlimit "NOFILE");
print_int (if proc_rlimit_field 0 > 0 then 1 else 0)
