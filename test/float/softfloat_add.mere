// The gate for contrib/softfloat/add: the integer addition must produce the
// SAME 64 BITS as the hardware's, not a value that rounds to about the same
// place. Bit equality is what makes -0.0, the NaN payloads, the subnormal
// boundary and the tie-to-even rule all part of the check instead of things
// somebody has to remember to test.
import "../../contrib/softfloat/add.mere";
import "../../contrib/softfloat/bits.mere";

// A NaN by its bits: exponent all-ones, fraction nonzero. The SIGN and the
// PAYLOAD of a NaN that an OPERATION produces are not specified by IEEE 754 and
// differ by platform -- 0.0/0.0 is +nan on ARM/macOS and -nan on x86/Linux, and
// which input's payload an add propagates is equally free. So when both the
// hardware and this library return a NaN, that is agreement; comparing their
// bits would be testing the platform, not the arithmetic. (The round-trip gate
// still checks exact NaN bits, because THERE no operation generates the NaN --
// a bit pattern goes in and must come back unchanged.)
let _bits_nan = fn (hi: int) -> fn (lo: int) ->
  bit_and hi 2146435072 == 2146435072
  && (bit_and hi 1048575 != 0 || lo != 0);

let fails = vec_new ();
let _ = vec_push fails 0;
let shown = vec_new ();
let _ = vec_push shown 0;

let check = fn (ahi: int) -> fn (alo: int) -> fn (bhi: int) -> fn (blo: int) ->
  let hw = f_add (float_of_bits ahi alo) (float_of_bits bhi blo) in
  let sw = add (sf_of_hi_lo ahi alo) (sf_of_hi_lo bhi blo) in
  let ghi = hi_of_sf sw in let glo = lo_of_sf sw in
  if (ghi == float_bits_hi hw && glo == float_bits_lo hw)
     || (_bits_nan ghi glo && _bits_nan (float_bits_hi hw) (float_bits_lo hw)) then () else
    let _ = vec_set fails 0 (vec_get fails 0 + 1) in
    if vec_get shown 0 >= 12 then () else
      let _ = vec_set shown 0 (vec_get shown 0 + 1) in
      print ("FAIL " ++ str_of_int ahi ++ "," ++ str_of_int alo
             ++ " + " ++ str_of_int bhi ++ "," ++ str_of_int blo
             ++ " hw=" ++ str_of_int (float_bits_hi hw) ++ "," ++ str_of_int (float_bits_lo hw)
             ++ " sw=" ++ str_of_int ghi ++ "," ++ str_of_int glo);

// Every pair from the format's own landmarks, both orders, both signs.
let vhi = vec_new ();
let vlo = vec_new ();
let put = fn (h: int) -> fn (l: int) -> let _ = vec_push vhi h in vec_push vlo l;
let _ = put 0 0;                    // +0
let _ = put 2147483648 0;           // -0
let _ = put 0 1;                    // smallest subnormal
let _ = put 2147483648 1;
let _ = put 0 2;
let _ = put 1048575 4294967295;     // largest subnormal
let _ = put 1048576 0;              // smallest normal
let _ = put 1048576 1;
let _ = put 1071644672 0;           // 0.5
let _ = put 1072693248 0;           // 1.0
let _ = put 3220176896 0;           // -1.0
let _ = put 1072693248 1;           // 1.0 + 1ulp
let _ = put 1073741824 0;           // 2.0
let _ = put 1074266112 0;           // 3.0
let _ = put 2146435071 4294967295;  // largest normal
let _ = put 4293918719 4294967295;  // most negative normal
let _ = put 2146435072 0;           // +inf
let _ = put 4293918720 0;           // -inf
let _ = put 2146959360 0;           // quiet NaN
let _ = put 2146435072 1;           // signalling NaN
let _ = put 1127219200 0;           // 2^53
let _ = put 1127219200 1;           // 2^53 + 1ulp

let n = vec_len vhi;
let rec loop_j = fn (i: int) -> fn (j: int) ->
  if j >= n then () else
  let _ = check (vec_get vhi i) (vec_get vlo i) (vec_get vhi j) (vec_get vlo j) in
  loop_j i (j + 1);
let rec loop_i = fn (i: int) ->
  if i >= n then () else let _ = loop_j i 0 in loop_i (i + 1);
let _ = loop_i 0;

// A sweep, because a table covers the pairs somebody thought of. Two kinds:
// unconstrained bit patterns (mostly enormous exponents, which is where
// overflow to infinity lives) and pairs whose exponents are close together,
// which is where alignment, cancellation and the round bit actually happen.
let rec sweep = fn (i: int) -> fn (seed: int) ->
  if i <= 0 then () else
  let s1 = bit_and (seed * 25214903917 + 11) 4611686018427387903 in
  let s2 = bit_and (s1 * 25214903917 + 11) 4611686018427387903 in
  let s3 = bit_and (s2 * 25214903917 + 11) 4611686018427387903 in
  let s4 = bit_and (s3 * 25214903917 + 11) 4611686018427387903 in
  let ahi = bit_and (bit_shr s1 10) 4294967295 in
  let alo = bit_and (bit_shr s2 10) 4294967295 in
  let bhi = bit_and (bit_shr s3 10) 4294967295 in
  let blo = bit_and (bit_shr s4 10) 4294967295 in
  let _ = check ahi alo bhi blo in
  // the same fractions, with exponents put within 60 of each other around 1023
  let e1 = 1023 + bit_and s1 63 - 32 in
  let e2 = e1 + bit_and s3 63 - 32 in
  let mk_hi = fn (h: int) -> fn (e: int) ->
    bit_or (bit_or (bit_and h 2147483648) (bit_shl (bit_and e 2047) 20)) (bit_and h 1048575) in
  let _ = check (mk_hi ahi e1) alo (mk_hi bhi e2) blo in
  // and a pair one ulp apart, where cancellation leaves almost nothing
  let _ = check (mk_hi ahi e1) alo (bit_xor (mk_hi ahi e1) 2147483648) (bit_and (alo + 1) 4294967295) in
  sweep (i - 1) s4;
let _ = sweep 3000 12345;

// Overflow was the thinnest place in the table: exactly two pairs reached it,
// so moving the boundary from 2047 to 2048 failed only those two. The
// interesting case is not `max + max` but a sum that ROUNDS up into infinity --
// it is finite before the round bit is applied.
let rec sweep_big = fn (i: int) -> fn (seed: int) ->
  if i <= 0 then () else
  let s1 = bit_and (seed * 25214903917 + 11) 4611686018427387903 in
  let s2 = bit_and (s1 * 25214903917 + 11) 4611686018427387903 in
  // both operands in the top binade, where any carry leaves the format
  let e = 2046 in
  let h1 = bit_or (bit_or (bit_and s1 2147483648) (bit_shl e 20)) (bit_and s1 1048575) in
  let h2 = bit_or (bit_or (bit_and s2 2147483648) (bit_shl e 20)) (bit_and s2 1048575) in
  let l1 = bit_and s1 4294967295 in
  let l2 = bit_and s2 4294967295 in
  let _ = check h1 l1 h2 l2 in
  // largest finite, plus something just big enough to round it over the edge
  let _ = check 2146435071 4294967295 (bit_or (bit_shl (1990 + bit_and s1 57) 20) (bit_and s1 1048575)) l1 in
  let _ = check 4293918719 4294967295 (bit_or (bit_or 2147483648 (bit_shl (1990 + bit_and s2 57) 20)) (bit_and s2 1048575)) l2 in
  sweep_big (i - 1) s2;
let _ = sweep_big 600 99;

let f = vec_get fails 0;
let _ = print (if f == 0 then "ok add: every sum matched the hardware bit for bit"
               else "FAILED add: " ++ str_of_int f ++ " sums");
