// Every exported name of contrib/softfloat, called for real, in a program with
// no `float` in it — so `mere -rv` has to lower all of them for the backend
// the library exists for.
//
// This file is hand-written rather than generated because a generator has to
// guess each function's shape, and a wrong guess fails the gate for a reason
// that is not the defect. scripts/softfloat_check.sh asserts that every name
// in the library appears here, so the coverage claim is checked instead of
// trusted.
import "../../contrib/softfloat/limbs.mere";
import "../../contrib/softfloat/add.mere";
import "../../contrib/softfloat/mul.mere";
import "../../contrib/softfloat/div.mere";
import "../../contrib/softfloat/softfloat.mere";

let one = mk 0 1023 0 0 0 0;          // 1.0
let two = mk 0 1024 0 0 0 0;          // 2.0
let tiny = mk 0 0 0 0 0 1;            // the smallest subnormal
let qnan = mk 0 2047 64 0 0 0;

let b2i = fn (b: bool) -> if b then 1 else 0;

let _ = print_int limb_mask;
let _ = print_int exp_mask;
let _ = print_int (zero).exp;
let _ = print_int (neg_zero).sign;
let _ = print_int (inf).exp;
let _ = print_int (neg_inf).sign;
let _ = print_int (nan).f3;
let _ = print_int (b2i (frac_is_zero one));
let _ = print_int (b2i (is_nan qnan));
let _ = print_int (b2i (is_inf inf));
let _ = print_int (b2i (is_zero zero));
let _ = print_int (b2i (is_subnormal tiny));
let _ = print_int (b2i (is_finite one));
let _ = print_int (neg one).sign;
let _ = print_int (abs (neg one)).sign;
let _ = print_int (b2i (is_neg (neg one)));
let _ = print_int (cmp_mag two one);
let _ = print_int (b2i (eq one one));
let _ = print_int (b2i (lt one two));
let _ = print_int (b2i (gt two one));
let _ = print_int (b2i (le one one));
let _ = print_int (b2i (ge one one));

// contrib/softfloat/limbs — the same coverage rule applies: a function nothing
// references is never lowered, so it would pass the RV32I arm without being
// compiled.
let u = l6_of_limbs 0 0 0 1 2 3;
let v = l6_of_limbs 0 0 0 0 5 7;
let _ = print_int lbits;
let _ = print_int lmask;
let _ = print_int (l6_zero).l0;
let _ = print_int (b2i (l6_is_zero l6_zero));
let _ = print_int (l6_cmp u v);
let _ = print_int (l6_add u v).l0;
let _ = print_int (l6_sub u v).l0;
let _ = print_int (l6_limb u 3);
let _ = print_int (l6_shl1 u).l1;
let _ = print_int (l6_shr1 u).l0;
let _ = print_int (l6_low_bit u);
let _ = print_int (l6_shl u 17).l2;
let _ = print_int (snd (l6_shr_sticky u 4));
let _ = print_int (fst (l6_shr_sticky_go u 2 0)).l0;
let _ = print_int (l6_bitlen_limb 300 0);
let _ = print_int (l6_bitlen u);
let _ = print_int (l6_bit u 3);
let _ = print_int (l6_one).l0;

// contrib/softfloat/add
let half = mk 0 1022 0 0 0 0;
let _ = print_int hidden_bit;
let _ = print_int quiet_bit;
let _ = print_int (quiet nan).f3;
let _ = print_int (b2i (is_snan (mk 0 2047 1 0 0 0)));
let _ = print_int (sig_of one).l3;
let _ = print_int (eff_exp tiny);
let _ = print_int (pack 0 (sig_of one) 1023 0).exp;
let _ = print_int (add one one).exp;
let _ = print_int (sub one half).exp;

// contrib/softfloat/mul
let la = sig_limbs one;
let lb = sig_limbs two;
let pv = mul_limbs la lb;
let _ = print_int (prod_limb pv 3);
let _ = print_int (prod_bitlen pv);
let _ = print_int (prod_bits15 pv 7);
let _ = print_int (prod_low_nonzero pv 20);
let (ps, pk, pst) = product_to_l6 pv;
let _ = print_int ps.l0;
let _ = print_int pk;
let _ = print_int pst;
let _ = print_int (mul one two).exp;

// contrib/softfloat/div
let (dn, de) = norm_sig tiny;
let _ = print_int (l6_bitlen dn);
let _ = print_int de;
let (dq, dst) = divide (sig_limbs_l6 one) (sig_limbs_l6 two);
let _ = print_int (l6_bitlen dq);
let _ = print_int dst;
let _ = print_int (fdiv two one).exp;
