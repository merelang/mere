// The bridge between hardware doubles and contrib/softfloat's limbs, shared by
// the gates. It lives in test/ and not in the library because the library must
// compile for a backend that has no `float` at all.
import "../../contrib/softfloat/softfloat.mere";

let br_low15 = 32767;
let br_low20 = 1048575;
let br_low13 = 8191;

let sf_of_hi_lo = fn (hi: int) -> fn (lo: int) ->
  let fh = bit_and hi br_low20 in
  mk (bit_and (bit_shr hi 31) 1)
     (bit_and (bit_shr hi 20) 2047)
     (bit_and (bit_shr fh 13) 127)
     (bit_or (bit_and (bit_shr lo 30) 3) (bit_shl (bit_and fh br_low13) 2))
     (bit_and (bit_shr lo 15) br_low15)
     (bit_and lo br_low15);

let hi_of_sf = fn (a: Sf) ->
  bit_or (bit_or (bit_shl a.sign 31) (bit_shl a.exp 20))
         (bit_or (bit_shr a.f2 2) (bit_shl a.f3 13));

let lo_of_sf = fn (a: Sf) ->
  bit_or (bit_or a.f0 (bit_shl a.f1 15)) (bit_shl (bit_and a.f2 3) 30);

let sf_of_float = fn (x: float) -> sf_of_hi_lo (float_bits_hi x) (float_bits_lo x);
let float_of_sf = fn (a: Sf) -> float_of_bits (hi_of_sf a) (lo_of_sf a);
