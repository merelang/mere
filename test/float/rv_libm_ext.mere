// The RISC-V libm (lib/rv_libm.ml), held to the CORRECTLY ROUNDED value -- not
// to the host's libm, which differs by platform and, on macOS, is one ulp away
// from the true value on 3% to 49% of points for most of these functions.
// scripts/rv_float_check.sh compares this program's output on RV64 (and RV32)
// with rv_libm_ext.expected, which was computed from a 50-digit reference: every
// finite non-special line there is the double nearest the true value.
//
// The points: every input of mere-ruby's corpus/168 (the Ruby Math surface that
// found this), the IEEE special values and each function's domain edges, poles,
// overflow and underflow (where the expectation is C's libm behaviour), sin/cos/
// tan at 1e22 and 1e308 (Payne-Hanek; the old reduction answered sin 1e22 =
// 7.9e91), and six random points per function. The externs are declared with
// libm's signatures, which is what binds them to the prelude on RISC-V; on a
// host they are libm itself.
//
// Bits are printed as four 16-bit chunks: float_bits_hi is unsigned 32-bit and
// prints negative on a 32-bit int (see rv_float_ops.mere).

extern fn acos: float -> float;
extern fn acosh: float -> float;
extern fn asin: float -> float;
extern fn asinh: float -> float;
extern fn atan: float -> float;
extern fn atanh: float -> float;
extern fn cbrt: float -> float;
extern fn cosh: float -> float;
extern fn erf: float -> float;
extern fn erfc: float -> float;
extern fn expm1: float -> float;
extern fn fmod: float -> float -> float;
extern fn hypot: float -> float -> float;
extern fn ldexp: float -> int -> float;
extern fn lgamma: float -> float;
extern fn log10: float -> float;
extern fn log1p: float -> float;
extern fn log2: float -> float;
extern fn sinh: float -> float;
extern fn tanh: float -> float;
extern fn tgamma: float -> float;
let chunks = fn (w: int) -> str_of_int (bit_and (bit_shr w 16) 65535) ++ " " ++ str_of_int (bit_and w 65535);
let show = fn (r: float) -> print (chunks (float_bits_hi r) ++ " " ++ chunks (float_bits_lo r));

