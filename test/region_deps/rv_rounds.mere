// RISC-V: a hundred maps, each compacted (so each has an arena of its own),
// made inside a region that is then left -- twenty times over, with a
// coroutine alive so the arenas are cut from the top of the heap rather than
// from inside the block. The region's rollback takes the maps' cells; their
// arenas go with them (v0.1.694). Before, they stayed, and the twenty rounds
// ran out of a 16 MB machine that holds any one of them.
let root = coro_root ();
let c = coro_new (fn _me -> fn (_u: unit) -> coro_exit root ());
let _ = coro_switch c;
let rec rounds = fn (k: int) ->
  if k == 0 then 0
  else (
    let n = region R {
      let v = vec_new () in
      let rec fill = fn (i: int) ->
        if i == 0 then 0
        else (let t = map_new () in
              let _ = map_compact t in
              let _ = map_set t "x" (str_repeat "w" (8000 + (i * 7919) % 1000)) in
              let _ = map_compact t in
              let _ = vec_push v t in
              fill (i - 1)) in
      let _ = fill 100 in
      vec_len v
    } in
    rounds (k - 1) + n);
let _ = print_int (rounds 20);
print "done"
