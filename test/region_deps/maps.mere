// A thousand maps, each compacted (so each has an arena of its own) and given
// a 300 KB value, made inside a region, which is then left. The maps' structs
// lived in the region's blocks; their arenas go with them (v0.1.688). Before,
// the arenas outlived the region: some 300 MB stayed behind it.
let n = region R {
  let v = vec_new () in
  let rec fill = fn (i: int) ->
    if i == 0 then 0
    else (let t = map_new () in
          let _ = map_compact t in
          let _ = map_set t "x" (str_repeat "w" (300000 + (i * 7919) % 30000)) in
          let _ = map_compact t in
          let _ = vec_push v t in
          fill (i - 1)) in
  let _ = fill 1000 in
  vec_len v
};
let _ = print_int n;
let _ = print "freed";
sleep_ms 3000
