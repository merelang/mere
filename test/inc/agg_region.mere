// The aggregate from agg.mere with the engine's state CARRIED THROUGH a
// `region R loop`, which is the language's answer to a cache that never
// returns anything.
//
// Why this exists: the engine holds every superseded value forever, because
// the default region does not give memory back. `region R loop` does -- it
// deep-copies the carry into a fresh arena every `batch` edits and releases
// the old one whole. The question this program answers is what that costs
// HERE, where the live set is the whole cache and the garbage per edit is two
// strings: the opposite of benchmarks/churn, whose live set is bounded and
// whose garbage is unbounded.
//
// The answers must be identical to agg.mere mode 1. The footprint is the
// difference, and it is measured with MERE_REGION_STATS rather than RSS.
//
// Usage: agg_region <n> <g> <edits> <batch>

import "../../contrib/inc/inc.mere";

let argv = args ();
let arg = fn (k: int) -> fn (d: int) ->
  let rec go = fn (xs: str list) -> fn (i: int) ->
    match xs with
    | Nil -> d
    | Cons (a, rest) -> if i == k then int_of_str a else go rest (i + 1) in
  go argv 0;

let n = arg 0 256;
let g = arg 1 16;
let edits = arg 2 20;
let batch = arg 3 5;

let ngroups = (n + g - 1) / g;
let root_id = n + ngroups;
// two extra slots in the cache carry the loop's own counters, so the carry is
// one value and the loop's state travels with the state it belongs to
let k_j = root_id + 1;
let k_seed = root_id + 2;

let base = vec_new ();
let _ =
  let rec fill = fn (i: int) ->
    if i == n then () else let _ = vec_push base 1 in fill (i + 1) in
  fill 0;

let group_hi = fn (gi: int) -> let hi = gi * g + g in if hi > n then n else hi;
let leaf_text = fn (i: int) -> "L" ++ str_of_int (vec_get base i);
let next_seed = fn (s: int) -> (s * 1103515245 + 12345) % 2147483648;

// The engine is a parameter now, not a top-level binding: each generation has
// a different one, because the carry is deep-copied into the new arena.
let recompute = fn (eng) -> fn (node: int) ->
  if node < n then leaf_text node
  else if node < root_id then
    let gi = node - n in
    let hi = group_hi gi in
    let b = strbuf_new () in
    let rec go = fn (i: int) ->
      if i == hi then () else let _ = strbuf_push b (inc_peek eng i) in go (i + 1) in
    let _ = go (gi * g) in
    strbuf_to_str b
  else
    let rec go = fn (gi: int) -> fn (acc: int) ->
      if gi == ngroups then acc else go (gi + 1) (acc + str_len (inc_peek eng (n + gi))) in
    str_of_int (go 0 0);

let settle = fn (eng) ->
  let rec go = fn (l: int list) ->
    match l with
    | Nil -> ()
    | Cons (node, rest) -> let _ = inc_put eng node (recompute eng node) in go rest in
  go (inc_order eng);

let declare_all = fn (eng) ->
  let rec dec_leaves = fn (i: int) ->
    if i == n then () else let _ = inc_declare eng i Nil in dec_leaves (i + 1) in
  let _ = dec_leaves 0 in
  let rec dec_groups = fn (gi: int) ->
    if gi == ngroups then ()
    else
      let hi = group_hi gi in
      let rec ids = fn (i: int) -> fn (acc: int list) ->
        if i == gi * g then acc else ids (i - 1) (Cons (i - 1, acc)) in
      let _ = inc_declare eng (n + gi) (ids hi Nil) in
      dec_groups (gi + 1) in
  let _ = dec_groups 0 in
  let rec gids = fn (gi: int) -> fn (acc: int list) ->
    if gi == 0 then acc else gids (gi - 1) (Cons (n + gi - 1, acc)) in
  inc_declare eng root_id (gids ngroups Nil);

let out = region R loop x {
  match x with
  | None ->
      let eng = inc_new 0 in
      let _ = declare_all eng in
      let _ = settle eng in
      let _ = inc_put eng k_j "0" in
      let _ = inc_put eng k_seed "12345" in
      Continue eng
  | Some eng ->
      let j = int_of_str (inc_peek eng k_j) in
      if j >= edits then Done (int_of_str (inc_peek eng root_id))
      else
        let hi = if j + batch > edits then edits else j + batch in
        let rec step = fn (jj: int) -> fn (seed: int) ->
          if jj == hi then seed
          else
            let s = next_seed seed in
            let i = s % n in
            let _ = vec_set base i (s % 97) in
            let _ = inc_touch eng i in
            let _ = settle eng in
            step (jj + 1) s in
        let s2 = step j (int_of_str (inc_peek eng k_seed)) in
        let _ = inc_put eng k_j (str_of_int hi) in
        let _ = inc_put eng k_seed (str_of_int s2) in
        Continue eng
};

let _ = print ("root " ++ str_of_int out) in
exit 0
