// range-version: total
// no-dispatch: total
// The call site's arguments are expressions, not atoms, so it is left alone
// and runs the checked loop: dispatching would evaluate them twice.
let n = 8;
let v = vec_new ();
let rec fill = fn (i: int) -> if i == n then () else let _ = vec_push v (i * 3) in fill (i + 1);
let _ = fill 0;
let rec total = fn (i: int) -> fn (acc: int) ->
  if i == n then acc else total (i + 1) (acc + vec_get v i);
print (str_of_int (total (n - 8) (vec_len v - 8)))
