// range-version: walk
// Stride 3 from 1 with an equality exit at 8: 1, 4, 7, 10 -- the loop never
// lands on 8, so the original runs past the Vec and fails at index 10. The
// guard's landing test (8 - 1) % 3 == 0 is false, the checked loop runs, and
// the failure is the same one, at the same index, on every backend.
let n = 8;
let v = vec_new ();
let rec fill = fn (i: int) -> if i == n then () else let _ = vec_push v i in fill (i + 1);
let _ = fill 0;
let _ = print "before";
let rec walk = fn (i: int) -> fn (acc: int) ->
  if i == 8 then acc else let _ = print (str_of_int i) in walk (i + 3) (acc + vec_get v i);
print (str_of_int (walk 1 0))
