// range-version: axpy,total
// The forcing kernel of Q-108: c[i] = c[i] + alpha * a[i] over two invariant
// Vec[R, float]s, then a checksum. Both loops read the containers at exactly
// the index parameter with an invariant bound, so both are planned and both
// call sites (`axpy 0`, `total 0 0.0`) dispatch to the unchecked copy.
let n = 1000;

let mk = fn (seed: int) ->
  let v = vec_new () in
  let rec fill = fn (i: int) -> fn (x: int) ->
    if i == n then ()
    else
      let x2 = (1103515245 * x + 12345) % 2147483648 in
      let _ = vec_push v (f_div (float_of_int (x2 % 2001 - 1000)) 1000.0) in
      fill (i + 1) x2 in
  let _ = fill 0 seed in
  v;

let a = mk 1;
let c = mk 2;
let alpha = 1.5;

let rec axpy = fn (i: int) ->
  if i == n then ()
  else
    let _ = vec_set c i (f_add (vec_get c i) (f_mul alpha (vec_get a i))) in
    axpy (i + 1);
let _ = axpy 0;

let rec total = fn (i: int) -> fn (acc: float) ->
  if i == n then acc else total (i + 1) (f_add acc (vec_get c i));
let s = total 0 0.0;
print ("checksum " ++ str_of_int (float_bits_hi s) ++ " " ++ str_of_int (float_bits_lo s))
