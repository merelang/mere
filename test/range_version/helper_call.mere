// range-version: total
// The body calls a top-level function. It is loop-safe (no lambda, no call
// that could change a Vec's length), so the loop is still planned.
let n = 8;
let v = vec_new ();
let rec fill = fn (i: int) -> if i == n then () else let _ = vec_push v (i * 3) in fill (i + 1);
let _ = fill 0;
let twice = fn (x: int) -> x * 2;
let rec total = fn (i: int) -> fn (acc: int) ->
  if i == n then acc else total (i + 1) (acc + twice (vec_get v i));
print (str_of_int (total 0 0))
