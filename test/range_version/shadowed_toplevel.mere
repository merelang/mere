// range-version: total
// no-dispatch: total
// `v` is rebound at top level before the call: the guard would read the new
// `v`, so the plan is dropped there and the call runs the checked loop, which
// still reads the OLD `v` it closed over.
let n = 8;
let v = vec_new ();
let rec fill = fn (i: int) -> if i == n then () else let _ = vec_push v (i * 3) in fill (i + 1);
let _ = fill 0;
let rec total = fn (i: int) -> fn (acc: int) ->
  if i == n then acc else total (i + 1) (acc + vec_get v i);
let v = vec_new ();
let _ = vec_push v 100;
print (str_of_int (total 0 0))
