// range-version: none
// The body pushes to the Vec it reads: the length the guard would check is
// stale by the second iteration. Must not be planned.
let n = 8;
let v = vec_new ();
let rec fill = fn (i: int) -> if i == n then () else let _ = vec_push v (i * 3) in fill (i + 1);
let _ = fill 0;
let rec grow = fn (i: int) -> if i == n then () else let _ = vec_push v (vec_get v i) in grow (i + 1);
let _ = grow 0;
print (str_of_int (vec_len v))
