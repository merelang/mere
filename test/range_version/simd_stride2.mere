// range-version: axpy,total
// no-dispatch: total
// A stride-2 loop over two-lane loads: every access covers [i, i+2), the exit is
// an equality test, so the guard also requires the loop to land on n exactly.
// `total 0 (f64x2_splat 0.0)` passes a computed argument, so that call site is
// left to the checked loop.
let n = 8;
let mk = fn (seed: int) ->
  let v = vec_new () in
  let rec fill = fn (i: int) ->
    if i == n then () else let _ = vec_push v (f_div (float_of_int (i * seed)) 4.0) in fill (i + 1) in
  let _ = fill 0 in
  v;
let a = mk 3;
let c = mk 5;
let alpha = f64x2_splat 1.5;
let rec axpy = fn (i: int) ->
  if i == n then ()
  else let _ = f64x2_store c i (f64x2_add (f64x2_load c i) (f64x2_mul alpha (f64x2_load a i))) in axpy (i + 2);
let _ = axpy 0;
let rec total = fn (i: int) -> fn (acc: f64x2) ->
  if i == n then acc else total (i + 2) (f64x2_add acc (f64x2_load c i));
let s = total 0 (f64x2_splat 0.0);
let _ = print (str_of_float (f64x2_extract s 0));
let _ = print (str_of_float (f64x2_reduce_add s));
let m = f64x2_make 1.0 2.0;
print (str_of_float (f64x2_extract (f64x2_sub (f64x2_div m (f64x2_splat 2.0)) m) 1))
