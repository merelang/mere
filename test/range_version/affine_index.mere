// range-version: dot,total
// matmul's inner loop: two accesses whose index is affine in k (`i * n + k`,
// `k * n + j`). Monotonic in k, so the guard checks both endpoints of each.
// `row` / `col` push to `c` and are not planned; `dot` and the checksum are.
let n = 6;
let mk = fn (seed: int) ->
  let v = vec_new () in
  let rec fill = fn (i: int) -> fn (x: int) ->
    if i == n * n then ()
    else
      let x2 = (1103515245 * x + 12345) % 2147483648 in
      let _ = vec_push v (f_div (float_of_int (x2 % 2001 - 1000)) 1000.0) in
      fill (i + 1) x2 in
  let _ = fill 0 seed in
  v;
let a = mk 3;
let b = mk 5;
let c = vec_new ();
let rec row = fn (i: int) ->
  if i == n then ()
  else
    let rec col = fn (j: int) ->
      if j == n then ()
      else
        let rec dot = fn (k: int) -> fn (acc: float) ->
          if k == n then acc
          else dot (k + 1) (f_add acc (f_mul (vec_get a (i * n + k)) (vec_get b (k * n + j)))) in
        let _ = vec_push c (dot 0 0.0) in
        col (j + 1) in
    let _ = col 0 in
    row (i + 1);
let _ = row 0;
let rec total = fn (i: int) -> fn (acc: float) ->
  if i == n * n then acc else total (i + 1) (f_add acc (vec_get c i));
let s = total 0 0.0;
print ("checksum " ++ str_of_int (float_bits_hi s) ++ " " ++ str_of_int (float_bits_lo s))
