// range-version: affine,load,store
// Large bounds must select the checked loop even when adding the access width
// would wrap. Exercise both the plain-index and endpoint guards.
let low = let s = bit_shl 1 31 in if s < 0 then s else
  let s = bit_shl 1 62 in if s < 0 then s else bit_shl 1 63;
let high = bit_not low;
let start = high - 1;
let b = bytes_of_str "0123456789abcdef";
let rec load = fn i ->
  if i >= high then () else
    let _ = u8x16_load b i in load (i + 1);
let rec affine = fn i ->
  if i >= high then () else
    let _ = u8x16_load b (i + 0) in affine (i + 1);
let v = vec_new ();
let _ = vec_push v 1.0;
let _ = vec_push v 2.0;
let pair = f64x2_make 9.0 9.0;
let rec store = fn i ->
  if i >= high then () else
    let _ = f64x2_store v i pair in store (i + 1);
let _ = print (try_or (fn () -> let _ = load start in "bad") "caught");
let _ = print (try_or (fn () -> let _ = affine start in "bad") "caught");
let _ = print (try_or (fn () -> let _ = store start in "bad") "caught");
print (if vec_get v 0 == 1.0 && vec_get v 1 == 2.0 then "kept" else "bad")
