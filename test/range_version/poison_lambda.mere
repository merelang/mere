// range-version: none
// A lambda in the body could do anything to `v` through a builtin that runs
// it. Must not be planned.
let n = 8;
let v = vec_new ();
let rec fill = fn (i: int) -> if i == n then () else let _ = vec_push v (i * 3) in fill (i + 1);
let _ = fill 0;
let rec total = fn (i: int) -> fn (acc: int) ->
  if i == n then acc
  else
    let bump = list_map (Cons (vec_get v i, Nil)) (fn (x: int) -> x + 1) in
    total (i + 1) (acc + list_sum bump);
print (str_of_int (total 0 0))
