// scripts/thread_fail_check.sh: a detached thread's failure is one line on stderr
// and the program carries on (v0.1.586): mhttpd and mengd lost the whole daemon
// to one handler's failure. The thread says it is about to fail, and the main
// thread then works for a while, so the failure lands before the program ends.
let c = channel_new () in
let h = spawn (fn () -> let _ = channel_send c 1 in let _ = fail "boom" in ()) in
let _ = detach h in
let _ = channel_recv c in
let rec inner = fn (i: int) -> fn (acc: int) -> if i == 0 then acc else inner (i - 1) (acc + i % 7) in
let rec outer = fn (j: int) -> fn (acc: int) -> if j == 0 then acc else outer (j - 1) (inner 1000 acc) in
let _ = outer 1000 0 in
print "after"
