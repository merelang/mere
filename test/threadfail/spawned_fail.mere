// A spawned thread fails while the program it belongs to keeps working.
//
// One worker sends and then raises, another sends, and the main thread reads
// both and works for a while, so the failure has happened before the program
// ends -- a thread still running at exit has nothing to report, on any backend.
// Nobody joins or detaches the one that failed.
//
// Until v0.1.586 the four backends gave three answers: C and LLVM ended the
// process from the failing thread (exit 1 in some runs and 0 in others, stdout
// sometimes cut), Wasm printed the failure and exited 0, the interpreter said
// nothing. Now every backend gives the same one (Q-090): the exit status is the
// main thread's, 0, and the failure nobody claimed is one line on stderr at exit:
//
//   mere: thread 1 failed and was never joined: fail: boom
//
// scripts/thread_fail_check.sh runs it many times per backend.
let c = channel_new () in
let _ = spawn (fn () -> let _ = channel_send c 1 in let _ = fail "boom" in ()) in
let _ = spawn (fn () -> channel_send c 2) in
let a = channel_recv c in
let b = channel_recv c in
let rec inner = fn (i: int) -> fn (acc: int) -> if i == 0 then acc else inner (i - 1) (acc + i % 7) in
let rec outer = fn (j: int) -> fn (acc: int) -> if j == 0 then acc else outer (j - 1) (inner 1000 acc) in
let _ = outer 1000 0 in
a + b - 3
