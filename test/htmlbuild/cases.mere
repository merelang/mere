// test/htmlbuild/cases.mere — what contrib/html/build actually escapes.
//
// The payloads are the ones that got through mere-blog's index, plus the
// attribute case that people leave out when they escape "the content".
import "../../contrib/html/build.mere";

let fails = vec_new ();
let _ = vec_push fails 0;
let total = vec_new ();
let _ = vec_push total 0;
let check = fn (label: str) -> fn (got: str) -> fn (want: str) ->
  let _ = vec_set total 0 (vec_get total 0 + 1) in
  if str_eq got want then ()
  else let _ = vec_set fails 0 (vec_get fails 0 + 1) in
       print ("FAIL " ++ label ++ "\n  got  " ++ got ++ "\n  want " ++ want)
  ;

// --- the payload that ran on mere-blog's index ---------------------------
let _ = check "script tag in text"
  (render (Text "<script>alert(1)</script>"))
  "&lt;script&gt;alert(1)&lt;/script&gt;" in

let _ = check "img onerror in text"
  (render (Text "<img src=x onerror=1>"))
  "&lt;img src=x onerror=1&gt;" in

// --- the half people leave out: the attribute ----------------------------
// A value carrying a quote closes the attribute and starts another. This is
// injection with no angle bracket in it.
let _ = check "quote in an attribute value"
  (render (El ("a", [("href", "\" onmouseover=\"evil()")], [Text "x"])))
  "<a href=\"&quot; onmouseover=&quot;evil()\">x</a>" in

let _ = check "ampersand in an attribute value"
  (render (El ("a", [("href", "/s?a=1&b=2")], Nil)))
  "<a href=\"/s?a=1&amp;b=2\"></a>" in

// --- structure -----------------------------------------------------------
let _ = check "nesting"
  (render (El ("ul", [], [El ("li", [], [Text "a"]), El ("li", [], [Text "b"])])))
  "<ul><li>a</li><li>b</li></ul>" in

let _ = check "a void element has no closing tag"
  (render (El ("br", [], Nil))) "<br>" in

let _ = check "Raw is not escaped, which is what it is for"
  (render (Raw "<b>bold</b>")) "<b>bold</b>" in

// --- the document ---------------------------------------------------------
// The three a page owes a reader are not optional parameters.
let doc = page "my title" [El ("h1", [], [Text "hi"])] in
let _ = check "the document carries lang, charset and title"
  doc
  "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><title>my title</title></head><body><h1>hi</h1></body></html>" in

let _ = check "a title carrying markup is escaped too"
  (page "<script>x</script>" Nil)
  "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><title>&lt;script&gt;x&lt;/script&gt;</title></head><body></body></html>" in

let n = vec_get total 0 in
let f = vec_get fails 0 in
let _ = print ("htmlbuild: " ++ show n ++ " cases, " ++ show f ++ " failed") in
if n < 9 then let _ = print "FAIL: fewer cases ran than declared" in 1
else if f > 0 then 1 else 0
