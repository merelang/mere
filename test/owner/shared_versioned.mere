// scripts/owner_check.sh: the thread reads the table in a loop range-check
// versioning made unchecked, and an unchecked read leaves no mark -- the mark is
// the guard's own vec_len, a checked read. Then the owner writes it.
// Must fail, naming the write.
let mk = fn (u: unit) -> let v = vec_new () in let _ = vec_push v 5 in let _ = vec_push v 6 in v;
let t = mk ();
let n = 2;
let rec scan = fn (i: int) -> if i == n then () else let _ = (if vec_get t i < 0 then print_int i else ()) in scan (i + 1);
let start = fn (f: unit -> unit) -> spawn f;
let h = start (fn (u: unit) -> scan 0);
let _ = join h;
let _ = vec_set t 0 7;
print_int (vec_get t 0)
