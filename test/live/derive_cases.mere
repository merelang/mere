// test/live/derive_cases.mere — what contrib/db/live derives, held to answers.
//
// The cases are mere-blog's real statements, not invented ones. The NEGATIVES
// carry the weight: a module that answered YES to everything would satisfy
// every positive case here and be worthless, because "recompute everything on
// any write" is what contrib/state/store already does. What has to be shown is
// that a write to `sessions` leaves a read of `posts` alone.
import "../../contrib/db/live.mere";

let posts_all    = "SELECT id, author, title, body, published, created_at FROM posts ORDER BY id DESC";
let posts_pub    = "SELECT id, title FROM posts WHERE published = true ORDER BY id DESC";
let post_find    = "SELECT id, title FROM posts WHERE id = $1";
let comments_for = "SELECT id, post_id, author, body, created_at FROM comments WHERE post_id = $1";
let sessions_rd  = "SELECT username FROM sessions WHERE sid = $1";
let users_rd     = "SELECT id, username, pw_hash FROM users WHERE username = $1";
let joined       = "SELECT c.body, p.title FROM comments c JOIN posts p ON p.id = c.post_id";

let post_create  = "INSERT INTO posts (author, title, body, published) VALUES ($1,$2,$3,$4) RETURNING id";
let post_update  = "UPDATE posts SET title = $1 WHERE id = $2 RETURNING id";
let post_delete  = "DELETE FROM posts WHERE id = $1 RETURNING id";
let comment_new  = "INSERT INTO comments (post_id, author, body) VALUES ($1,$2,$3) RETURNING id";
let sess_login   = "INSERT INTO sessions (sid, username) VALUES ($1, $2)";
let sess_logout  = "DELETE FROM sessions WHERE sid = $1";
let user_create  = "INSERT INTO users (username, pw_hash) VALUES ($1, $2) RETURNING id";

let agg          = "SELECT count(*) FROM posts";
let paged        = "SELECT id FROM posts ORDER BY id LIMIT 20";
let clocked      = "SELECT id FROM sessions WHERE created_at > now() - interval '1 day'";

let fails = vec_new ();
let total = vec_new ();
let _ = vec_push fails 0;
let _ = vec_push total 0;

let check = fn (label: str) -> fn (got: bool) -> fn (want: bool) ->
  let _ = vec_set total 0 (vec_get total 0 + 1) in
  if got == want then ()
  else
    let _ = vec_set fails 0 (vec_get fails 0 + 1) in
    print ("FAIL " ++ label ++ ": got " ++ show got ++ " want " ++ show want)
  ;

let aff = fn (label: str) -> fn (w: str) -> fn (r: str) -> fn (want: bool) ->
  check label (affects w r) want
  ;

// --- a write reaches the reads of its own table ---------------------------
let _ = aff "post_create -> posts_all"    post_create posts_all    true in
let _ = aff "post_create -> posts_pub"    post_create posts_pub    true in
let _ = aff "post_update -> post_find"    post_update post_find    true in
let _ = aff "post_delete -> posts_all"    post_delete posts_all    true in
let _ = aff "comment_new -> comments_for" comment_new comments_for true in
let _ = aff "sess_login  -> sessions_rd"  sess_login  sessions_rd  true in
let _ = aff "sess_logout -> sessions_rd"  sess_logout sessions_rd  true in
let _ = aff "user_create -> users_rd"     user_create users_rd     true in

// --- and leaves everything else alone. These are the cases that matter ----
let _ = aff "post_create -> comments_for" post_create comments_for false in
let _ = aff "post_create -> sessions_rd"  post_create sessions_rd  false in
let _ = aff "post_create -> users_rd"     post_create users_rd     false in
let _ = aff "comment_new -> posts_all"    comment_new posts_all    false in
let _ = aff "sess_login  -> posts_all"    sess_login  posts_all    false in
let _ = aff "sess_login  -> users_rd"     sess_login  users_rd     false in
let _ = aff "user_create -> posts_all"    user_create posts_all    false in
let _ = aff "post_delete -> sessions_rd"  post_delete sessions_rd  false in

// --- a join is read by every table it names -------------------------------
let _ = aff "post_update -> joined"       post_update joined       true in
let _ = aff "comment_new -> joined"       comment_new joined       true in
let _ = aff "sess_login  -> joined"       sess_login  joined       false in

// --- reads this module must refuse to speak about -------------------------
let _ = check "derivable posts_all" (derivable posts_all) true in
let _ = check "derivable joined"    (derivable joined)    true in
let _ = check "derivable agg"       (derivable agg)       false in
let _ = check "derivable paged"     (derivable paged)     false in
let _ = check "derivable clocked"   (derivable clocked)   false in

// --- the registry: a write names the channels it makes stale -------------
let reg = live_new () in
let _ = check "register posts_all" (live_register reg "ch_posts" posts_all) true in
let _ = check "register comments"  (live_register reg "ch_comments" comments_for) true in
let _ = check "register sessions"  (live_register reg "ch_sessions" sessions_rd) true in
// a read no write determines must be refused, not silently never updated
let _ = check "register agg refused"     (live_register reg "ch_agg" agg) false in
let _ = check "register clocked refused" (live_register reg "ch_clock" clocked) false in
let _ = check "registry holds 3" (live_size reg == 3) true in

let rec has = fn (x: str) -> fn (xs: str list) ->
  match xs with
  | Nil -> false
  | Cons (y, r) -> if str_eq x y then true else has x r in
let rec count = fn (xs: str list) ->
  match xs with Nil -> 0 | Cons (_, r) -> 1 + count r in

let on_post = live_channels reg post_create in
let _ = check "post_create wakes posts"        (has "ch_posts" on_post) true in
let _ = check "post_create leaves comments"    (has "ch_comments" on_post) false in
let _ = check "post_create leaves sessions"    (has "ch_sessions" on_post) false in
let _ = check "post_create wakes exactly one"  (count on_post == 1) true in

let on_sess = live_channels reg sess_login in
let _ = check "sess_login wakes sessions"      (has "ch_sessions" on_sess) true in
let _ = check "sess_login wakes exactly one"   (count on_sess == 1) true in

let on_user = live_channels reg user_create in
let _ = check "user_create wakes nothing"      (count on_user == 0) true in

// THE SAME REGISTRY, ASKED WITH THE FOREIGN KEYS IN IT. `live_channels` reads
// table names out of the statement, and a DELETE of a post never names
// `comments` -- so a subscriber to the comments channel is told nothing while
// its rows are deleted underneath it. That is not hypothetical: it is what
// mere-blog did before `live_channels_via`.
//
// The negatives are what separate the two functions from a broadcast. Widening
// by cascade must reach `ch_comments` and must NOT reach `ch_sessions`, which
// no key connects to posts.
let ddl = "CREATE TABLE users (id serial PRIMARY KEY, username text UNIQUE NOT NULL); \
CREATE TABLE sessions (sid text PRIMARY KEY, username text NOT NULL REFERENCES users(username) ON DELETE CASCADE); \
CREATE TABLE posts (id serial PRIMARY KEY, title text NOT NULL); \
CREATE TABLE comments (id serial PRIMARY KEY, post_id integer NOT NULL REFERENCES posts(id) ON DELETE CASCADE);" in
let casc = cascades_of ddl in
let post_delete = "DELETE FROM posts WHERE id = $1 RETURNING id" in

let del_plain = live_channels reg post_delete in
let _ = check "delete: plain wakes posts"        (has "ch_posts" del_plain) true in
let _ = check "delete: plain misses comments"    (has "ch_comments" del_plain) false in

let del_via = live_channels_via casc reg post_delete in
let _ = check "delete via: wakes posts"          (has "ch_posts" del_via) true in
let _ = check "delete via: wakes comments"       (has "ch_comments" del_via) true in
let _ = check "delete via: leaves sessions"      (has "ch_sessions" del_via) false in
let _ = check "delete via: wakes exactly two"    (count del_via == 2) true in

// And widening does not turn every write into a broadcast: a session login
// still reaches only the sessions channel with the cascades applied.
let sess_via = live_channels_via casc reg sess_login in
let _ = check "sess_login via: exactly one"      (count sess_via == 1) true in
let _ = check "sess_login via: sessions"         (has "ch_sessions" sess_via) true in

// --- every referential action, as Postgres answered ------------------------
//
// These five rows are not invented: each was run against Postgres with one row
// in the child, and the child read compared before and after the parent write.
// `cascades_of` used to record only the first, on the note that RESTRICT and
// SET NULL "do not remove rows" -- true, and not the question. The question is
// whether the READ changes.
//
//   ON DELETE CASCADE       1:1 -> (empty)   changed
//   ON DELETE SET NULL      1:1 -> 1:null    changed
//   ON DELETE SET DEFAULT   1:1 -> 1:9       changed
//   ON UPDATE CASCADE       1:1 -> 1:77      changed, on UPDATE of the key
//   ON DELETE RESTRICT      the delete is refused; nothing changed
let ddl_of = fn (action: str) ->
  "CREATE TABLE p (id int PRIMARY KEY); \
   CREATE TABLE c (id serial PRIMARY KEY, pid int REFERENCES p(id) " ++ action ++ ");" in
let pairs_of = fn (action: str) -> cascades_of (ddl_of action) in
let n_pairs = fn (action: str) ->
  let rec cnt = fn (xs: (str * str) list) ->
    match xs with Nil -> 0 | Cons (_, r) -> 1 + cnt r in
  cnt (pairs_of action) in

let _ = check "ref: ON DELETE CASCADE"      (n_pairs "ON DELETE CASCADE" == 1) true in
let _ = check "ref: ON DELETE SET NULL"     (n_pairs "ON DELETE SET NULL" == 1) true in
let _ = check "ref: ON DELETE SET DEFAULT"  (n_pairs "ON DELETE SET DEFAULT" == 1) true in
let _ = check "ref: ON UPDATE CASCADE"      (n_pairs "ON UPDATE CASCADE" == 1) true in

// THE NEGATIVES. A refused write changes nothing, so recording a pair for it
// would make every parent write wake a channel that cannot have gone stale --
// and an implementation that returns a pair for everything passes all four
// assertions above.
let _ = check "ref: ON DELETE RESTRICT"     (n_pairs "ON DELETE RESTRICT" == 0) true in
let _ = check "ref: ON DELETE NO ACTION"    (n_pairs "ON DELETE NO ACTION" == 0) true in
let _ = check "ref: no action clause"       (n_pairs "" == 0) true in

// CASCADE sixth in the clause: a fixed three-word window stops looking before
// it gets here, which is how the old scan would have missed this one.
let _ = check "ref: RESTRICT then UPDATE CASCADE"
              (n_pairs "ON DELETE RESTRICT ON UPDATE CASCADE" == 1) true in

let n = vec_get total 0 in
let f = vec_get fails 0 in
let _ = print ("live_derive: " ++ show n ++ " cases, " ++ show f ++ " failed") in
if n < 53 then let _ = print "FAIL: fewer cases ran than this file declares" in 1
else if f > 0 then 1 else 0
