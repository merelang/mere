// A million coroutines made, run to the end and dropped. What a finished one
// keeps is the small record the program's handle points at (24 bytes); its
// saved state and its stack go back when it is reaped. scripts/coro_check.sh
// bounds this program's resident memory.
let root = coro_self ();
let rec go = fn (i: int) -> fn (acc: int) ->
  if i == 0 then acc
  else (let c = coro_new (fn () -> root) in let _ = coro_switch c in go (i - 1) (acc + 1));
print_int (go 1000000 0)
