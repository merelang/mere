// Giving back the pages of a pinned arena. One coroutine reads a 100 KB string
// out of a map (many pages, of a size the shedding cannot know) and stops
// holding it; the map drops it. Then, each round, every value is rewritten, a
// fresh coroutine reads one value and stops holding it, the map drops that
// one too, and the map is compacted -- refused while a stopped stack points
// into its arena, so the arena only grows, and the pages nothing can read are
// given back (and when it has doubled and is compacted after all, the old
// arena is retired and given back but for what the stacks reach). What the
// coroutines held, every live value and the map's length must be what they
// were written as; under MERE_ARENA_SHED=protect a page given back that is
// read faults.
let root = coro_root ();
let m = map_new ();
let bad = map_new ();
let _ = map_set bad "n" 0;
let letter = fn (r: int) -> if r % 2 == 0 then "b" else "c";
let val = fn (c: str) -> fn (i: int) -> str_repeat c 100 ++ str_of_int i;
let rec fill = fn (i: int) -> fn (c: str) -> if i == 0 then 0 else (let _ = map_set m i (val c i) in fill (i - 1) c);
let _ = fill 40000 "a";
let _ = map_compact m;
let _ = map_set m 0 (str_repeat "H" 100000);
let holder = coro_new (fn _me -> fn (_u: unit) -> coro_exit (
  let held = map_get m 0 in
  let _ = coro_switch root in
  let _ = print (if held == str_repeat "H" 100000 then "held: intact" else "held: lost") in
  root) ());
let _ = coro_switch holder;
let _ = map_set m 0 "gone";
let rec rounds = fn (r: int) ->
  if r == 0 then 0
  else (let _ = fill 40000 (letter r) in
        let w = coro_new (fn _me -> fn (_u: unit) -> coro_exit (
          let h = map_get m 5 in
          let _ = coro_switch root in
          let _ = (if h == val (letter r) 5 then () else map_set bad "n" (map_get bad "n" + 1)) in
          root) ()) in
        let _ = coro_switch w in
        let _ = map_set m 5 (val (letter r) 5) in
        let _ = map_compact m in
        let _ = coro_switch w in
        rounds (r - 1));
let _ = rounds 40;
let rec total = fn (i: int) -> fn (acc: int) -> if i == 0 then acc else total (i - 1) (acc + str_len (map_get m i));
let _ = print_int (total 40000 0);
let _ = print (if substring (map_get m 777) 0 3 == "ccc" && map_get bad "n" == 0 then "values: intact" else "values: lost");
let _ = coro_switch holder;
print_int (map_len m)
