// A finished coroutine is still a value. Switching to it is a fail with its
// name, and a catchable one.
let root = coro_root ();
let b = coro_new (fn _me -> fn (_u: unit) -> coro_exit ( let _ = print "B: ran" in root) ());
let _ = coro_switch b;
let v = try_or (fn (u) -> let _ = coro_switch b in 1) 0;
print (if v == 0 then "switch to a finished coroutine: refused" else "switch to a finished coroutine: allowed")
