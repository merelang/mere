// A coroutine made inside a block outlives it. Its body's env was allocated in
// the block; without the hoist into the default region the body reads it after
// the block is gone and recycled.
let root = coro_self ();
let greeting = str_repeat "g" 40;
let c = region R { let pad = str_repeat "p" 4096 in let _ = str_len pad in coro_new (fn () ->
  let _ = print (if greeting == str_repeat "g" 40 then "env: intact" else "env: lost") in root) };
let z = region Z { let t = str_repeat "Z" 8192 in str_len t };
let _ = coro_switch c;
print_int z
