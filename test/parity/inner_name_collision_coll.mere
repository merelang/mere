// Q-198 (v0.1.580): an inner function's name met a variable of the same name in
// another function, and LLVM (and Wasm) read the variable as the lifted function.
let a = fn (n: int) ->
  let v = vec_new () in
  let rec p = fn i -> if i == n then () else let _ = vec_push v i in p (i + 1) in
  let _ = p 0 in
  vec_len v;
let b = fn (s: int) ->
  let p = s * 2 in
  let rec copy = fn i -> if i == 3 then 0 else p + copy (i + 1) in
  copy 0;
print (str_of_int (a 3 + b 5))
