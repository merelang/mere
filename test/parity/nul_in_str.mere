// A zero byte inside a str: does every backend agree it is a byte?
//
// `str` became byte-safe in the v0.1.129 arc -- the length lives in a header
// rather than in a terminator -- and `str_len (chr 0 ++ "X")` has answered 2
// ever since. `print` did not: it went out through a NUL-terminated write on
// two of the four backends, so the same value measured 2 and printed 1
// character. Two answers about one value is a bug and not a choice, which is
// why this file prints the strings as well as measuring them.
//
// Both backends that could not answer are fixed rather than pinned now. Wasm
// was pinned for one slice: one host runs modules from both compilers, and it
// could not trust the length header while the self-hosted backend still
// emitted the pre-header representation. LLVM was pinned for two: its str was
// a bare pointer with no header anywhere, so `str_len (chr 0)` was 0 there
// against 1 everywhere else -- the NUL was not truncated on output, it was
// never in the value.
//
// Dropping U+0000 from the case would have made this file agree by not
// asking, which is what happened the first time the question came up. Pinning
// instead is what kept it asking until all four could answer.
//
// Execution mode: 4 backends (interp + C + LLVM + Wasm), diff = 0

let nul = chr 0;
let s = nul ++ "X";

// measured
let _ = print (str_of_int (str_len nul));
let _ = print (str_of_int (str_len s));
let _ = print (str_of_int (str_len ("A" ++ s ++ "B")));

// and printed: the bytes reach the output, so a NUL in the middle of a line
// does not end the line
let _ = print ("A" ++ s ++ "B");
let _ = print ("[" ++ nul ++ "]");

// a NUL is an ordinary byte to the string operations
let _ = print (str_of_int (ord (char_at s 0)));
let _ = print (str_of_int (ord (char_at s 1)));
let _ = print (str_of_int (str_len (substring ("A" ++ s ++ "B") 0 3)));
let _ = print (str_of_int (if s == nul ++ "X" then 1 else 0));
let _ = print (str_of_int (if nul == "" then 1 else 0));
