// map_set of a value that is the TAIL of the one stored under the key -- a
// queue taken off the front, which mere-ruby's Hash#shift is -- and of the
// same value again, beside the stores that must still copy: a new list
// that shares the old one's tail behind a new head, and a list written
// after the old one was replaced. The values stay what they were written as
// on every backend; on C the tail is kept where it is instead of being
// copied (v0.1.711). The list is short: a backend that copies every store
// (RV32I in 32 MB) pays the square of its length.
//
// Execution mode: 4 backends (interp + C + LLVM + Wasm), diff = 0

let m = map_new ();
let rec mk = fn (i: int) -> fn (acc: int list) -> if i <= 0 then acc else mk (i - 1) (Cons (i, acc));
let rec sum = fn (xs: int list) -> fn (a: int) -> match xs with Nil -> a | Cons (x, t) -> sum t (a + x);
let rec len = fn (xs: int list) -> fn (a: int) -> match xs with Nil -> a | Cons (_, t) -> len t (a + 1);
let show = fn (u: unit) -> print (str_of_int (len (map_get m 1) 0) ++ " " ++ str_of_int (sum (map_get m 1) 0));

let _ = map_set m 1 (mk 200 Nil);
// one off the front at a time
let rec take_front = fn (n: int) ->
  if n <= 0 then ()
  else (match map_get m 1 with
        | Cons (_, t) -> let _ = map_set m 1 t in take_front (n - 1)
        | Nil -> ());
let _ = take_front 190;
let _ = show ();                                    // 10 1955
// two and three cells down, and the same value again
let _ = (match map_get m 1 with Cons (_, Cons (_, t)) -> map_set m 1 t | _ -> ());
let _ = show ();                                    // 8 1572
let _ = (match map_get m 1 with Cons (_, Cons (_, Cons (_, t))) -> map_set m 1 t | _ -> ());
let _ = show ();                                    // 5 990
let _ = map_set m 1 (map_get m 1);
let _ = show ();                                    // 5 990
// a new head over the old tail, and the old value kept elsewhere
let old = map_get m 1;
let _ = map_set m 1 (Cons (7, old));
let _ = show ();                                    // 6 997
let _ = map_set m 1 (mk 3 Nil);
let _ = show ();                                    // 3 6
let _ = print (str_of_int (sum old 0));             // 990
// down to empty, and the key still answers
let _ = take_front 5;
let _ = show ();                                    // 0 0
// the same with string keys and string elements
let ms = map_new ();
let _ = map_set ms "q" (Cons ("a", Cons ("b", Cons ("c", Nil))));
let _ = (match map_get ms "q" with Cons (_, t) -> map_set ms "q" t | _ -> ());
let _ = map_set ms "q" (Cons ("z", map_get ms "q"));
let _ = print (match map_get ms "q" with Cons (x, Cons (y, Cons (w, Nil))) -> x ++ y ++ w | _ -> "?");  // zbc
