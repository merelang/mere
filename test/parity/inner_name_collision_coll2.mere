// Q-198 (v0.1.580): an inner function's name met a variable of the same name in
// another function, and LLVM (and Wasm) read the variable as the lifted function.
let b = fn (n: int) ->
  let cnt = vec_new () in
  let _ = vec_push cnt 2 in
  let acc = vec_new () in
  let _ = vec_push acc 0 in
  let rec give = fn (k: int) ->
    if k > n then ()
    else
      let rec take = fn (j: int) ->
        if j >= (vec_get cnt 0 : int) then ()
        else let _ = vec_set acc 0 ((vec_get acc 0 : int) + 1) in take (j + 1) in
      let _ = take 0 in
      give (k + 1) in
  let _ = give 0 in
  (vec_get acc 0 : int);
let a = fn (n: int) ->
  let v = vec_new () in
  let rec cnt = fn i -> if i == n then () else let _ = vec_push v i in cnt (i + 1) in
  let _ = cnt 0 in
  vec_len v;
print (str_of_int (a 3 + b 1))
