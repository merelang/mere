// `read_lines` on the interpreter, C, LLVM and Wasm. The file is supplied by
// the native runtime or the Wasm host; a browser needs a host file provider.
//
// Its C runtime section (`__lang_read_lines`) had no program at all until this
// one. It turned out to be correct -- unlike the two sections that were in the
// same position a day earlier (Q-068, Q-069) -- and that is the point of
// writing it down: an untested section is a risk, not a defect.
//
// The file is written first so the case does not depend on anything outside
// itself. Blank line and no trailing newline are in the payload on purpose:
// they are where a line splitter's off-by-one lives.
let path = "/tmp/mere_parity_read_lines_" ++ str_of_int (random_int 1000000000);
let _ = write_file path "alpha\nbeta\n\ngamma";

let ls = read_lines path;
{
  print (str_of_int (len ls));
  print (match ls with | Nil -> "-" | Cons (h, _) -> h);
  print (str_join "|" ls);
  let _ = write_file path "" in
  let _ = print_int (list_len (read_lines path)) in
  let _ = write_file path "alpha\n" in
  let _ = print_int (list_len (read_lines path)) in
  let _ = file_delete path in
  ()
}
