// What every builtin does when it is handed a value outside its domain, held to
// the interpreter on all four backends.
//
// This file exists because the previous two slices found the same shape twice
// (string widths, then indices), so the third time the question was asked
// mechanically instead: every refusal the interpreter can raise, checked against
// what the compiled backends do with the same input. Nine of them diverged, and
// they diverged the same way each time -- the compiled backends had no check at
// all, and returned whatever the underlying byte or pointer arithmetic produced:
//
//   chr 256          -> a NUL      (the cast to unsigned char WAS the domain check)
//   chr (-1)         -> 0xFF
//   ord ""           -> 0          (it read byte 0 whatever the length was)
//   ord "ab"         -> 97
//   str_repeat s (-1)-> ""         (a mistake, silently agreed to)
//   str_unescape     -> the letter itself for an escape nobody defined
//   owned_vec_get    -> abort(), which try_or cannot catch
//
// Every one of them was a value a program could produce by accident and then
// keep computing with. The interpreter has refused all of them since it was
// written; three backends agreed with each other and not with it.
//
// Execution mode: 4 backends (interp + C + LLVM + Wasm), diff = 0

let s = fn (label: str) -> fn (t: unit -> str) ->
  print (label ++ " = " ++ try_or (fn () -> "[" ++ t () ++ "]") "REFUSED");
let i = fn (label: str) -> fn (t: unit -> int) ->
  print (label ++ " = " ++ str_of_int (try_or t (0 - 999)));

// --- chr: a byte, and only a byte ---
let _ = s "chr 65" (fn () -> chr 65);
let _ = s "chr 0" (fn () -> chr 0);
let _ = s "chr 255" (fn () -> chr 255);
let _ = s "chr 256" (fn () -> chr 256);
let _ = s "chr -1" (fn () -> chr (0 - 1));
// past what 32 bits can name, which used to wrap back into range
let _ = s "chr 2^32+65" (fn () -> chr 4294967361);

// --- ord: one character, and only one ---
let _ = i "ord A" (fn () -> ord "A");
let _ = i "ord empty" (fn () -> ord "");
let _ = i "ord two" (fn () -> ord "ab");

// --- str_repeat: zero is empty, negative is a mistake ---
let _ = s "repeat 2" (fn () -> str_repeat "ab" 2);
let _ = s "repeat 0" (fn () -> str_repeat "ab" 0);
let _ = s "repeat -1" (fn () -> str_repeat "ab" (0 - 1));

// --- str_unescape: the escapes that exist, and one that does not ---
let _ = s "unescape known" (fn () -> str_unescape "a\\nb");
let _ = s "unescape unknown" (fn () -> str_unescape "a\\q");

// --- bool_of_str: two words, and nothing else ---
// The comment in the C backend said "others -> false (matches interp)". The
// interpreter has never done that. A claim in a comment is not a check.
let _ = s "bool true" (fn () -> if bool_of_str "true" then "T" else "F");
let _ = s "bool false" (fn () -> if bool_of_str "false" then "T" else "F");
let _ = s "bool yes" (fn () -> if bool_of_str "yes" then "T" else "F");
let _ = s "bool empty" (fn () -> if bool_of_str "" then "T" else "F");

// --- float_of_str: the whole string, or none of it ---
// The oracle is OCaml's float_of_string over the trimmed input, which accepts
// more than a decimal point: hex floats, the inf / infinity / nan spellings in
// any case, signs, and underscores as separators. C read a prefix and answered
// 0.0 for junk; the Wasm host used parseFloat, which answered 1.0 for
// "1_000.5", nan for "inf", and nan for junk -- indistinguishable from the
// float nan, so nothing could be refused at all.
let f = fn (label: str) -> fn (t: unit -> float) ->
  print (label ++ " = " ++ try_or (fn () -> str_of_float (t ())) "REFUSED");
let _ = f "float 1.5" (fn () -> float_of_str "1.5");
let _ = f "float 1e10" (fn () -> float_of_str "1e10");
let _ = f "float nan" (fn () -> float_of_str "nan");
let _ = f "float inf" (fn () -> float_of_str "inf");
let _ = f "float -INF" (fn () -> float_of_str "-INF");
let _ = f "float infinity" (fn () -> float_of_str "infinity");
let _ = f "float hex" (fn () -> float_of_str "0x1p3");
let _ = f "float spaced" (fn () -> float_of_str "  1.5  ");
let _ = f "float under" (fn () -> float_of_str "1_000.5");
let _ = f "float dot" (fn () -> float_of_str ".5");
let _ = f "float junk" (fn () -> float_of_str "abc");
let _ = f "float prefix" (fn () -> float_of_str "1.5x");
let _ = f "float empty" (fn () -> float_of_str "");
let _ = f "float e5" (fn () -> float_of_str "e5");

// --- bytes: the same index rules again, on the other sequence type ---
// bytes_get checked the index AFTER truncating it to 32 bits on Wasm, and both
// it and bytes_slice ended in abort() on C and LLVM and a bare trap on Wasm --
// so a bad index killed the program where the interpreter raised something
// try_or could take. bytes_slice on Wasm had no range check at all and copied
// from wherever the arithmetic pointed (v0.1.278).
let bs = bytes_of_hex "0102";
let _ = i "bytes_get 0" (fn () -> bytes_get bs 0);
let _ = i "bytes_get 2" (fn () -> bytes_get bs 2);
let _ = i "bytes_get -1" (fn () -> bytes_get bs (0 - 1));
let _ = i "bytes_get big" (fn () -> bytes_get bs 4294967297);
let _ = s "bytes_slice ok" (fn () -> hex_of_bytes (bytes_slice bs 0 1));
let _ = s "bytes_slice all" (fn () -> hex_of_bytes (bytes_slice bs 0 2));
let _ = s "bytes_slice past" (fn () -> hex_of_bytes (bytes_slice bs 1 9));
let _ = s "bytes_slice neg" (fn () -> hex_of_bytes (bytes_slice bs (0 - 1) 1));

// --- owned_vec: the same index rules as vec ---
let ov = owned_vec_new ();
let _ = owned_vec_push ov 7;
let _ = i "owned_vec_get 0" (fn () -> owned_vec_get ov 0);
let _ = i "owned_vec_get 5" (fn () -> owned_vec_get ov 5);
let _ = i "owned_vec_get big" (fn () -> owned_vec_get ov 4294967297);
0
