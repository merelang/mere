// A constrained generic function defined in a *local* `let` (not top-level).
// The dictionary is threaded through the local binding: its trait-method uses
// resolve to the dict parameter, and the use site passes the concrete dict.
//
// This case is at `int`; see trait_local_let_variant.mere for a non-int
// (user variant) instantiation. v0.1.99 lifted the old "local polymorphic fn
// used at a non-int type" limitation on the C / LLVM backends by
// monomorphizing a single-use local poly fn to its concrete use type before
// lifting, so all four backends now agree at any single instance type.
trait Num 'a { add : 'a -> 'a -> 'a; zero : 'a; }
impl Num int { add = fn x -> fn y -> x + y; zero = 0; }

let total = fn ys ->
  let sum = fn xs -> list_fold xs zero (fn acc -> fn x -> add acc x) in
  sum ys;
print (str_of_int (total [1, 2, 3, 4, 5]))
