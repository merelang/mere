// Q-039: what a shift count outside the width means, held to one answer.
//
// Four backends had three answers and one undefined behaviour: the interpreter
// defined an out-of-range count, the C backend's `<<` on a signed long long was
// UB (UBSan: "left shift of ... cannot be represented in type 'long long'"),
// LLVM IR calls a shift by 64 or more POISON, and Wasm masks the count mod 64
// by spec -- so `bit_shl x 70` quietly meant `x << 6` there.
//
// The contract was already written down in the RISC-V backend, which chose zero
// for a left shift and the sign bit for a right one "to match what the other
// backends give". This is that contract, asked of the other backends.
//
// Execution mode: 4 backends, diff = 0

let _ = print "=== in range ===";
let _ = print (show (bit_shl 3 4) ++ " " ++ show (bit_shr 256 4));
let _ = print (show (bit_shl 1 0) ++ " " ++ show (bit_shr 1 0));
let _ = print (show (bit_shr (0 - 8) 1) ++ " " ++ show (bit_shr (0 - 1) 3));

let _ = print "=== at and beyond the width: zero, or the sign ===";
let _ = print (show (bit_shl 1 64) ++ " " ++ show (bit_shl 1 70) ++ " " ++ show (bit_shl 1 1000));
let _ = print (show (bit_shr 256 64) ++ " " ++ show (bit_shr 256 70));
let _ = print (show (bit_shr (0 - 8) 64) ++ " " ++ show (bit_shr (0 - 8) 70));

let _ = print "=== a negative count reads as huge-unsigned ===";
let _ = print (show (bit_shl 5 (0 - 1)) ++ " " ++ show (bit_shr 5 (0 - 1)));
let _ = print (show (bit_shr (0 - 5) (0 - 1)));

// ...and a dynamic count takes the same path as a constant one.
let sh = fn (x: int) -> fn (n: int) -> show (bit_shl x n) ++ "/" ++ show (bit_shr x n);
let _ = print (sh 1 70);
let _ = print (sh (0 - 8) 70);
print (sh 3 4)
