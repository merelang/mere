// Traits, a type, and functions defined inside a `module` block, with the
// trait instances supplied (bare, since traits stay global) by the consumer.
// The module namespaces the functions (Set.of_list / Set.to_list); the trait
// `Ord`, its super `Eq`, and the `'a tree` type are global. v0.1.107 allows
// trait/impl inside a module body (previously only let/let rec/module were).
module Set {
  trait Eq 'a { eq : 'a -> 'a -> bool; }
  trait Ord 'a : Eq 'a { lt : 'a -> 'a -> bool; }
  type 'a tree = Leaf | Node of 'a tree * 'a * 'a tree;
  let rec insert = fn t -> fn x ->
    (match t with
     | Leaf -> Node (Leaf, x, Leaf)
     | Node (l, v, r) ->
       (if lt x v then Node (insert l x, v, r)
        else (if eq x v then t else Node (l, v, insert r x))));
  let rec to_list = fn t ->
    (match t with Leaf -> Nil | Node (l, v, r) -> list_append (to_list l) (Cons (v, to_list r)));
  let of_list = fn xs -> list_fold xs Leaf (fn acc -> fn x -> insert acc x);
}
impl Eq int { eq = fn a -> fn b -> a == b; }
impl Ord int { lt = fn a -> fn b -> a < b; }
let sorted = Set.to_list (Set.of_list [5, 3, 8, 1, 3, 8, 4]);
print (str_of_int (list_fold sorted 0 (fn a -> fn x -> a * 10 + x)))   // 13458
