// contrib/url's parser, held to one output on every backend. Correctness
// against the Standard is scripts/url_parity.sh's job (it diffs 95 inputs
// against node, field by field); this file is about the four backends agreeing.
//
// The two are not the same question, and this file is why: str_replace returned
// a buffer with no length header on the C backend, so `Url.clean` came back
// empty there and every URL was rejected — while node and the interpreter
// agreed with each other the whole time.
//
// Execution mode: 4 backends (interp + C + LLVM + Wasm), diff = 0

import "../../contrib/url/host.mere";

let p = fn (s: str) ->
  match Url.parse s with
  | None -> print (s ++ "  -> INVALID")
  | Some u -> print (s ++ "  -> " ++ Url.href u);

let _ = print "=== scheme and case folding ===";
let _ = p "HTTP://EXAMPLE.com/a";
let _ = p "foo://EXAMPLE.com/a";
let _ = p "mailto:x@y";

let _ = print "=== default ports elide, others do not ===";
let _ = p "http://h:80/";
let _ = p "https://h:443/";
let _ = p "ws://h:80/";
let _ = p "ftp://h:21/";
let _ = p "http://h:8080/";
let _ = p "foo://h:80/";
let _ = p "http://h:/";

let _ = print "=== userinfo ===";
let _ = p "http://user@h/";
let _ = p "http://user:pw@h/";
let _ = p "http://a@b@h/";

let _ = print "=== a host that is a number is an address, in any base ===";
let _ = p "http://127.0.0.1/";
let _ = p "http://0x7f.1/";
let _ = p "http://0177.1/";
let _ = p "http://1.2/";
let _ = p "http://[::1]:81/";

let _ = print "=== and a bad number is invalid, not a hostname ===";
let _ = p "http://256.1.1.1/";
let _ = p "http://1.2.3.4.5/";
let _ = p "http://h:99999/";
let _ = p "http://h:abc/";
let _ = p "http://";
let _ = p "not a url";

let _ = print "=== cleaning: surrounding space out, tabs and newlines out ===";
let _ = p "  http://h/a  ";
let _ = p "ht\ttp://h/a";

let _ = print "=== dot segments, and what is not one ===";
let _ = p "http://h/a/b/..";
let _ = p "http://h/a/b/.";
let _ = p "http://h/a/./b";
let _ = p "http://h/a/%2e%2e/b";
let _ = p "http://h/%2E%2E/a";
let _ = p "http://h/..";
let _ = p "http://h/a/b/../../../c";
let _ = p "http://h/.../a";
let _ = p "http://h/a/..%2f";
let _ = p "http://h//";
let _ = p "http://h/a//b";

let _ = print "=== the path is never decoded ===";
let _ = p "http://h/a%2fb";
let _ = p "http://h/%41";

let _ = print "=== query and fragment: presence is not content ===";
let _ = p "http://h/?";
let _ = p "http://h/#";
let _ = p "http://h/?#";
let _ = p "http://h/?a#";
let _ = p "http://h/?a=1&b=2#f/g?h";
let _ = p "http://h/#a?b";
let _ = p "http://h/a'b?c'd";
let _ = p "foo://h/?a'b";

let _ = print "=== a special scheme's slashes are optional; a backslash is one ===";
let _ = p "http:h";
let _ = p "http:/h";
let _ = p "http:///h";
let _ = p "http://h\\a\\b";
let _ = p "http://u\\p@h/";
let _ = p "http://h/a\\b?c\\d#e\\f";
let _ = p "foo://h/a\\b";
let _ = p "foo:\\\\h";

let _ = print "=== no authority: opaque only when it does not start with / ===";
let _ = p "foo:/a/../b";
let _ = p "foo:a/../b";
let _ = p "mailto:a/../b";
let _ = p "mailto:a b";
let _ = p "foo:";
let _ = p "foo://";
let _ = p "foo:?q";
let _ = p "foo:#f";

let _ = print "=== a domain is percent-decoded, so a decoded dot separates ===";
let _ = p "http://a%41b/";
let _ = p "http://a%2eb/";
let _ = p "http://0x7f%2e1/";
let _ = p "http://a%2fb/";
let _ = p "http://a%b/";
let _ = p "foo://a%41b/";

let _ = print "=== IPv6: one canonical form out of many spellings ===";
let _ = p "http://[::1]/";
let _ = p "http://[0:0:0:0:0:0:0:1]/";
let _ = p "http://[::]/";
let _ = p "http://[2001:0db8:0000:0000:0000:0000:0000:0001]/";
let _ = p "http://[FF01::101]/";
let _ = p "http://[1:0:0:2:0:0:0:3]/";
let _ = p "http://[1:0:0:0:2:0:0:3]/";
let _ = p "http://[0:1:0:0:0:0:0:0]/";
let _ = p "http://[1:0:0:1:0:0:1:1]/";
let _ = p "http://[1:0:2:3:4:5:6:7]/";
let _ = p "http://[1:2:3:4:5:6:7::]/";
let _ = p "http://[::ffff:1.2.3.4]/";
let _ = p "http://[1:2:3:4:5:6:1.2.3.4]/";
let _ = p "http://[::1]:8080/";
let _ = p "http://[1:2:3:4:5:6:7:8:9]/";
let _ = p "http://[1::2::3]/";
let _ = p "http://[:1]/";
let _ = p "http://[1.2.3.4]/";
let _ = p "http://[::01.2.3.4]/";
let _ = p "http://[12345::]/";
let _ = p "http://[]/";

let _ = print "=== forbidden host code points ===";
let _ = p "http://a^b/";
let _ = p "http://a|b/";
let _ = p "http://a<b/";
let _ = p "http://a[b/";
let _ = p "foo://a^b/";
let _ = p "foo://a\\b/";

let _ = print "=== resolution against a base ===";

let r = fn (b: str) -> fn (i: str) ->
  match Url.parse b with
  | None -> print (b ++ "  -> BASE-INVALID")
  | Some bp ->
    match Url.resolve bp i with
    | None -> print ("  [" ++ i ++ "]  -> INVALID")
    | Some u -> print ("  [" ++ i ++ "]  -> " ++ Url.href u);

let _ = print "base http://h/a/b/c?bq#bf";
let b1 = "http://h/a/b/c?bq#bf";
let _ = r b1 "";
let _ = r b1 "#f";
let _ = r b1 "#";
let _ = r b1 "?q";
let _ = r b1 "?";
let _ = r b1 "?q#f";
let _ = r b1 "d";
let _ = r b1 "./d";
let _ = r b1 "../d";
let _ = r b1 "../../../d";
let _ = r b1 "/d";
let _ = r b1 "//h2/d";
let _ = r b1 "//h2";
let _ = r b1 "e?q2#f2";
let _ = r b1 "..?q2";
let _ = r b1 ".";
let _ = r b1 "..";
let _ = r b1 "d/";
let _ = r b1 "/";

let _ = print "base http://h/a/b/c  (schemes, and separators)";
let b2 = "http://h/a/b/c";
let _ = r b2 "http:d";
let _ = r b2 "http:/d";
let _ = r b2 "http://d";
let _ = r b2 "http:";
let _ = r b2 "https:d";
let _ = r b2 "http:..";
let _ = r b2 "\\d";
let _ = r b2 "d\\e";
let _ = r b2 "//h2\\d";
let _ = r b2 "\\\\h2/d";
let _ = r b2 "1:2";
let _ = r b2 "a:b";

let _ = print "base http://h  (empty path)";
let _ = r "http://h" "d";
let _ = r "http://h" "../d";
let _ = r "http://h" "?q";
let _ = r "http://h" "#f";

let _ = print "base foo://h/a/b  (non-special)";
let _ = r "foo://h/a/b" "d";
let _ = r "foo://h/a/b" "../d";
let _ = r "foo://h/a/b" "/d";
let _ = r "foo://h/a/b" "//h2/d";
let _ = r "foo://h/a/b" "\\d";

let _ = print "base foo://h  and  foo:/a/b  (no path, no authority)";
let _ = r "foo://h" "d";
let _ = r "foo://h" "#f";
let _ = r "foo://h" "?q";
let _ = r "foo://h" "";
let _ = r "foo:/a/b" "d";
let _ = r "foo:/a/b" "/d";
let _ = r "foo:/a/b" "//h/d";
let _ = r "foo:/a/b" "#f";

let _ = print "base mailto:x@y  (opaque: only a leading # resolves)";
let _ = r "mailto:x@y" "#f";
let _ = r "mailto:x@y" "?q#f";
let _ = r "mailto:x@y" "d";
let _ = r "mailto:x@y" "";
let _ = r "mailto:x@y" "//h/d";
let _ = r "mailto:x@y" "mailto:x";
0
