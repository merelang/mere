// No region block: the bump only ever goes up, so alloc_total is the bump and
// the two backends are measuring the same thing in different units of code.
let n = 20000;
let v = vec_new ();
let rec go = fn (i: int) -> if i >= n then () else (let _ = vec_push v (i * 2) in go (i + 1));
let _ = go 0 in
print_int (vec_len v)
