// contrib/proto/descriptor.mere — a parsed `.proto` as a `FileDescriptorSet`.
//
// THE BOOTSTRAP CLOSES HERE. A descriptor set is itself a protobuf message, so the
// thing that reads schemas is written with the thing that reads wire bytes, and one
// oracle — `protoc --descriptor_set_out` — checks both at once. If the wire layer
// mis-encodes a varint, this file's output stops matching; if this file gets a field
// number wrong, the same diff says so.
//
// THE MESSAGE BEING WRITTEN IS PROTO2, AND THAT REVERSES A RULE. `descriptor.proto`
// is proto2, so a field that is set is written even when its value is a default:
// an enum value with `number: 0` appears on the wire. The B1 gate had to learn the
// opposite — proto3 OMITS a scalar holding its default, which is why `v: 0` could
// not be swept there. Same encoder, opposite rule, decided by the schema being
// encoded rather than by the encoder.
//
// Field numbers, all measured off `protoc --decode_raw` rather than recalled:
//
//   FileDescriptorSet   file=1
//   FileDescriptorProto name=1 package=2 message_type=4 enum_type=5 service=6
//                       syntax=12
//   DescriptorProto     name=1 field=2 nested_type=3 enum_type=4
//   FieldDescriptorProto name=1 number=3 label=4 type=5 type_name=6 json_name=10
//   EnumDescriptorProto name=1 value=2
//   EnumValueDescriptorProto name=1 number=2
//   ServiceDescriptorProto name=1 method=2
//   MethodDescriptorProto name=1 input_type=2 output_type=3
//                        client_streaming=5 server_streaming=6

import "wire.mere";
import "parse.mere";

module Pdesc {

  let label_optional = 1;
  let label_repeated = 3;

  // A submessage is built into its own buffer because its length has to be known
  // before its tag can be written — the same reason `Wire.put_delimited` exists.
  let sub = fn (f) ->
    let b = vec_new () in
    let _ = f b in
    bytes_of_vec b;

  let put_msg = fn (out, field: int, payload: bytes) ->
    let _ = Wire.tag out field Wire.delimited in
    Wire.put_bytes out payload;

  let put_string = fn (out, field: int, s: str) ->
    let _ = Wire.tag out field Wire.delimited in
    Wire.put_str out s;

  let put_int = fn (out, field: int, v: int) ->
    let _ = Wire.tag out field Wire.varint in
    Wire.put_varint out v;

  let put_bool = fn (out, field: int, v: bool) ->
    let _ = Wire.tag out field Wire.varint in
    Wire.put_varint out (if v then 1 else 0);

  // --- options ---------------------------------------------------------------
  //
  // THE SUBSET LIVES HERE, NOT IN THE PARSER. An option's name means nothing to the
  // grammar — `option x = 1;` is well-formed whatever `x` is — and the field number
  // that encodes it belongs to `descriptor.proto`, which is this file's business. So
  // the parser accepts any `name = value` and this refuses a name it cannot encode,
  // BY NAME. Putting the list of known names in both places is how the two drift.
  //
  // Every number below was read out of `descriptor.proto`, not recalled:
  //
  //   FileOptions       java_package=1 java_outer_classname=8 java_multiple_files=10
  //                     optimize_for=9 go_package=11 deprecated=23 cc_enable_arenas=31
  //                     objc_class_prefix=36 csharp_namespace=37 swift_prefix=39
  //                     php_namespace=41 ruby_package=45
  //   FieldOptions      ctype=1 packed=2 deprecated=3 lazy=5 jstype=6
  //   MessageOptions    message_set_wire_format=1 no_standard_descriptor_accessor=2
  //                     deprecated=3
  //   EnumOptions       allow_alias=2 deprecated=3
  //   EnumValueOptions  deprecated=1
  //   ServiceOptions    deprecated=33
  //   MethodOptions     deprecated=33 idempotency_level=34
  //
  // `json_name` is NOT in the field table and that is the whole point of measuring:
  // `[json_name = "wireY"]` sets FieldDescriptorProto's `json_name` (field 10)
  // DIRECTLY and produces no `options` submessage at all. Treating it as an option
  // would put it in the wrong message with a field number that means something else.

  let kind_str = 0;
  let kind_bool = 1;
  let kind_optimize = 2;
  let kind_jstype = 3;
  let kind_ctype = 4;
  let kind_idem = 5;

  let file_opts_table =
    [("java_package", 1, kind_str), ("java_outer_classname", 8, kind_str),
     ("java_multiple_files", 10, kind_bool), ("optimize_for", 9, kind_optimize),
     ("go_package", 11, kind_str), ("deprecated", 23, kind_bool),
     ("cc_enable_arenas", 31, kind_bool), ("objc_class_prefix", 36, kind_str),
     ("csharp_namespace", 37, kind_str), ("swift_prefix", 39, kind_str),
     ("php_namespace", 41, kind_str), ("ruby_package", 45, kind_str)];

  let field_opts_table =
    [("ctype", 1, kind_ctype), ("packed", 2, kind_bool), ("deprecated", 3, kind_bool),
     ("lazy", 5, kind_bool), ("jstype", 6, kind_jstype)];

  let msg_opts_table =
    [("message_set_wire_format", 1, kind_bool),
     ("no_standard_descriptor_accessor", 2, kind_bool), ("deprecated", 3, kind_bool)];

  let enum_opts_table = [("allow_alias", 2, kind_bool), ("deprecated", 3, kind_bool)];
  let enumval_opts_table = [("deprecated", 1, kind_bool)];
  let svc_opts_table = [("deprecated", 33, kind_bool)];
  let method_opts_table = [("deprecated", 33, kind_bool),
                           ("idempotency_level", 34, kind_idem)];

  let rec opt_lookup = fn (tbl, name: str) ->
    match tbl with
    | [] -> []
    | [(n, f, k), ...rest] ->
      if str_eq n name then Cons ((f, k), []) else opt_lookup rest name;

  // An enum-valued option carries a NAME in the source and a NUMBER on the wire, and
  // the numbers are `descriptor.proto`'s. Measured: OptimizeMode SPEED=1 CODE_SIZE=2
  // LITE_RUNTIME=3 (note it does NOT start at 0), JSType JS_NORMAL=0 JS_STRING=1
  // JS_NUMBER=2, CType STRING=0 CORD=1 STRING_PIECE=2, IdempotencyLevel
  // IDEMPOTENCY_UNKNOWN=0 NO_SIDE_EFFECTS=1 IDEMPOTENT=2.
  let enum_opt_num = fn (kind: int, oname: str, v: str) ->
    let tbl =
      if kind == kind_optimize then
        [("SPEED", 1), ("CODE_SIZE", 2), ("LITE_RUNTIME", 3)]
      else if kind == kind_jstype then
        [("JS_NORMAL", 0), ("JS_STRING", 1), ("JS_NUMBER", 2)]
      else if kind == kind_ctype then
        [("STRING", 0), ("CORD", 1), ("STRING_PIECE", 2)]
      else [("IDEMPOTENCY_UNKNOWN", 0), ("NO_SIDE_EFFECTS", 1), ("IDEMPOTENT", 2)] in
    let rec go = fn (ts) ->
      match ts with
      | [] -> fail ("proto: '" ++ v ++ "' is not a value of option '" ++ oname
                    ++ "' — the value names an enum in descriptor.proto and this"
                    ++ " one has no such name")
      | [(n, num), ...rest] -> if str_eq n v then num else go rest in
    go tbl;

  // One option, as (field number, writer). Sorted by field number afterwards, because
  // PROTOC EMITS OPTIONS IN ASCENDING FIELD ORDER AND NOT SOURCE ORDER — measured:
  // `option go_package` then `option java_package` comes back as field 1 then 11.
  // The same rule the field encoder already follows, for the same reason.
  let opt_entry = fn (ctx: str, tbl, o: popt) ->
    match o with
    | POpt (name, v) ->
      match opt_lookup tbl name with
      | [] ->
        fail ("proto: option '" ++ name ++ "' is not in this encoder's subset ("
              ++ ctx ++ ") — the option's field number comes from descriptor.proto"
              ++ " and this one is not carried, so it is refused rather than dropped")
      | [(f, kind), ..._] ->
        if kind == kind_str then
          (match v with
           | POStr sv -> (f, fn (b) -> put_string b f sv)
           | _ -> fail ("proto: option '" ++ name ++ "' takes a string"))
        else if kind == kind_bool then
          (match v with
           | POBool bv -> (f, fn (b) -> put_bool b f bv)
           | _ -> fail ("proto: option '" ++ name ++ "' takes true or false"))
        else
          (match v with
           | POIdent iv -> (f, fn (b) -> put_int b f (enum_opt_num kind name iv))
           | _ -> fail ("proto: option '" ++ name
                        ++ "' takes an enum value name, not a literal"));

  // The `options` submessage, or nothing. An unset optional submessage is OMITTED by
  // protoc, so an empty one would add two bytes it does not write — except for a
  // method body, where the emptiness IS the content and the caller says so.
  let opts_sub = fn (ctx: str, tbl, opts) ->
    let entries = list_map opts (fn (o) -> opt_entry ctx tbl o) in
    let sorted = list_sort_by (fn (a, b) -> let (fa, _) = a in let (fb, _) = b in fa <= fb)
                   entries in
    sub (fn (b) -> list_iter sorted (fn (e) -> let (_, w) = e in w b));

  let put_opts = fn (out, field: int, ctx: str, tbl, opts) ->
    if list_len opts == 0 then () else put_msg out field (opts_sub ctx tbl opts);

  // `json_name` in a field's brackets OVERRIDES the derived one. It is looked up here
  // rather than in the options table because it is not an option — see above.
  let rec json_override = fn (opts) ->
    match opts with
    | [] -> []
    | [POpt (n, v), ...rest] ->
      if str_eq n "json_name" then
        (match v with
         | POStr sv -> Cons (sv, [])
         | _ -> fail "proto: json_name takes a string")
      else json_override rest;

  let rec without_json_name = fn (opts) ->
    match opts with
    | [] -> []
    | [o, ...rest] ->
      match o with
      | POpt (n, _) ->
        if str_eq n "json_name" then without_json_name rest
        else Cons (o, without_json_name rest);

  // --- FieldDescriptorProto ------------------------------------------------
  // `label` and `json_name` are ALWAYS written: descriptor.proto is proto2, so
  // protoc emits them for every field and a descriptor without them differs.
  let field_desc = fn (decls, scope: str, f: pfield) ->
    match f with
    | PField (name, num, rep, ty, opts) ->
      // FIELD ORDER MATTERS AND IT IS NOT SOURCE ORDER: `options` is field 8 and
      // `json_name` is field 10, so options come first. protoc writes a message's
      // fields ascending, and a descriptor that decodes the same but orders these two
      // differently is still different bytes.
      let jname = match json_override opts with
                  | [] -> Pparse.json_name name
                  | [j, ..._] -> j in
      let fopts = without_json_name opts in
      sub (fn (b) ->
        let _ = put_string b 1 name in
        let _ = put_int b 3 num in
        let _ = put_int b 4 (if rep then label_repeated else label_optional) in
        let _ = match ty with
                | PScalar (_, code) -> put_int b 5 code
                | PRef n ->
                  let (q, is_msg) = Pparse.resolve decls scope n in
                  let _ = put_int b 5 (if is_msg then Pparse.ty_message
                                       else Pparse.ty_enum) in
                  put_string b 6 q in
        let _ = put_opts b 8 "a field" field_opts_table fopts in
        put_string b 10 jname);

  // --- EnumDescriptorProto -------------------------------------------------
  let enum_desc = fn (e: penum) ->
    match e with
    | PEnum (name, vals, opts) ->
      sub (fn (b) ->
        let _ = put_string b 1 name in
        let _ = list_iter vals (fn (v) ->
          match v with
          | PEnumV (vn, vnum, vopts) ->
            // `number: 0` IS written. proto2 presence, not proto3 defaults.
            put_msg b 2 (sub (fn (c) ->
              let _ = put_string c 1 vn in
              let _ = put_int c 2 vnum in
              put_opts c 3 "an enum value" enumval_opts_table vopts))) in
        put_opts b 3 "an enum" enum_opts_table opts);

  // --- DescriptorProto -----------------------------------------------------
  // The scope grows as it descends, because a field's type reference resolves from
  // the innermost enclosing message outward.
  let rec msg_desc = fn (decls, scope: str, m: pmsg) ->
    match m with
    | PMsg (name, fields, subs, enums, opts) ->
      let inner = scope ++ "." ++ name in
      sub (fn (b) ->
        let _ = put_string b 1 name in
        let _ = list_iter fields (fn (f) -> put_msg b 2 (field_desc decls inner f)) in
        let _ = list_iter subs (fn (sm) -> put_msg b 3 (msg_desc decls inner sm)) in
        let _ = list_iter enums (fn (e) -> put_msg b 4 (enum_desc e)) in
        put_opts b 7 "a message" msg_opts_table opts);

  // --- ServiceDescriptorProto ----------------------------------------------
  // `client_streaming` / `server_streaming` are only written when true: they are
  // proto2 optional bools and protoc omits an unset one, so writing `false` would
  // add bytes protoc does not.
  let svc_desc = fn (decls, scope: str, v: psvc) ->
    match v with
    | PSvc (name, ms, opts) ->
      // name=1, method=2, options=3 — written in that order because protoc writes a
      // message's fields ascending and these bytes are compared, not decoded.
      sub (fn (b) ->
        let _ = put_string b 1 name in
        let _ = list_iter ms (fn (m) ->
          match m with
          | PMethod (mn, inty, outty, cs, ss, has_body, mopts) ->
            put_msg b 2 (sub (fn (c) ->
              let (qi, _) = Pparse.resolve decls scope inty in
              let (qo, _) = Pparse.resolve decls scope outty in
              let _ = put_string c 1 mn in
              let _ = put_string c 2 qi in
              let _ = put_string c 3 qo in
              // `options` (field 4) is written when the method HAD BRACES, even if
              // they were empty: presence is the content there. protoc emits `22 00`
              // for `{}` and nothing at all for the `;` form — that two-byte
              // difference was the last of 72 files to match.
              let _ = if has_body then
                        put_msg c 4 (opts_sub "a method" method_opts_table mopts)
                      else () in
              let _ = if cs then put_bool c 5 true else () in
              if ss then put_bool c 6 true else ()))) in
        put_opts b 3 "a service" svc_opts_table opts);

  // --- FileDescriptorProto / FileDescriptorSet -----------------------------
  // `loaded` is (path, pfile) for every imported file the caller has read. It is what
  // makes a cross-file type reference resolvable: `dep.Shared` becomes `.dep.Shared`
  // only if the imported file's PACKAGE is known, and whether it is TYPE_MESSAGE or
  // TYPE_ENUM only if its declarations are.
  let file_desc_in = fn (loaded, f: pfile) ->
    let decls = Pparse.visible_decls loaded f in
    match f with
    | PFile (fname, pkg, imps, msgs, enums, svcs, opts) ->
      let scope = if str_eq pkg "" then "" else "." ++ pkg in
      // name=1 package=2 dependency=3 message_type=4 enum_type=5 service=6 options=8
      // public_dependency=10 weak_dependency=11 syntax=12, written ascending — so the
      // paths come BEFORE the messages and the two index lists come AFTER them.
      //
      // `public_dependency` and `weak_dependency` hold INDICES into `dependency`, not
      // paths. Measured: three imports where the second is public and the third weak
      // give `10: 1` and `11: 2`.
      sub (fn (b) ->
        let _ = put_string b 1 fname in
        let _ = if str_eq pkg "" then () else put_string b 2 pkg in
        let _ = list_iter imps (fn (im) ->
                  match im with | PImport (path, _, _) -> put_string b 3 path) in
        let _ = list_iter msgs (fn (m) -> put_msg b 4 (msg_desc decls scope m)) in
        let _ = list_iter enums (fn (e) -> put_msg b 5 (enum_desc e)) in
        let _ = list_iter svcs (fn (v) -> put_msg b 6 (svc_desc decls scope v)) in
        let _ = put_opts b 8 "a file" file_opts_table opts in
        let rec idx = fn (xs, n: int, want_public: bool) ->
          match xs with
          | [] -> ()
          | [PImport (_, isp, isw), ...rest] ->
            let hit = if want_public then isp else isw in
            let _ = if hit then put_int b (if want_public then 10 else 11) n else () in
            idx rest (n + 1) want_public in
        let _ = idx imps 0 true in
        let _ = idx imps 0 false in
        put_string b 12 "proto3");

  let file_desc = fn (f: pfile) -> file_desc_in [] f;

  let file_set_in = fn (loaded, f: pfile) ->
    let b = vec_new () in
    let _ = put_msg b 1 (file_desc_in loaded f) in
    bytes_of_vec b;

  let file_set = fn (f: pfile) -> file_set_in [] f;

  // The descriptor for one file, with the sources of the files it imports. `deps` is
  // (path, source) — I/O stays with the caller, which is why this takes text rather
  // than reading anything.
  let of_sources = fn (fname: str, src: str, deps) ->
    let loaded = list_map deps (fn (d) ->
                   let (p, s) = d in (p, Pparse.parse_file p s)) in
    file_set_in loaded (Pparse.parse_file fname src);

  let of_source = fn (fname: str, src: str) -> of_sources fname src [];
}
