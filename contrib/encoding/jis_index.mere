// contrib/encoding/jis_index.mere — GENERATED. Do not edit.
//
// Written by scripts/gen_jis_index.sh from the Encoding Standard's own
// published index files, whose Identifier hashes are pinned in that
// script. Run it to regenerate.
//
// Deliberately NOT derived from node, which is the oracle elsewhere in
// contrib/encoding: node's shift_jis is ICU's CP932, and while its
// jis0208 is identical to the Standard's in all 8,836 slots, its jis0212
// maps 21 pointers the Standard does not. A browser implements the
// Standard. scripts/encoding_parity.sh records the difference.
//
// index-jis0208.txt  cbaa91f3deb7d0841faf5c33041fc15a285da0e87e64ab802c4bf04b7c4da861
// index-jis0212.txt  83bf90dd1c591a4355730d8c4567efc499d74da7490531019ef22a879991cfb7
//
// jis0208: 8836 slots, 7336 mapped, max U+FFE5
// jis0212: 8836 slots, 6067 mapped, max U+FF5E
//
// Four hexadecimal characters per slot, and `0000` for a hole. Fixed width
// so a slot is four O(1) char_at reads with no startup pass, and hex rather
// than raw 16-bit values because a str is strlen-based on the LLVM backend
// and a raw table is full of 0x00 bytes. U+0000 is not a mapping either
// table produces, so the hole sentinel needs no separate presence bitmap.

module JisIndex {

  let _hexval = fn (b: int) -> if b >= 48 && b <= 57 then b - 48 else b - 55;

  // -1 for a pointer outside the table or for a hole, which the callers
  // treat identically: both mean "this pair is not a character".
  let _lookup = fn (t: str) -> fn (n: int) -> fn (p: int) ->
    if p < 0 || p >= n then 0 - 1
    else
      let i = p * 4 in
      let v = _hexval (ord (char_at t i)) * 4096
              + _hexval (ord (char_at t (i + 1))) * 256
              + _hexval (ord (char_at t (i + 2))) * 16
              + _hexval (ord (char_at t (i + 3))) in
      if v == 0 then 0 - 1 else v;

  let jis0208_len = 8836;
  let jis0212_len = 8836;

  let _jis0208 = "";

  let _jis0212 = "";

  let code_point_208 = fn (p: int) -> _lookup _jis0208 jis0208_len p;
  let code_point_212 = fn (p: int) -> _lookup _jis0212 jis0212_len p;

}
