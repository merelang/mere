// contrib/softfloat/limbs — a 90-bit unsigned integer as six 15-bit limbs.
//
// The working width for adding two doubles. A significand is 53 bits; aligning
// one against the other needs room below it for the guard and round bits and a
// sticky, and room above for the carry out of an addition. Six limbs is 90
// bits, which is more than either needs and keeps the shifts from having to be
// clever.
//
// 15 bits per limb for the reason the fraction uses them: a product of two
// limbs must fit the narrowest int any backend has, RV32I's signed 32-bit
// word. Addition needs far less, but one limb width for the whole library
// means the multiply that comes later does not get a second one.
//
// Little-endian: l0 is the low 15 bits. Nothing here mentions `float`.

type L6 = { l5: int, l4: int, l3: int, l2: int, l1: int, l0: int };

let lmask = 32767;            // 2^15 - 1
let lbits = 15;

let l6_zero = L6 { l5 = 0, l4 = 0, l3 = 0, l2 = 0, l1 = 0, l0 = 0 };

let l6_is_zero = fn (a: L6) ->
  a.l5 == 0 && a.l4 == 0 && a.l3 == 0 && a.l2 == 0 && a.l1 == 0 && a.l0 == 0;

// Compare magnitudes: -1, 0 or 1. Most significant limb first.
let l6_cmp = fn (a: L6) -> fn (b: L6) ->
  if a.l5 != b.l5 then (if a.l5 < b.l5 then 0 - 1 else 1)
  else if a.l4 != b.l4 then (if a.l4 < b.l4 then 0 - 1 else 1)
  else if a.l3 != b.l3 then (if a.l3 < b.l3 then 0 - 1 else 1)
  else if a.l2 != b.l2 then (if a.l2 < b.l2 then 0 - 1 else 1)
  else if a.l1 != b.l1 then (if a.l1 < b.l1 then 0 - 1 else 1)
  else if a.l0 != b.l0 then (if a.l0 < b.l0 then 0 - 1 else 1)
  else 0;

// Sum, discarding any carry out of l5. The caller keeps the result in range by
// leaving a limb of headroom, which every use here does.
let l6_add = fn (a: L6) -> fn (b: L6) ->
  let s0 = a.l0 + b.l0 in
  let s1 = a.l1 + b.l1 + bit_shr s0 lbits in
  let s2 = a.l2 + b.l2 + bit_shr s1 lbits in
  let s3 = a.l3 + b.l3 + bit_shr s2 lbits in
  let s4 = a.l4 + b.l4 + bit_shr s3 lbits in
  let s5 = a.l5 + b.l5 + bit_shr s4 lbits in
  L6 { l5 = bit_and s5 lmask, l4 = bit_and s4 lmask, l3 = bit_and s3 lmask,
       l2 = bit_and s2 lmask, l1 = bit_and s1 lmask, l0 = bit_and s0 lmask };

// a - b, for a >= b. Borrowing is done by adding the base before subtracting so
// no intermediate goes negative -- a negative limb would be a different bug on
// every backend, since the widths differ.
let l6_sub = fn (a: L6) -> fn (b: L6) ->
  let base = 32768 in
  let d0 = a.l0 - b.l0 + base in
  let c0 = if d0 < base then 1 else 0 in
  let d1 = a.l1 - b.l1 - c0 + base in
  let c1 = if d1 < base then 1 else 0 in
  let d2 = a.l2 - b.l2 - c1 + base in
  let c2 = if d2 < base then 1 else 0 in
  let d3 = a.l3 - b.l3 - c2 + base in
  let c3 = if d3 < base then 1 else 0 in
  let d4 = a.l4 - b.l4 - c3 + base in
  let c4 = if d4 < base then 1 else 0 in
  let d5 = a.l5 - b.l5 - c4 + base in
  L6 { l5 = bit_and d5 lmask, l4 = bit_and d4 lmask, l3 = bit_and d3 lmask,
       l2 = bit_and d2 lmask, l1 = bit_and d1 lmask, l0 = bit_and d0 lmask };


let l6_limb = fn (a: L6) -> fn (i: int) ->
  if i == 0 then a.l0 else if i == 1 then a.l1 else if i == 2 then a.l2
  else if i == 3 then a.l3 else if i == 4 then a.l4 else if i == 5 then a.l5
  else 0;

let l6_of_limbs = fn (l5: int) -> fn (l4: int) -> fn (l3: int) ->
                  fn (l2: int) -> fn (l1: int) -> fn (l0: int) ->
  L6 { l5 = bit_and l5 lmask, l4 = bit_and l4 lmask, l3 = bit_and l3 lmask,
       l2 = bit_and l2 lmask, l1 = bit_and l1 lmask, l0 = bit_and l0 lmask };

// shift left by one bit, discarding the bit out of the top
let l6_shl1 = fn (a: L6) ->
  l6_of_limbs
    (bit_or (bit_shl a.l5 1) (bit_shr a.l4 14))
    (bit_or (bit_shl a.l4 1) (bit_shr a.l3 14))
    (bit_or (bit_shl a.l3 1) (bit_shr a.l2 14))
    (bit_or (bit_shl a.l2 1) (bit_shr a.l1 14))
    (bit_or (bit_shl a.l1 1) (bit_shr a.l0 14))
    (bit_shl a.l0 1);

// shift right by one bit; returns the bit that fell off, so a caller can build
// a sticky without looking inside
let l6_shr1 = fn (a: L6) ->
  l6_of_limbs
    (bit_shr a.l5 1)
    (bit_or (bit_shr a.l4 1) (bit_shl (bit_and a.l5 1) 14))
    (bit_or (bit_shr a.l3 1) (bit_shl (bit_and a.l4 1) 14))
    (bit_or (bit_shr a.l2 1) (bit_shl (bit_and a.l3 1) 14))
    (bit_or (bit_shr a.l1 1) (bit_shl (bit_and a.l2 1) 14))
    (bit_or (bit_shr a.l0 1) (bit_shl (bit_and a.l1 1) 14));

let l6_low_bit = fn (a: L6) -> bit_and a.l0 1;

let rec l6_shl = fn (a: L6) -> fn (n: int) ->
  if n <= 0 then a else l6_shl (l6_shl1 a) (n - 1);

// Shift right by n, returning the value and whether any 1 was shifted out.
// The sticky is the whole reason this is not just a shift: rounding needs to
// know that something was lost, not only what the last bit was.
let rec l6_shr_sticky_go = fn (a: L6) -> fn (n: int) -> fn (st: int) ->
  if n <= 0 then (a, st)
  else l6_shr_sticky_go (l6_shr1 a) (n - 1) (bit_or st (l6_low_bit a));
let l6_shr_sticky = fn (a: L6) -> fn (n: int) -> l6_shr_sticky_go a n 0;

// number of bits needed to hold the value; 0 for zero
let rec l6_bitlen_limb = fn (v: int) -> fn (acc: int) ->
  if v == 0 then acc else l6_bitlen_limb (bit_shr v 1) (acc + 1);
let l6_bitlen = fn (a: L6) ->
  if a.l5 != 0 then 75 + l6_bitlen_limb a.l5 0
  else if a.l4 != 0 then 60 + l6_bitlen_limb a.l4 0
  else if a.l3 != 0 then 45 + l6_bitlen_limb a.l3 0
  else if a.l2 != 0 then 30 + l6_bitlen_limb a.l2 0
  else if a.l1 != 0 then 15 + l6_bitlen_limb a.l1 0
  else l6_bitlen_limb a.l0 0;

// bit i of the 90, counting from 0. Rounding needs to look at three specific
// bits and normalisation at one, and reaching into the limbs from outside would
// put the 15 in two files.
let l6_bit = fn (a: L6) -> fn (i: int) ->
  let li = i / 15 in
  bit_and (bit_shr (l6_limb a li) (i - li * 15)) 1;

let l6_one = l6_of_limbs 0 0 0 0 0 1;
