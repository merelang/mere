// contrib/softfloat — an IEEE 754 double as integers a 32-bit target can hold.
//
// This file never mentions `float`. That is the point: the narrowest backend
// (RV32I) has no float in its value model, so a library that needs one there
// cannot be written in terms of one. The bridge to hardware doubles lives in
// the gate that checks this code, not in the code.
//
// Representation. A double is 64 bits: sign(1) exponent(11) fraction(52).
// The fraction is held little-endian in FOUR 15-BIT LIMBS. 15 because a
// product of two limbs must fit the narrowest int any backend has, which is
// RV32I's signed 32-bit word: 15 + 15 = 30 bits, and the sign bit is left
// alone. Splitting into 32-bit halves the way `float_bits_hi` / `float_bits_lo`
// do is the obvious alternative and it does not work here -- those return
// UNSIGNED 32-bit values (`float_bits_hi (-1.0)` is 3220176896) and this
// target's int is signed and 32 wide, so the half does not fit either.

type Sf = { sign: int, exp: int, f3: int, f2: int, f1: int, f0: int };

let limb_mask = 32767;        // 2^15 - 1
let exp_mask = 2047;          // 2^11 - 1

// The raw fields, unchecked. Callers that decode a bit pattern use this.
let mk = fn (sign: int) -> fn (exp: int) -> fn (f3: int) -> fn (f2: int) ->
         fn (f1: int) -> fn (f0: int) ->
  Sf { sign = bit_and sign 1, exp = bit_and exp exp_mask,
    f3 = bit_and f3 limb_mask, f2 = bit_and f2 limb_mask,
    f1 = bit_and f1 limb_mask, f0 = bit_and f0 limb_mask };

let zero = mk 0 0 0 0 0 0;
let neg_zero = mk 1 0 0 0 0 0;
let inf = mk 0 2047 0 0 0 0;
let neg_inf = mk 1 2047 0 0 0 0;
// Any non-zero fraction with a full exponent is a NaN; this is the quiet one
// every backend's hardware produces for 0.0 / 0.0.
let nan = mk 0 2047 64 0 0 0;

// --- classification -------------------------------------------------------

let frac_is_zero = fn (a: Sf) -> a.f3 == 0 && a.f2 == 0 && a.f1 == 0 && a.f0 == 0;
let is_nan = fn (a: Sf) -> a.exp == 2047 && not (frac_is_zero a);
let is_inf = fn (a: Sf) -> a.exp == 2047 && frac_is_zero a;
let is_zero = fn (a: Sf) -> a.exp == 0 && frac_is_zero a;
// Subnormals carry no implicit leading 1, which is why they need a name here
// rather than falling out of the exponent test.
let is_subnormal = fn (a: Sf) -> a.exp == 0 && not (frac_is_zero a);
let is_finite = fn (a: Sf) -> a.exp != 2047;

// --- sign -----------------------------------------------------------------

// Flipping the sign is defined on every value, NaN included -- IEEE 754 says
// negation is a bit operation, not an arithmetic one, so it does not quiet a
// signalling NaN or raise anything.
let neg = fn (a: Sf) ->
  Sf { sign = bit_xor a.sign 1, exp = a.exp, f3 = a.f3, f2 = a.f2, f1 = a.f1, f0 = a.f0 };
let abs = fn (a: Sf) ->
  Sf { sign = 0, exp = a.exp, f3 = a.f3, f2 = a.f2, f1 = a.f1, f0 = a.f0 };
let is_neg = fn (a: Sf) -> a.sign == 1;

// --- comparison -----------------------------------------------------------

// Magnitude order, ignoring the sign. The fields are laid out most-significant
// first on purpose: exponent, then limbs from f3 down, so this is a plain
// lexicographic walk.
let rec cmp_mag = fn (a: Sf) -> fn (b: Sf) ->
  if a.exp != b.exp then (if a.exp < b.exp then 0 - 1 else 1)
  else if a.f3 != b.f3 then (if a.f3 < b.f3 then 0 - 1 else 1)
  else if a.f2 != b.f2 then (if a.f2 < b.f2 then 0 - 1 else 1)
  else if a.f1 != b.f1 then (if a.f1 < b.f1 then 0 - 1 else 1)
  else if a.f0 != b.f0 then (if a.f0 < b.f0 then 0 - 1 else 1)
  else 0;

// IEEE equality: NaN is equal to nothing, and -0.0 equals +0.0. Neither falls
// out of a bit comparison, which is why this is not one.
let eq = fn (a: Sf) -> fn (b: Sf) ->
  if is_nan a || is_nan b then false
  else if is_zero a && is_zero b then true
  else a.sign == b.sign && cmp_mag a b == 0;

let lt = fn (a: Sf) -> fn (b: Sf) ->
  if is_nan a || is_nan b then false
  else if is_zero a && is_zero b then false
  else if a.sign != b.sign then a.sign == 1
  else if a.sign == 0 then cmp_mag a b < 0
  else cmp_mag a b > 0;

let gt = fn (a: Sf) -> fn (b: Sf) -> lt b a;
let le = fn (a: Sf) -> fn (b: Sf) -> if is_nan a || is_nan b then false else not (lt b a);
let ge = fn (a: Sf) -> fn (b: Sf) -> if is_nan a || is_nan b then false else not (lt a b);
