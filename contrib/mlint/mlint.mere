// contrib/mlint/mlint.mere — a tiny linter for Mere source, written in Mere.
//
// It parses a source string into the shared self-host AST
// (contrib/parser/parser.mere's `parse_program_ast`) and runs a set of lint
// rules over it. This dogfoods the trait system on a real, AST-sized program:
//   - lint rules are `dyn Rule` values (dynamic dispatch over a heterogeneous
//     list of rules), each with `check : 'a -> program -> diag list`;
//   - diagnostics `derive (Eq, Ord)` so they can be deduplicated and sorted;
//   - `Ord` is a super-trait of `Eq`, both carrying structural defaults.
//
// The self-host AST is position-less, so diagnostics are messages (no line
// numbers) — a known limitation recorded in PAIN.md.
import "github.com/merelang/mere/contrib/parser/parser.mere";

// --- small helpers ---------------------------------------------------------
let any = fn f -> fn xs -> list_fold xs false (fn acc -> fn x -> (if acc then true else f x));
let concat_map = fn f -> fn xs -> list_fold xs Nil (fn acc -> fn x -> list_append acc (f x));
let lmap = fn f -> fn xs -> list_map xs f;   // (f, xs) order; prelude's is (xs, f)

// --- diagnostics -----------------------------------------------------------
type diag = Diag of str;
let diag_msg = fn d -> (match d with Diag m -> m);

// Structural Eq / Ord for user types via builtin ==/< ; `derive` fills the
// instances from these defaults, so `diag` gets both for free.
trait Eq 'a  { eq : 'a -> 'a -> bool = fn a -> fn b -> a == b; }
trait Ord 'a : Eq 'a { lt : 'a -> 'a -> bool = fn a -> fn b -> a < b; }
derive (Eq, Ord) diag;

// insertion sort + dedup adjacent, using the derived Ord/Eq on `diag`
let rec insert_sorted = fn x -> fn xs ->
  (match xs with
   | Nil -> Cons (x, Nil)
   | Cons (h, t) -> (if lt x h then Cons (x, Cons (h, t)) else Cons (h, insert_sorted x t)));
let sort_diags = fn ds -> list_fold ds Nil (fn acc -> fn d -> insert_sorted d acc);
let rec dedup = fn ds ->
  (match ds with
   | Nil -> Nil
   | Cons (h, Nil) -> Cons (h, Nil)
   | Cons (h, Cons (h2, t)) ->
     (if eq h h2 then dedup (Cons (h2, t)) else Cons (h, dedup (Cons (h2, t)))));

// --- free-occurrence check (conservative: ignores shadowing, so it never
// reports a binding as unused when the name reappears) ----------------------
let rec occurs = fn name -> fn e ->
  (match e with
   | EVar v -> v == name
   | EInt _ -> false
   | EFloat _ -> false
   | EBool _ -> false
   | EStr _ -> false
   | EUnit -> false
   | EBin (_, a, b) -> (if occurs name a then true else occurs name b)
   | ECmp (_, a, b) -> (if occurs name a then true else occurs name b)
   | ELogic (_, a, b) -> (if occurs name a then true else occurs name b)
   | EApp (a, b) -> (if occurs name a then true else occurs name b)
   | ENeg a -> occurs name a
   | EAnnot (a, _) -> occurs name a
   | EFieldGet (a, _) -> occurs name a
   | ELet (_, v, b) -> (if occurs name v then true else occurs name b)
   | ELetRec (bs, b) -> (if any (fn p -> occurs name (match p with (_, v) -> v)) bs then true else occurs name b)
   | EIf (c, t, f) -> (if occurs name c then true else (if occurs name t then true else occurs name f))
   | EFun (_, _, b) -> occurs name b
   | EConstr (_, None) -> false
   | EConstr (_, Some a) -> occurs name a
   | EMatch (s, arms) ->
     (if occurs name s then true
      else any (fn arm -> (match arm with (_, g, b) ->
        (if (match g with Some ge -> occurs name ge | None -> false) then true else occurs name b))) arms)
   | ETuple es -> any (occurs name) es
   | ERecordLit (_, fs) -> any (fn fld -> occurs name (match fld with (_, v) -> v)) fs
   | ERecordUpdate (a, fs) -> (if occurs name a then true else any (fn fld -> occurs name (match fld with (_, v) -> v)) fs));

// --- generic AST walk ------------------------------------------------------
// Immediate sub-expressions of a node (binders' bound names are handled by
// each rule, not here).
let collect_subexprs = fn e ->
  (match e with
   | EBin (_, a, b) -> Cons (a, Cons (b, Nil))
   | ECmp (_, a, b) -> Cons (a, Cons (b, Nil))
   | ELogic (_, a, b) -> Cons (a, Cons (b, Nil))
   | EApp (a, b) -> Cons (a, Cons (b, Nil))
   | ENeg a -> Cons (a, Nil)
   | EAnnot (a, _) -> Cons (a, Nil)
   | EFieldGet (a, _) -> Cons (a, Nil)
   | ELet (_, v, b) -> Cons (v, Cons (b, Nil))
   | ELetRec (bs, b) -> list_append (lmap (fn p -> (match p with (_, v) -> v)) bs) (Cons (b, Nil))
   | EIf (c, t, f) -> Cons (c, Cons (t, Cons (f, Nil)))
   | EFun (_, _, b) -> Cons (b, Nil)
   | EConstr (_, Some a) -> Cons (a, Nil)
   | EMatch (s, arms) -> Cons (s, lmap (fn arm -> (match arm with (_, _, b) -> b)) arms)
   | ETuple es -> es
   | ERecordLit (_, fs) -> lmap (fn fld -> (match fld with (_, v) -> v)) fs
   | ERecordUpdate (a, fs) -> Cons (a, lmap (fn fld -> (match fld with (_, v) -> v)) fs)
   | _ -> Nil);

// Apply a per-node checker to every sub-expression of `e`.
let rec walk_all = fn chk -> fn e ->
  list_append (chk e) (concat_map (walk_all chk) (collect_subexprs e));

// Every top-level expression in a program (each decl's value(s) + the main).
let prog_exprs = fn prog ->
  (match prog with (decls, main) ->
    list_append
      (concat_map (fn d -> (match d with
        | TopLet (_, e) -> Cons (e, Nil)
        | TopLetRec bs -> lmap (fn p -> (match p with (_, v) -> v)) bs
        | _ -> Nil)) decls)
      (Cons (main, Nil)));

let rec member = fn x -> fn xs ->
  (match xs with Nil -> false | Cons (h, t) -> (if h == x then true else member x t));

// --- per-node checkers -----------------------------------------------------
let chk_unused_let = fn e ->
  (match e with
   | ELet (PVar x, _, body) ->
     (if x == "_" then Nil else (if occurs x body then Nil else Cons (Diag ("unused binding: " ++ x), Nil)))
   | _ -> Nil);
let chk_unused_param = fn e ->
  (match e with
   | EFun (x, _, body) ->
     (if x == "_" then Nil else (if occurs x body then Nil else Cons (Diag ("unused parameter: " ++ x), Nil)))
   | _ -> Nil);

// Shadowing needs an environment of in-scope names, so it threads its own env
// rather than using walk_all. (Match-arm binders aren't tracked yet.)
let rec lint_shadow = fn env -> fn e ->
  (match e with
   | ELet (PVar x, v, body) ->
     list_append
       (if member x env then Cons (Diag ("shadowed binding: " ++ x), Nil) else Nil)
       (list_append (lint_shadow env v) (lint_shadow (Cons (x, env)) body))
   | EFun (x, _, body) ->
     list_append
       (if member x env then Cons (Diag ("shadowed binding: " ++ x), Nil) else Nil)
       (lint_shadow (Cons (x, env)) body)
   | ELetRec (bs, body) ->
     let env2 = list_append (lmap (fn p -> (match p with (n, _) -> n)) bs) env in
     list_append
       (concat_map (fn p -> (match p with (_, v) -> lint_shadow env2 v)) bs)
       (lint_shadow env2 body)
   | _ -> concat_map (lint_shadow env) (collect_subexprs e));

// --- lint rules as trait objects (heterogeneous `dyn Rule` list) ----------
trait Rule 'a { rname : 'a -> str; check : 'a -> program -> diag list; }
// Leading `|` so a single nullary variant isn't read as a type alias
// (`type T = Ctor;` without the bar is parsed as an alias to a type `Ctor`).
type unused_binding_rule = | UnusedBinding;
type unused_param_rule   = | UnusedParam;
type shadow_rule         = | ShadowedBinding;
impl Rule unused_binding_rule {
  rname = fn r -> "unused-binding";
  check = fn r -> fn prog -> concat_map (walk_all chk_unused_let) (prog_exprs prog);
}
impl Rule unused_param_rule {
  rname = fn r -> "unused-param";
  check = fn r -> fn prog -> concat_map (walk_all chk_unused_param) (prog_exprs prog);
}
impl Rule shadow_rule {
  rname = fn r -> "shadowing";
  check = fn r -> fn prog -> concat_map (lint_shadow Nil) (prog_exprs prog);
}

let rules = [dyn Rule UnusedBinding, dyn Rule UnusedParam, dyn Rule ShadowedBinding];

// Each rule consumer annotates its parameter as `dyn Rule`: without it the
// typer infers a `Rule 'a =>` constraint (a dictionary-carrying value) rather
// than object dispatch, which fails to compile on the native backends.
let lint_program = fn prog ->
  dedup (sort_diags (concat_map (fn (ru : dyn Rule) -> check ru prog) rules));

// --- driver ---------------------------------------------------------------
// A built-in sample exercising all three rules (used when no file is given, so
// the program runs on every backend); with a path argument it lints that file
// (`args` / `read_file` are native/interp — a CLI linter's natural target).
let sample = "let used = 10; let f = fn n -> (let unused1 = n + 1 in n * 2); let paramtest = fn unusedp -> 5; let shadowtest = fn x -> (let x = x + 1 in x); used + f 3 + paramtest 0 + shadowtest 7";
let src = (match args () with
           | Cons (path, _) -> read_file path
           | Nil -> sample);
let diags = lint_program (parse_program_ast src);
let active = list_fold rules "" (fn acc -> fn (ru : dyn Rule) -> acc ++ rname ru ++ " ");
let _ = print ("mlint [" ++ active ++ "]: " ++ str_of_int (list_len diags) ++ " finding(s)") in
list_fold diags () (fn u -> fn d -> print ("  - " ++ diag_msg d))
