// contrib/stream/stream.mere — region-scoped line streaming.
//
// Implements `module Stream { each_line, count_lines }` in pure Mere (no added
// builtins). Each combinator reads a file one line at a time and processes it
// INSIDE a per-line `region` block, so the line string — and any scratch the
// callback allocates from it — is reclaimed as soon as that line is done.
// Peak memory is therefore O(longest line), not O(file).
//
// Why this matters: a plain streaming loop
//     let rec go = fn n -> match file_read_line f with
//       | None -> n | Some line -> go (n + ...)
// keeps every `line` in the program-lifetime region (a `str` carries no
// region tag, so the escape checker must assume it may escape). Over a large
// file that accumulates to O(file). Running the per-line work under a `region`
// block, and returning only an escape-clean value (a count, a bool) from the
// block, lets the existing region-reclaim machinery free each line in turn.
// Measured on a 57 MB / 1,000,000-line input: 61.7 MB -> 1.4 MB peak RSS.
//
// Usage:
//   import "contrib/stream/stream.mere";
//   // side effect per line (grep-style: print inside the scope):
//   Stream.each_line "big.txt" (fn line ->
//     if str_contains line "needle" then print line else ());
//   // count lines matching a predicate:
//   Stream.count_lines "big.txt" (fn line -> str_len line > 80)
//
// The callback must not let the line escape (e.g. store it in an outer
// container): a `str` that leaves the block is deep-copied into the enclosing
// region, which reintroduces O(file) growth. Side effects (print) and
// escape-clean results (int / bool) are the intended shapes. A general fold
// with an escape-clean accumulator follows the same pattern.
//
// Backends: interp + C (file_open / file_read_line / file_close are C+interp;
// the Wasm/LLVM backends do not implement per-line file input).

module Stream {

  // Apply `cb` to every line of the file at `path`, one at a time, each inside
  // its own region scope. `cb` is side-effecting (str -> unit).
  let each_line = fn (path: str) -> fn (cb: str -> unit) ->
    let f = file_open path in
    let rec go = fn (u: unit) ->
      let cont = region R {
        match file_read_line f with
        | None -> false
        | Some line -> let u2 = cb line in true
      } in
      if cont then go () else ()
    in
    let done = go () in
    file_close f;

  // Number of lines of the file at `path` that satisfy `pred`. The predicate
  // runs inside the per-line region scope, so the line is reclaimed each
  // iteration and peak memory stays O(longest line).
  let count_lines = fn (path: str) -> fn (pred: str -> bool) ->
    let f = file_open path in
    let rec go = fn (n: int) ->
      let step = region R {
        match file_read_line f with
        | None -> (0 - 1)
        | Some line -> if pred line then 1 else 0
      } in
      if step < 0 then n else go (n + step)
    in
    let total = go 0 in
    let closed = file_close f in
    total;

}
