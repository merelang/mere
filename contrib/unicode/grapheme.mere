// contrib/unicode/grapheme.mere — UAX #29 extended grapheme clusters.
//
// A grapheme cluster is what a reader calls a character, and it is what a
// renderer has to advance by: `á` is one, `👩‍👩‍👦` is one, `🇯🇵` is one, `\r\n`
// is one. Code points are not the unit, and neither are bytes.
//
// The rules are almost all local — look at the class of the two code points on
// either side of a position and decide — but four of them are not, and those
// four are where an implementation goes wrong:
//
//   * **GB12/13, flags.** Regional indicators pair up, so `🇯🇵` is one cluster
//     and `🇯🇵🇯` is two. Whether a break falls before an RI depends on how many
//     RIs precede it, not on the one before it. A count has to be carried.
//   * **GB11, emoji ZWJ sequences.** A break is suppressed after a ZWJ only if
//     the ZWJ was itself preceded by `ExtPict Extend*`. The ZWJ alone does not
//     say that.
//   * **GB9c, Indic conjuncts.** `क्ष` is one cluster because a Linker appeared
//     between two Consonants. Added in Unicode 15.1, and the reason the InCB
//     property is in the table at all.
//   * **GB9b, Prepend.** The suppression is decided by the LEFT character, which
//     is the only rule that looks that way round.
//
// So the walk carries four pieces of state, one per non-local rule, and every
// other rule reads only `prev` and `cur`.
//
// Usage:
//   import "contrib/unicode/grapheme.mere";
//   Grapheme.clusters "🇯🇵á"     // ["🇯🇵"; "á"]
//   Grapheme.count "👩‍👩‍👦"             // 1

import "gcb_table.mere";

module Grapheme {

  let _is_extend_like = fn (k: int) ->
    k == GcbTable.extend || k == GcbTable.extendincb || k == GcbTable.linker;

  // For GB9c the relevant property is InCB, where a ZWJ counts as Extend — the
  // table stores ZWJ as its own Grapheme_Cluster_Break class, so the ZWJ case is
  // spelled out here rather than being lost.
  let _is_incb_extend = fn (k: int) ->
    k == GcbTable.extendincb || k == GcbTable.zwj;

  // --- the rules ---------------------------------------------------------
  // `true` means a boundary falls between prev and cur. In UAX #29 order, so a
  // reader can check them against the standard line by line.
  //
  //   ri    consecutive regional indicators ending at prev   (GB12, GB13)
  //   pict  1 after `ExtPict Extend*`, 2 after that plus ZWJ (GB11)
  //   incb  1 after `Consonant [InCB-Extend]*`, 2 once a Linker has appeared (GB9c)

  let breaks_between = fn (prev: int) -> fn (cur: int) -> fn (ri: int) ->
                       fn (pict: int) -> fn (incb: int) ->
    // GB3: CR × LF
    if prev == GcbTable.cr && cur == GcbTable.lf then false
    // GB4: (Control | CR | LF) ÷
    else if prev == GcbTable.control || prev == GcbTable.cr || prev == GcbTable.lf
    then true
    // GB5: ÷ (Control | CR | LF)
    else if cur == GcbTable.control || cur == GcbTable.cr || cur == GcbTable.lf
    then true
    // GB6: L × (L | V | LV | LVT)
    else if prev == GcbTable.l
            && (cur == GcbTable.l || cur == GcbTable.v || cur == GcbTable.lv
                || cur == GcbTable.lvt)
    then false
    // GB7: (LV | V) × (V | T)
    else if (prev == GcbTable.lv || prev == GcbTable.v)
            && (cur == GcbTable.v || cur == GcbTable.t)
    then false
    // GB8: (LVT | T) × T
    else if (prev == GcbTable.lvt || prev == GcbTable.t) && cur == GcbTable.t
    then false
    // GB9: × (Extend | ZWJ)
    else if _is_extend_like cur || cur == GcbTable.zwj then false
    // GB9a: × SpacingMark
    else if cur == GcbTable.spacingmark then false
    // GB9b: Prepend ×
    else if prev == GcbTable.prepend then false
    // GB9c: Consonant [Extend Linker]* Linker [Extend Linker]* × Consonant
    else if incb == 2 && cur == GcbTable.consonant then false
    // GB11: ExtPict Extend* ZWJ × ExtPict
    else if pict == 2 && cur == GcbTable.extpict then false
    // GB12 and GB13: an odd number of preceding RIs means this one pairs
    else if prev == GcbTable.regional_indicator
            && cur == GcbTable.regional_indicator && ri % 2 == 1
    then false
    // GB999
    else true;

  // --- state carried across the walk -------------------------------------

  let _next_ri = fn (prev: int) -> fn (cur: int) -> fn (ri: int) ->
    if not (cur == GcbTable.regional_indicator) then 0
    else if prev == GcbTable.regional_indicator then ri + 1
    else 1;

  let _next_pict = fn (cur: int) -> fn (pict: int) ->
    // An ExtPict always starts a fresh sequence, including the one that GB11
    // just joined — `A ZWJ B ZWJ C` is one cluster.
    if cur == GcbTable.extpict then 1
    else if pict == 1 && _is_extend_like cur then 1
    else if pict == 1 && cur == GcbTable.zwj then 2
    else 0;

  let _next_incb = fn (cur: int) -> fn (incb: int) ->
    if cur == GcbTable.consonant then 1
    else if incb == 0 then 0
    else if cur == GcbTable.linker then 2
    else if _is_incb_extend cur then incb
    else 0;

  // --- the walk ----------------------------------------------------------
  // Over `utf8_chars`, which is one pass, rather than over indices: `codepoint_at`
  // walks the string each time it is called, and a per-position lookup would make
  // this quadratic in the length of the text.

  let rec _walk = fn (rest) -> fn (prev: int) -> fn (ri: int) -> fn (pict: int) ->
                  fn (incb: int) -> fn (cur_buf) -> fn (acc) ->
    match rest with
    | Nil ->
      // The cluster in hand is finished by the end of the text (GB2).
      list_rev (if prev < 0 then acc else Cons (strbuf_to_str cur_buf, acc))
    | Cons (ch, tail) ->
      let k = GcbTable.class_of (codepoint_of ch) in
      let boundary = if prev < 0 then false
                     else breaks_between prev k ri pict incb in
      let ri2 = _next_ri prev k ri in
      let pict2 = _next_pict k pict in
      let incb2 = _next_incb k incb in
      if boundary then
        let finished = strbuf_to_str cur_buf in
        let fresh = strbuf_new () in
        let _ = strbuf_push fresh ch in
        _walk tail k ri2 pict2 incb2 fresh (Cons (finished, acc))
      else
        let _ = strbuf_push cur_buf ch in
        _walk tail k ri2 pict2 incb2 cur_buf acc;

  let clusters = fn (s: str) ->
    _walk (utf8_chars s) (0 - 1) 0 0 0 (strbuf_new ()) Nil;

  let count = fn (s: str) -> list_len (clusters s);

  // The class of a code point, for callers that want the property rather than
  // the segmentation — a line breaker will want it too.
  let class_of = fn (cp: int) -> GcbTable.class_of cp;

}
