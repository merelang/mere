// contrib/unicode/gcb_table.mere — GENERATED. Do not edit.
//
// Written by scripts/gen_unicode_tables.sh from the UCD. Run it to regenerate.
//
// Unicode 17.0, pinned to what node's ICU implements,
// because node's Intl.Segmenter is the oracle this is checked against and a
// table of a different vintage would differ from it for reasons that are
// neither a bug nor interesting.
//
// Three UCD properties folded into one class per code point:
//   Grapheme_Cluster_Break   auxiliary/GraphemeBreakProperty.txt
//   Extended_Pictographic    emoji/emoji-data.txt        (rule GB11)
//   InCB                     DerivedCoreProperties.txt   (rule GB9c)
//
// The folding is sound because every Extended_Pictographic code point has
// Grapheme_Cluster_Break=Other, InCB=Consonant is disjoint from the non-Other
// breaks, and InCB=Linker/Extend live inside Extend or ZWJ. The generator
// asserts all three rather than trusting them.
//
// 1631 ranges. Fourteen characters each: six for the start, six for
// the end, two for the class. Other is the default and is not stored, which is
// most of the code space. A lookup is a binary search over a fixed-width
// hexadecimal literal — the shape settled in scripts/gen_jis_index.sh, for the
// same reason: a str is strlen-based on the LLVM backend, so the table has to
// be NUL-free.
//
// Code points per class:
//   CR                  1
//   LF                  1
//   Control             3893
//   Extend              1
//   ZWJ                 1
//   Regional_Indicator  26
//   Prepend             27
//   SpacingMark         381
//   L                   125
//   V                   100
//   T                   137
//   LV                  399
//   LVT                 10773
//   ExtPict             2848
//   Linker              20
//   ExtendInCB          2216
//   Consonant           911

module GcbTable {

  let other = 0;
  let cr = 1;
  let lf = 2;
  let control = 3;
  let extend = 4;
  let zwj = 5;
  let regional_indicator = 6;
  let prepend = 7;
  let spacingmark = 8;
  let l = 9;
  let v = 10;
  let t = 11;
  let lv = 12;
  let lvt = 13;
  let extpict = 14;
  let linker = 15;
  let extendincb = 16;
  let consonant = 17;

  let count = 1631;

  let _t = "";

  let _hexval = fn (b: int) -> if b >= 48 && b <= 57 then b - 48 else b - 55;

  let rec _read = fn (i: int) -> fn (w: int) -> fn (acc: int) ->
    if w <= 0 then acc
    else _read (i + 1) (w - 1) (acc * 16 + _hexval (ord (char_at _t i)));

  let _start_at = fn (k: int) -> _read (k * 14) 6 0;
  let _end_at = fn (k: int) -> _read (k * 14 + 6) 6 0;
  let _class_at = fn (k: int) -> _read (k * 14 + 12) 2 0;

  // Binary search. `other` for anything no range covers, which is most of it.
  let rec _find = fn (cp: int) -> fn (lo: int) -> fn (hi: int) ->
    if lo > hi then other
    else
      let mid = (lo + hi) / 2 in
      if cp < _start_at mid then _find cp lo (mid - 1)
      else if cp > _end_at mid then _find cp (mid + 1) hi
      else _class_at mid;

  let class_of = fn (cp: int) -> _find cp 0 (count - 1);

}
