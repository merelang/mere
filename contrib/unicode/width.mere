// contrib/unicode/width.mere — how many columns text occupies on a terminal.
//
// The question a full-screen terminal program has to answer before it can put
// anything anywhere: the cursor moves by columns, and a Japanese character is
// two of them. Get this wrong and every line after the first multi-byte
// character is drawn in the wrong place.
//
// THERE IS ALREADY A `utf8_width` IN THE PRELUDE (v0.1.45), and it needs no
// import. Use it for aligning ASCII and CJK in a table -- that is what it was
// written for and it is enough. It is fourteen hand-written ranges, which the
// stdlib reference calls "wcwidth-lite", and the difference from this table was
// measured over 17,661 code points: **2,083 disagree (11.8%)**.
//
//   1,488  this says 0, the prelude says 1  -- combining marks, format
//          characters and conjoining jamo outside its single U+0300..036F range
//          (U+200B ZERO WIDTH SPACE among them)
//     380  this says 1, the prelude says 2  -- narrow characters inside its
//          coarse CJK block
//     209  this says 2, the prelude says 1  -- wide characters and emoji
//          outside its two hardcoded emoji blocks
//
// So: reach for `utf8_width` when a column of a table has to line up. Reach for
// this when a CURSOR has to land where the glyph ends -- an editor, a pager,
// anything that draws over what it drew before -- because there the error does
// not stay in one cell. This one is generated from the UCD, checked against a
// second implementation, explicit about the ambiguous set, and sums over
// grapheme clusters rather than code points.
//
//   import "contrib/unicode/width.mere";
//
//   Width.of_str "日本語"                            // 6
//   Width.of_str "hello"                            // 5
//   Width.of_str ("cafe" ++ chr 204 ++ chr 129)     // 4 -- a combining
//                                                  //   acute adds no column
//   Width.take_cols "日本語abc" 5                    // 6 bytes: 日本 fits
//
// THE AMBIGUOUS SET is why this has two of everything. EastAsianWidth=A covers
// ±, §, ※, the box-drawing characters and much of Greek and Cyrillic, and the
// standard deliberately does not say how wide they are: one column in a
// Western terminal, two in a terminal configured for CJK. So `of_str` takes the
// caller's answer, and `of_str_narrow` / `of_str_wide` are the two you get by
// having already decided. A library that picked silently would be wrong half
// the time and never say so.
//
// CLUSTERS, and that took making them affordable first. A cluster is what a
// reader calls a character and what a cursor moves by, so it is the unit a width
// has to be summed over: 👩‍👩‍👦 is one cluster two columns wide, not six code
// points of one and two. But Grapheme.clusters used to allocate a StrBuf per
// cluster into the program-lifetime region -- about 60 KB a frame for a renderer
// calling it once per visible line per keystroke, 127.8 MB over 2,000 frames --
// so this file walked code points instead and said so. Building each cluster as
// a `str` rather than a StrBuf made the same run 1.6 MB and flat (and faster),
// and the reason to avoid clusters went away with it.
//
// `of_cp` is still the per-code-point answer, because that is what a table
// comparison wants and what `scripts/width_check.sh` asks. The string-level
// functions below sum over clusters, taking each cluster's width from its BASE
// character -- the marks, joiners and continuations that follow add none.

import "width_table.mere";
import "grapheme.mere";

module Width {

  // Resolve the table's four answers into a column count. `amb` is what the
  // caller says an ambiguous-width character is worth: 1 or 2.
  let of_cp_amb = fn (amb: int) -> fn (cp: int) ->
    let k = WidthTable.class_of cp in
    if k == WidthTable.w_ambiguous then amb else k;

  // The common case. Ambiguous is one column, which is what a terminal that
  // has not been told otherwise does.
  let of_cp = fn (cp: int) -> of_cp_amb 1 cp;

  let is_ambiguous = fn (cp: int) ->
    WidthTable.class_of cp == WidthTable.w_ambiguous;

  // A cluster is as wide as its BASE character. Everything after the base in a
  // cluster is a mark, a joiner or a continuation, and none of those advance the
  // cursor -- which is what makes "e" + U+0301 one column and 👩‍👩‍👦 two.
  let width_of_cluster_amb = fn (amb: int) -> fn (c: str) ->
    match utf8_chars c with
    | Nil -> 0
    | Cons (base, _) -> of_cp_amb amb (codepoint_of base);

  let width_of_cluster = fn (c: str) -> width_of_cluster_amb 1 c;

  let rec _sum = fn (amb: int) -> fn (cs: str list) -> fn (acc: int) ->
    match cs with
    | Nil -> acc
    | Cons (c, rest) -> _sum amb rest (acc + width_of_cluster_amb amb c);

  let of_str_amb = fn (amb: int) -> fn (s: str) -> _sum amb (Grapheme.clusters s) 0;

  let of_str = fn (s: str) -> of_str_amb 1 s;
  let of_str_narrow = fn (s: str) -> of_str_amb 1 s;
  let of_str_wide = fn (s: str) -> of_str_amb 2 s;

  // How many BYTES of `s` fit in `cols` columns. Bytes rather than characters,
  // because the caller is about to `substring` with it.
  //
  // A character that would straddle the right edge is left out entirely: half
  // of a wide character is not a thing a terminal can draw, and a renderer that
  // emits it corrupts every line below. The caller pads the gap.
  let rec _take = fn (amb: int) -> fn (cs: str list) -> fn (left: int) -> fn (acc: int) ->
    match cs with
    | Nil -> acc
    | Cons (c, rest) ->
      let w = width_of_cluster_amb amb c in
      if w > left then acc
      else _take amb rest (left - w) (acc + str_len c);

  let take_cols_amb = fn (amb: int) -> fn (s: str) -> fn (cols: int) ->
    if cols <= 0 then 0 else _take amb (Grapheme.clusters s) cols 0;

  let take_cols = fn (s: str) -> fn (cols: int) -> take_cols_amb 1 s cols;

  // The inverse: how many columns precede byte offset `upto` in `s`. This is
  // what turns a cursor's byte position into a screen column.
  let rec _cols_before = fn (amb: int) -> fn (cs: str list) -> fn (left: int) -> fn (acc: int) ->
    if left <= 0 then acc
    else
      match cs with
      | Nil -> acc
      | Cons (c, rest) ->
        let n = str_len c in
        if n > left then acc
        else _cols_before amb rest (left - n) (acc + width_of_cluster_amb amb c);

  let cols_before_amb = fn (amb: int) -> fn (s: str) -> fn (upto: int) ->
    if upto <= 0 then 0 else _cols_before amb (Grapheme.clusters s) upto 0;

  let cols_before = fn (s: str) -> fn (upto: int) -> cols_before_amb 1 s upto;
}
