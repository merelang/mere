// contrib/unicode/width_table.mere — GENERATED. Do not edit.
//
// Written by scripts/gen_width_table.sh from the UCD. Run it to regenerate.
//
// Unicode 17.0, pinned to node's, the same way the
// line-break and grapheme tables are.
//
// How many columns a code point occupies on a terminal:
//   0  combining marks, format characters, conjoining jamo, controls
//   1  the default, and therefore not stored
//   2  East Asian Wide and Fullwidth, and emoji presentation
//   3  AMBIGUOUS — EastAsianWidth=A, which the standard declines to decide.
//      One column on a Western terminal and two on an East Asian one. The
//      table reports the ambiguity rather than guessing; Width.of_cp resolves
//      it with the caller's preference.
//
// This is NOT derivable from lb_table's `flag_eastasian`, which sets one bit
// for F, W and H together -- H is halfwidth katakana, East Asian and one
// column wide. UAX #14 only ever asks "is this East Asian?"; a width needs
// the distinction that question throws away.
//
// 678 ranges, thirteen characters each: six start, six end, one
// width. Width 1 is the unstored default. Binary searched over a fixed-width
// hexadecimal literal — NUL-free, because a str is strlen-based on the LLVM
// backend.
//
// Code points per width:
//   0   2466
//   1   790381  (default, unstored)
//   2   182895
//   amb 138370

module WidthTable {

  // The fourth answer is a separate value, not a width: a caller that treats
  // it as a number gets 3 columns and will notice, which is better than
  // silently getting 1 where the terminal uses 2.
  let w_zero = 0;
  let w_one = 1;
  let w_two = 2;
  let w_ambiguous = 3;

  let count = 678;
  let _default = 1;

  let _t = "";

  let _hexval = fn (b: int) -> if b >= 48 && b <= 57 then b - 48 else b - 55;

  let rec _read = fn (i: int) -> fn (w: int) -> fn (acc: int) ->
    if w <= 0 then acc
    else _read (i + 1) (w - 1) (acc * 16 + _hexval (ord (char_at _t i)));

  let _start_at = fn (k: int) -> _read (k * 13) 6 0;
  let _end_at = fn (k: int) -> _read (k * 13 + 6) 6 0;
  let _w_at = fn (k: int) -> _read (k * 13 + 12) 1 0;

  let rec _find = fn (cp: int) -> fn (lo: int) -> fn (hi: int) ->
    if lo > hi then _default
    else
      let mid = (lo + hi) / 2 in
      if cp < _start_at mid then _find cp lo (mid - 1)
      else if cp > _end_at mid then _find cp (mid + 1) hi
      else _w_at mid;

  // The raw answer, ambiguity included. `Width.of_cp` is the one to call.
  let class_of = fn (cp: int) -> _find cp 0 (count - 1);

}
