  let _start_at = fn (k: int) -> _read (k * 15) 6 0;
  let _end_at = fn (k: int) -> _read (k * 15 + 6) 6 0;
  let _key_at = fn (k: int) -> _read (k * 15 + 12) 3 0;

  let rec _find = fn (cp: int) -> fn (lo: int) -> fn (hi: int) ->
    if lo > hi then _default
    else
