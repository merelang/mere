// contrib/unicode/nfc_table.mere — GENERATED. Do not edit.
//
// Written by scripts/gen_normalize_tables.sh from the UCD. Run it to regenerate.
//
// Unicode 17.0, pinned to node's, because node's
// String.prototype.normalize is one of the two gates and the UCD's
// NormalizationTest.txt is the other.
//
// Three tables. The third is DERIVED, and it is where normalization goes
// wrong, because a decomposition is not automatically a composition:
//
//   ccc           403 ranges (968 code points, max 240)
//   decomposition 2081 canonical mappings, stored pairwise
//   composition   961 primary composites
//
// Excluded from the inverse, counted rather than assumed:
//   singletons                  1035
//   non-starter decompositions  4
//   script-specific exclusions  81
//   compatibility decompositions 3833 (never canonical; NFD ignores them)
//
// Hangul is in none of these: its composition and decomposition are
// arithmetic on the code point, which the implementation does directly and
// which keeps 11,172 entries out of the tables.
//
// Eighteen characters per decomposition or composition row, fourteen per ccc
// range. Fixed width, binary searched, NUL-free because a str is
// strlen-based on the LLVM backend.

module NfcTable {

  let ccc_count = 403;
  let decomp_count = 2081;
  let comp_count = 961;

  let _ccc = "";

  let _decomp = "";

  let _comp = "";

  let _hexval = fn (b: int) -> if b >= 48 && b <= 57 then b - 48 else b - 55;

  let rec _read = fn (t: str) -> fn (i: int) -> fn (w: int) -> fn (acc: int) ->
    if w <= 0 then acc
    else _read t (i + 1) (w - 1) (acc * 16 + _hexval (ord (char_at t i)));

  // --- ccc: ranges ------------------------------------------------------

  let rec _find_ccc = fn (cp: int) -> fn (lo: int) -> fn (hi: int) ->
    if lo > hi then 0
    else
      let mid = (lo + hi) / 2 in
      let s = _read _ccc (mid * 14) 6 0 in
      let e = _read _ccc (mid * 14 + 6) 6 0 in
      if cp < s then _find_ccc cp lo (mid - 1)
      else if cp > e then _find_ccc cp (mid + 1) hi
      else _read _ccc (mid * 14 + 12) 2 0;

  let ccc_of = fn (cp: int) -> _find_ccc cp 0 (ccc_count - 1);

  // --- canonical decomposition: cp -> one or two code points -------------
  // `0` in the second slot means the mapping is a singleton.

  let rec _find_decomp = fn (cp: int) -> fn (lo: int) -> fn (hi: int) ->
    if lo > hi then 0 - 1
    else
      let mid = (lo + hi) / 2 in
      let k = _read _decomp (mid * 18) 6 0 in
      if cp < k then _find_decomp cp lo (mid - 1)
      else if cp > k then _find_decomp cp (mid + 1) hi
      else mid;

  // -1 when the code point has no canonical mapping.
  let decomp_row = fn (cp: int) -> _find_decomp cp 0 (decomp_count - 1);
  let decomp_first = fn (row: int) -> _read _decomp (row * 18 + 6) 6 0;
  let decomp_second = fn (row: int) -> _read _decomp (row * 18 + 12) 6 0;

  // --- primary composites: (first, second) -> composite -------------------
  // Sorted by first then second, so one binary search answers both.

  let rec _find_comp = fn (a: int) -> fn (b: int) -> fn (lo: int) ->
                       fn (hi: int) ->
    if lo > hi then 0 - 1
    else
      let mid = (lo + hi) / 2 in
      let fa = _read _comp (mid * 18) 6 0 in
      let fb = _read _comp (mid * 18 + 6) 6 0 in
      if a < fa || (a == fa && b < fb) then _find_comp a b lo (mid - 1)
      else if a > fa || (a == fa && b > fb) then _find_comp a b (mid + 1) hi
      else _read _comp (mid * 18 + 12) 6 0;

  // -1 when the pair does not compose.
  let compose_pair = fn (a: int) -> fn (b: int) ->
    _find_comp a b 0 (comp_count - 1);

}
