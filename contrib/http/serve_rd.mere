// contrib/http/serve_rd.mere -- readiness for the I/O, workers for the handlers.
//
// WHY BOTH. The two server shapes this project already had each fix what the
// other cannot, and neither is enough alone:
//
//   http_serve      one at a time. A slow handler stops everything.
//   http_serve_mt   a worker per connection. A slow HANDLER is fine; a slow
//                   CLIENT is not -- it holds a worker while it dribbles, and
//                   opening a socket and saying nothing is free for an attacker.
//   a readiness     a slow CLIENT is one Map entry; a slow HANDLER stops the
//   loop alone      whole loop, and a 680 ms password hash is a slow handler.
//
// So: the loop does the I/O, and a handler runs on a worker. A client that
// dribbles costs an entry in a map. A handler that takes half a second costs
// one of N workers. Q-081 upstream is the note that said keep-alive could not
// be added to the worker pool because an idle connection would hold a worker;
// under this loop an idle connection holds nothing.
//
// THE CAPABILITY IS NOT NEW -- the ADOPTION is. `io_poll_*` and
// `io_set_nonblocking` landed in v0.1.313 with a dogfood (mpoll: "one thread,
// many connections") whose own header says "every server in this language so
// far either blocked or spawned". contrib/http, the module every web program
// here actually imports, then went on offering exactly those two shapes. This
// file is mpoll's loop where the web programs can reach it.
//
// A CONNECTION HAS NO STACK, so its progress is a value: how many bytes have
// arrived, in a Map the loop thread alone touches. mpoll found that framing.
//
// BOTH DIRECTIONS GO THROUGH THE LOOP (v0.1.342). The worker tries to write the
// response and, if the socket will not take all of it, hands the remainder back
// -- fd, offset, bytes left -- and takes the next request. A client that sends a
// request and then refuses to read the answer costs a map entry, the same as one
// that dribbles the request. The first version of this file wrote blocking in
// the worker and said so; that was half the property.
//
// THE LOOP HAS TO NOTICE A WORKER FINISHING, and it is asleep in poll(). So it
// polls with a 5 ms timeout WHILE ANY REQUEST IS IN FLIGHT and blocks
// indefinitely when none is: an idle server wakes up never, a busy one wakes up
// two hundred times a second on a handful of descriptors. The alternative is a
// self-pipe, which needs a primitive this language does not have.
//
// THE RESPONSE REUSES THE REQUEST'S SLOT. By the time the handler returns, the
// request has been copied out of it (mem_to_str allocates), so the bytes are
// free. One slot array rather than two, and the response ceiling is the slot.
// A response that does not fit is a 500 with a line on stderr -- truncating it
// would send a well-formed reply that is not the answer.

import "serve_mt.mere";

extern fn io_poll_new: int -> int;
extern fn io_poll_add: int -> int -> int -> int;
extern fn io_poll_del: int -> int -> int;
extern fn io_poll_wait: int -> int -> int;
extern fn io_poll_get: int -> int -> int;
extern fn io_set_nonblocking: int -> int;

// One read slot per fd, indexed BY the fd: the OS reuses closed descriptors, so
// slot reuse follows fd reuse for free -- and the arena has no free, so anything
// allocated per connection would leak per connection. mpoll's rule.
// THE ARENA IS 16 MB AND HAS NO FREE, so these two multiply into a budget
// rather than being free choices: connections x slot must leave room for
// everything else the program allocates. 64 x 128 KB = 8 MB.
//
// The slot is also the RESPONSE ceiling, because the response is written back
// into it. 32 KB was the first guess and it is too small for a web application:
// a JSON list of rows passes it easily. `http_send_file` is unaffected -- it
// writes to the descriptor directly and never enters this buffer, so static
// assets of any size are fine.
// CONFIGURABLE, because the right answer is a deployment decision and because a
// property that only appears at one size cannot be checked at another: the
// partial-write path below is unreachable while a whole response fits in the
// socket buffer, which 128 KB does on loopback. At 1 MB it is not, and the
// difference is stark -- a single write against a nonblocking descriptor
// delivered 3.2 MB of wrongness for a 896 KB response, because it wrote once
// and ignored what it did not send.
let rd_env_int = fn (name: str) -> fn (d: int) ->
  match env_var name with
  | Some v -> if str_len v > 0 then int_of_str v else d
  | None -> d;

let rd_max_fd = rd_env_int "MERE_HTTP_MAX_CONN" 64;
let rd_slot = rd_env_int "MERE_HTTP_SLOT" 131072;

// A request bigger than a slot is refused rather than truncated. Truncating
// would hand the handler a request that parses and is not what was sent.
let rd_413 =
  "HTTP/1.1 413 Payload Too Large\r\nContent-Length: 0\r\nConnection: close\r\n\r\n";

// Is the request in this slot complete? Returns the total needed, or -1.
let rd_complete = fn (base: int) -> fn (got: int) -> fn (pat: int) -> fn (patn: int) ->
  let he = mt_find_head_end base 0 got in
  if he < 0 then 0 - 1
  else
    let clpos = mt_find_ci base 0 he pat patn in
    let want = if clpos < 0 then 0 else mt_digits base (mt_skip_sp base clpos he) he 0 in
    if got >= he + want then he + want else 0 - 1;

// ---- the worker: handler, response, close ------------------------------
// Write what the socket will take, starting at base+off. Returns how many bytes
// are still unwritten (0 = done). A -1 from tcp_write is "would block", which is
// not an error and not progress.
let rec rd_push = fn (fd: int) -> fn (base: int) -> fn (off: int) -> fn (rem: int) ->
  if rem <= 0 then 0
  else
    let n = tcp_write fd (base + off) rem in
    if n <= 0 then rem
    else rd_push fd base (off + n) (rem - n);

// Returns (fd, off, rem). rem = 0 means the worker finished and closed it.
let rd_worker_one = fn (fd: int) -> fn (base: int) -> fn (total: int) -> fn (ctx: int) -> fn (h) ->
  let he = mt_find_head_end base 0 total in
  let head = mem_to_str base he in
  let body = mem_to_str (base + he) (total - he) in
  let reqline = mem_to_str base (mt_reqline_end base 0 he 0) in
  let _ = http_begin_request fd head body in
  let out = h ctx reqline in
  if http_response_sent () != 0 then
    // http_send_file / the streaming API already wrote it, straight to the fd.
    // Those still block in the worker; they bypass this path entirely.
    let _ = http_end_request () in
    let _ = tcp_close fd in
    (fd, 0, 0)
  else
    let resp = http_response_head (str_len out) ++ out in
    let len = str_len resp in
    if len > rd_slot then
      let _ = print_err ("http: response of " ++ str_of_int len
                         ++ " bytes exceeds the " ++ str_of_int rd_slot
                         ++ " byte slot; sending 500 instead of a truncated body") in
      let n = mem_copy_str base 0
                ("HTTP/1.1 500 Internal Server Error\r\nContent-Length: 0\r\nConnection: close\r\n\r\n") in
      let left = rd_push fd base 0 n in
      let _ = http_end_request () in
      let _ = if left <= 0 then tcp_close fd else () in
      (fd, n - left, left)
    else
      let n = mem_copy_str base 0 resp in
      let left = rd_push fd base 0 n in
      let _ = http_end_request () in
      let _ = if left <= 0 then tcp_close fd else () in
      (fd, n - left, left);

let rec rd_worker = fn (ch) -> fn (back) -> fn (slots: int) -> fn (ctx: int) -> fn (h) ->
  match channel_recv_opt ch with
  | None -> ()
  // (fd, total). The bytes are already in this fd's slot; the loop stopped
  // watching the fd before sending, so the worker owns both until it either
  // closes the fd or hands the leftover back.
  | Some (fd, total) ->
    let r = rd_worker_one fd (slots + fd * rd_slot) total ctx h in
    // ALWAYS reported, even when finished, because the loop counts requests in
    // flight to decide whether it may sleep indefinitely.
    let _ = channel_send back r in
    rd_worker ch back slots ctx h;

let rec rd_start = fn (ch) -> fn (back) -> fn (slots: int) -> fn (k: int) -> fn (n: int) -> fn (mk) -> fn (h) ->
  if k >= n then ()
  else
    let ctx = mk k in
    let _ = spawn (fn () -> rd_worker ch back slots ctx h) in
    rd_start ch back slots (k + 1) n mk h;

// ---- the loop ----------------------------------------------------------
let http_serve_rd_ctx = fn (port: int) -> fn (workers: int) -> fn (mk) -> fn (h) ->
  let srv = tcp_listen port in
  if srv < 0 then
    print_err ("http_serve_rd: could not listen on " ++ str_of_int port)
  else
    let ps = io_poll_new rd_max_fd in
    let slots = mem_alloc (rd_max_fd * rd_slot) in
    let pat = mem_alloc 32 in
    let patn = mem_copy_str pat 0 "content-length:" in
    let ch = channel_new () in
    // Workers report back on this one. Loop-owned state stays in the loop's
    // own maps; nothing but these two channels crosses a thread boundary.
    let back = channel_new () in
    let conns = map_new () in
    let woff = map_new () in
    let wrem = map_new () in
    let inflight = map_new () in
    let _ = map_set inflight 0 0 in
    let _ = rd_start ch back slots 0 workers mk h in
    let _ = io_set_nonblocking srv in
    let _ = io_poll_add ps srv 1 in
    let _ = print ("http_serve_rd: listening on :" ++ str_of_int port
                   ++ " with " ++ str_of_int workers ++ " workers"
                   ++ " (readiness I/O, up to " ++ str_of_int rd_max_fd ++ " connections)") in

    let close_conn = fn (fd: int) ->
      let _ = io_poll_del ps fd in
      let _ = map_delete conns fd in
      tcp_close fd in

    let rec accept_all = fn (u: unit) ->
      let c = tcp_accept srv in
      if c < 0 then ()                      // -1: nobody else waiting
      else if c >= rd_max_fd then
        // Beyond the slot table. Refused rather than served without a slot.
        let _ = tcp_close c in accept_all ()
      else
        let _ = io_set_nonblocking c in
        let _ = io_poll_add ps c 1 in
        let _ = map_set conns c 0 in
        accept_all () in

    let on_readable = fn (fd: int) -> fn (got: int) ->
      let base = slots + fd * rd_slot in
      let n = tcp_read fd (base + got) (rd_slot - got) in
      if n == 0 then close_conn fd                // clean end of stream
      else if n < 0 then
        // -1 is "would block", which is not an error: the event was spurious
        // or the peer paused. Anything else is a dead connection.
        (if n == (0 - 1) then () else close_conn fd)
      else
        let g = got + n in
        let total = rd_complete base g pat patn in
        if total >= 0 then
          // Complete. Stop watching it and hand fd + byte count to a worker;
          // from here the worker owns the fd, the slot, and the close.
          let _ = io_poll_del ps fd in
          let _ = map_delete conns fd in
          let _ = map_set inflight 0 (map_get inflight 0 + 1) in
          channel_send ch (fd, total)
        else if g >= rd_slot then
          let wb = mem_alloc 128 in
          let k = mem_copy_str wb 0 rd_413 in
          let _ = tcp_write fd wb k in
          close_conn fd
        else map_set conns fd g in

    // A worker's answer arrives on a channel, not on a descriptor, so the loop
    // cannot wait for it in poll(). While anything is in flight it wakes every
    // 5 ms to look; with nothing in flight it blocks, so an idle server costs
    // nothing. A self-pipe would be the usual answer and needs a primitive this
    // language does not have.
    let rec drain_back = fn (u: unit) ->
      match channel_recv_timeout back 0 with
      | None -> ()
      | Some (fd, off, rem) ->
        let _ = map_set inflight 0 (map_get inflight 0 - 1) in
        let _ =
          if rem <= 0 then ()          // the worker finished and closed it
          else
            // Not all of the response fit. Take the fd back and finish it here.
            let _ = map_set woff fd off in
            let _ = map_set wrem fd rem in
            let _ = io_poll_add ps fd 2 in
            () in
        drain_back () in

    let on_writable = fn (fd: int) ->
      let base = slots + fd * rd_slot in
      let left = rd_push fd base (map_get woff fd) (map_get wrem fd) in
      if left <= 0 then
        let _ = io_poll_del ps fd in
        let _ = map_delete woff fd in
        let _ = map_delete wrem fd in
        tcp_close fd
      else
        let _ = map_set woff fd (map_get woff fd + (map_get wrem fd - left)) in
        map_set wrem fd left in

    let wclose = fn (fd: int) ->
      let _ = io_poll_del ps fd in
      let _ = map_delete woff fd in
      let _ = map_delete wrem fd in
      tcp_close fd in

    let rec loop = fn (u: unit) ->
      let n = io_poll_wait ps (if map_get inflight 0 > 0 then 5 else 0 - 1) in
      let rec each = fn (i: int) ->
        if i >= n then ()
        else
          let ev = io_poll_get ps i in
          let fd = ev / 8 in
          let bits = ev % 8 in
          let _ =
            if fd == srv then accept_all ()
            else if map_has wrem fd then
              (if bits / 4 % 2 == 1 then wclose fd
               else if bits / 2 % 2 == 1 then on_writable fd
               else ())
            // A connection already handed to a worker can still have an event
            // queued behind it: consult the map, not the event.
            else if map_has conns fd == false then ()
            else if bits / 4 % 2 == 1 then close_conn fd        // hangup
            else if bits % 2 == 1 then on_readable fd (map_get conns fd)
            else () in
          each (i + 1) in
      let _ = each 0 in
      let _ = drain_back () in
      loop () in
    loop ();

let rd_no_ctx = fn (i: int) -> 0;

// `http_serve_rd port workers handler` -- handler is `str -> str`.
let http_serve_rd = fn (port: int) -> fn (workers: int) -> fn (h) ->
  http_serve_rd_ctx port workers rd_no_ctx (fn (c: int) -> fn (req: str) -> h req);
