// contrib/db/live.mere — which reads a write affects, derived from the SQL.
//
// contrib/state/store.mere solved this for client state by being COARSE: any
// write re-runs every watcher. That is always correct and never minimal, and
// it does not reach the server side at all -- a read from Postgres is one
// shot, and nothing in contrib/db has a notion of a read that stays true.
//
// The pieces to push an update already exist (pg's LISTEN/NOTIFY, and
// contrib/http/sse). What was missing is the DERIVATION between them: given a
// write, which registered reads stop being true?
//
// This module is that derivation and nothing else. It takes SQL text, not a
// hand-written list of tables, because a hand-written list is an annotation --
// and an annotation that is wrong returns stale data silently, which is the
// failure the whole idea exists to remove.
//
// SCOPE, said plainly. Table granularity: a write to `posts` affects every
// registered read of `posts`, whatever the predicates say. That is coarser
// than row-level and finer than broadcast, and it is the bucket that a survey
// of one real application (74 reads, 48 tables) put at 54% of reads -- the
// rest were aggregates, windows, and reads whose result changes with the clock
// and no write at all. Those are NOT handled here and must not be registered:
// `derivable` answers whether a read is one this module can speak about.

let _kw = fn (w: str) ->
  str_eq w "SELECT" || str_eq w "FROM" || str_eq w "WHERE" || str_eq w "JOIN"
  || str_eq w "LEFT" || str_eq w "RIGHT" || str_eq w "INNER" || str_eq w "OUTER"
  || str_eq w "ON" || str_eq w "AND" || str_eq w "OR" || str_eq w "ORDER"
  || str_eq w "GROUP" || str_eq w "BY" || str_eq w "LIMIT" || str_eq w "OFFSET"
  || str_eq w "INTO" || str_eq w "SET" || str_eq w "VALUES" || str_eq w "AS"
  ;

// A table name as it appears after FROM / JOIN / INTO / UPDATE, with any
// alias, punctuation and trailing comma removed.
// Punctuation a word was written with is not part of the name. Double quotes
// included: `CREATE TABLE "c"` and `SELECT ... FROM c` name the same table, and
// keeping the quotes on one side made them different strings -- a schema
// written by a tool that quotes everything would never match a query written by
// hand. Both sides come through here, so stripping once is enough.
let _clean = fn (w: str) ->
  let w = str_replace w "," "" in
  let w = str_replace w ";" "" in
  let w = str_replace w "(" "" in
  let w = str_replace w ")" "" in
  str_replace w "\"" ""
  ;

let rec _after = fn (ws: str list) -> fn (marks: str list) -> fn (acc: str list) ->
  match ws with
  | Nil -> acc
  | Cons (w, rest) ->
    let up = to_upper w in
    if _mem up marks then
      (match rest with
       | Cons (n, more) ->
         let t = _clean n in
         if str_eq t "" || _kw (to_upper t) then _after rest marks acc
         else _after more marks (Cons (to_lower t, acc))
       | Nil -> acc)
    else _after rest marks acc
and _mem = fn (x: str) -> fn (xs: str list) ->
  match xs with
  | Nil -> false
  | Cons (y, rest) -> if str_eq x y then true else _mem x rest
  ;

let _words = fn (s: str) ->
  str_split (str_replace (str_replace s "\n" " ") "\t" " ") " "
  ;

// Tables a read touches: whatever follows FROM or JOIN.
let read_tables = fn (sql: str) -> _after (_words sql) ["FROM", "JOIN"] Nil;

// The table a write touches: INSERT INTO t / UPDATE t / DELETE FROM t.
let write_tables = fn (sql: str) ->
  _after (_words sql) ["INTO", "UPDATE", "FROM"] Nil
  ;

// A read this module can speak about. An aggregate, a window, or a predicate
// that reads the clock does not become true again because some write happened,
// so registering one would promise a freshness this cannot deliver.
let derivable = fn (sql: str) ->
  let u = to_upper sql in
  if str_contains u "COUNT(" || str_contains u "SUM(" || str_contains u "AVG("
     || str_contains u "MIN(" || str_contains u "MAX(" || str_contains u "GROUP BY"
     || str_contains u "DISTINCT" then false
  else if str_contains u "LIMIT" || str_contains u "OFFSET" then false
  else if str_contains u "NOW()" || str_contains u "CURRENT_DATE"
       || str_contains u "CURRENT_TIMESTAMP" || str_contains u "INTERVAL " then false
  else true
  ;

let rec _overlap = fn (a: str list) -> fn (b: str list) ->
  match a with
  | Nil -> false
  | Cons (x, rest) -> if _mem x b then true else _overlap rest b
  ;

// Does this write stop this read from being true?
let affects = fn (write_sql: str) -> fn (read_sql: str) ->
  _overlap (write_tables write_sql) (read_tables read_sql)
  ;

// ---- the registry ---------------------------------------------------------
//
// contrib/http/sse pushes to a named channel. A live read therefore needs a
// name, and something has to hold the read that the name stands for -- so that
// a write can be turned into "these channels are now stale" without the write
// site knowing what anybody is watching. That is this registry, and it is the
// piece between the derivation above and the transport below it.
//
// Entries are "<channel>\t<sql>" in one vec: a vec of tuples would need a
// region parameter here, the same reason contrib/state/store keeps three cells
// instead of a record.
//
//   live_new      : unit -> Live
//   live_register : Live -> str -> str -> bool   channel, read sql; false if
//                                                the read is not derivable
//   live_channels : Live -> str -> str list      write sql -> stale channels
//   live_size     : Live -> int

let live_new = fn () -> vec_new ();

let live_register = fn (reg) -> fn (channel: str) -> fn (read_sql: str) ->
  if derivable read_sql then let _ = vec_push reg (channel ++ "\t" ++ read_sql) in true
  else false
  ;

let live_size = fn (reg) -> vec_len reg;

let rec _scan = fn (reg) -> fn (i: int) -> fn (write_sql: str) -> fn (acc: str list) ->
  if i >= vec_len reg then acc
  else
    let entry = vec_get reg i in
    let tab = str_index_of entry "\t" in
    let channel = substring entry 0 tab in
    let sql = substring entry (tab + 1) (str_len entry) in
    if affects write_sql sql then _scan reg (i + 1) write_sql (Cons (channel, acc))
    else _scan reg (i + 1) write_sql acc
  ;

// The channels a write makes stale. A read that was refused at registration
// is not here, so it can never be told it is stale -- which is the honest
// answer for a read whose freshness no write determines.
let live_channels = fn (reg) -> fn (write_sql: str) -> _scan reg 0 write_sql Nil;



// ---- cascades ------------------------------------------------------------
//
// FOUND BY THE SOUNDNESS GATE, NOT BY READING THIS FILE. `affects` reads the
// statement, and a statement does not say everything a write does: with
//
//   comments.post_id integer REFERENCES posts(id) ON DELETE CASCADE
//
// `DELETE FROM posts WHERE id = 1` also deletes rows from `comments`, so a
// read of `comments` went stale and the derivation said no. That is the exact
// failure this module exists to prevent, and it survived 37 in-process cases
// and an end-to-end socket test because both only ever asked the derivation
// what it thought -- the database was the first thing to disagree.
//
// The fix is not an annotation. A cascade is written down in the schema, in
// SQL, so it is derived from there like everything else: give `cascades_of`
// the DDL and it returns the (parent, child) pairs, and `affects_via` widens a
// write's reach by them.
//
//   cascades_of : str -> (str * str) list     DDL -> (parent, child)
//   affects_via : (str * str) list -> str -> str -> bool

let rec _skip_noise = fn (ws: str list) ->
  match ws with
  | Nil -> Nil
  | Cons (w, rest) ->
    let u = to_upper (_clean w) in
    if str_eq u "IF" || str_eq u "NOT" || str_eq u "EXISTS" || str_eq u "ONLY"
    then _skip_noise rest else ws
  ;

let rec _cascade_scan = fn (ws: str list) -> fn (child: str) -> fn (acc: (str * str) list) ->
  match ws with
  | Nil -> acc
  | Cons (w, rest) ->
    let up = to_upper w in
    if str_eq up "TABLE" then
      // NOT SIMPLY THE NEXT WORD. `CREATE TABLE IF NOT EXISTS c (...)` made the
      // child `if`, so a pair was recorded between the parent and a table that
      // does not exist and the real child was never widened -- `affects_via`
      // answered false for a DELETE that empties it. Unsound, and the spelling
      // is in this project's own migrate.mere.
      //
      // `ONLY` is here for the same reason: ALTER TABLE ONLY c ADD CONSTRAINT
      // is what pg_dump writes.
      (match _skip_noise rest with
       | Cons (n, more) -> _cascade_scan more (to_lower (_clean n)) acc
       | Nil -> acc)
    else if str_eq up "REFERENCES" then
      (match rest with
       | Cons (p, more) ->
         // a pair is recorded when the action CHANGES the child's rows -- see
         // _changes_child_rows; RESTRICT and NO ACTION refuse the write instead
         let parent = to_lower (_clean (_paren_head p)) in
         if _changes_child_rows more 0 then _cascade_scan more child (Cons ((parent, child), acc))
         else _cascade_scan more child acc
       | Nil -> acc)
    else _cascade_scan rest child acc
and _paren_head = fn (s: str) ->
  let i = str_index_of s "(" in
  if i < 0 then s else substring s 0 i
and _ends_clause = fn (w: str) ->
  // A column definition ends at the `,` before the next one or the `)` closing
  // the table. The words carry the punctuation they were written with, so this
  // asks the raw word rather than the cleaned one.
  str_contains w "," || str_contains w ")"
and _changes_child_rows = fn (ws: str list) -> fn (n: int) ->
  // WHAT COUNTS IS WHETHER THE CHILD'S ROWS CHANGE, not whether they are
  // removed. The previous version scanned three words for CASCADE under the
  // note "RESTRICT / SET NULL do not remove rows" -- true, and the wrong
  // conclusion. Asked of Postgres, with one row in the child and the parent
  // deleted:
  //
  //   ON DELETE CASCADE       1:1  ->  (empty)     the read changed
  //   ON DELETE SET NULL      1:1  ->  1:null      the read changed
  //   ON DELETE SET DEFAULT   1:1  ->  1:9         the read changed
  //   ON DELETE RESTRICT      the delete is refused; nothing changed
  //   ON UPDATE CASCADE       1:1  ->  1:77        on UPDATE of the parent key
  //
  // Three of the four row-changing actions were missed, and each one is an
  // unsoundness: a write changes a read and nothing says so.
  //
  // The scan runs to the end of the column definition rather than a fixed
  // three words, because `ON DELETE RESTRICT ON UPDATE CASCADE` puts CASCADE
  // sixth and a fixed window silently stops looking.
  if n > 24 then false
  else match ws with
  | Nil -> false
  | Cons (a, rest) ->
    let ua = to_upper (_clean a) in
    if str_eq ua "CASCADE" then true
    else if str_eq ua "SET" then
      (match rest with
       | Cons (b, more) ->
         let ub = to_upper (_clean b) in
         if str_eq ub "NULL" || str_eq ub "DEFAULT" then true
         else if _ends_clause a then false
         else _changes_child_rows more (n + 2)
       | Nil -> false)
    else if _ends_clause a then false
    else _changes_child_rows rest (n + 1)
  ;

let cascades_of = fn (ddl: str) -> _cascade_scan (_words ddl) "" Nil;

let rec _widen = fn (pairs: (str * str) list) -> fn (tabs: str list) -> fn (acc: str list) ->
  match pairs with
  | Nil -> acc
  | Cons ((parent, child), rest) ->
    if _mem parent tabs then _widen rest tabs (Cons (child, acc))
    else _widen rest tabs acc
  ;

let rec _append = fn (a: str list) -> fn (b: str list) ->
  match a with
  | Nil -> b
  | Cons (x, rest) -> Cons (x, _append rest b)
  ;

// A write reaches the tables it names AND every table a cascade carries it to.
let affects_via = fn (cascades: (str * str) list) -> fn (write_sql: str) -> fn (read_sql: str) ->
  let direct = write_tables write_sql in
  _overlap (_append direct (_widen cascades direct Nil)) (read_tables read_sql)
  ;

let rec _scan_via = fn (casc) -> fn (reg) -> fn (i: int) -> fn (write_sql: str) -> fn (acc: str list) ->
  if i >= vec_len reg then acc
  else
    let entry = vec_get reg i in
    let tab = str_index_of entry "\t" in
    let channel = substring entry 0 tab in
    let sql = substring entry (tab + 1) (str_len entry) in
    if affects_via casc write_sql sql then _scan_via casc reg (i + 1) write_sql (Cons (channel, acc))
    else _scan_via casc reg (i + 1) write_sql acc
  ;

// THE SAME QUESTION WITH THE FOREIGN KEYS IN IT, and a subscriber that does not
// ask it is told nothing when a cascade deletes its rows. Measured in mere-blog
// before this existed: deleting a post takes its comments with it, and a client
// subscribed to the comments channel kept a list of rows that were gone --
// because `affects` sees a statement that never names `comments`.
//
// Kept as a second function rather than a default, because the cascades have to
// come from the schema. A caller with no DDL to read would otherwise get the
// weaker answer under a name that promises the stronger one.
let live_channels_via = fn (casc) -> fn (reg) -> fn (write_sql: str) ->
  _scan_via casc reg 0 write_sql Nil;
