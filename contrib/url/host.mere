// contrib/url/host.mere — a WHATWG URL parser.
//
// Cleaning, the scheme, the authority (userinfo / host / port), and — via
// `path.mere` — the path, query and fragment. Absolute URLs only: resolving a
// reference against a base is not here yet.
//
// Why a `?url_parts` and not a `fail`: on the wasm backend `fail` sets a flag
// and returns a sentinel rather than unwinding, so a caller between the failure
// and its `try_or` still runs and can trap the module. A URL parser's whole job
// includes rejecting input, so the rejection has to be a value.
//
// Usage:
//   import "contrib/url/host.mere";
//   match Url.parse "http://EXAMPLE.com:80/a/../b" with
//   | Some u -> Url.href u                  // "http://example.com/b"
//   | None -> "invalid"
//
// The behaviours worth knowing about, because these are the kind of thing that
// turns into a security bug when an implementation guesses:
//
//   * a host that parses as a number is an IPv4 address, in any base the
//     Standard allows. `http://0x7f.1` is `127.0.0.1`. An implementation that
//     only understands dotted decimal will let that through an allowlist.
//   * a domain is lowercased, an opaque host is not. `http://EXAMPLE.com` has
//     host `example.com`; `foo://EXAMPLE.com` has host `EXAMPLE.com`.
//   * a special scheme's authority does not need two slashes, or any. `http:h`
//     is `http://h/`, and so are `http:/h` and `http:\\h`. A check that keys on
//     `"//"` being present sees a relative reference where there is a host.
//   * the path is never decoded. `%2f` stays `%2f`, so it is not a separator.
//
// Three fields are booleans rather than being folded into the strings, because
// they are separate state and the serialisation needs them: `foo://` and `foo:`
// both have host `""` but only one has an authority, and `http://h/?` has an
// empty query that still serialises its `?`.

import "percent.mere";
import "path.mere";
import "ipv6.mere";

type url_parts = {
  scheme: str,        // lowercased, no trailing colon
  username: str,
  password: str,
  host: str,          // "example.com" / "127.0.0.1" / "[::1]" / ""
  port: str,          // "" when absent or the scheme's default
  has_authority: bool,
  path: str,          // normalised and encoded, or opaque
  query: str,         // without the "?"
  has_query: bool,
  fragment: str,      // without the "#"
  has_fragment: bool,
  special: bool,
};

module Url {

  // --- special schemes ---------------------------------------------------
  // The Standard's list. `special` changes three things: backslashes count as
  // separators, the default port is elided, and a host is required.

  let is_special = fn (scheme: str) ->
    scheme == "http" || scheme == "https" || scheme == "ws"
    || scheme == "wss" || scheme == "ftp" || scheme == "file";

  let default_port = fn (scheme: str) ->
    if scheme == "http" || scheme == "ws" then "80"
    else if scheme == "https" || scheme == "wss" then "443"
    else if scheme == "ftp" then "21"
    else "";

  // --- cleaning ----------------------------------------------------------
  // Leading and trailing C0 controls and spaces are stripped; tabs, line feeds
  // and carriage returns are removed from anywhere. Both before parsing, so a
  // URL pasted out of an email is the URL it looks like.

  let rec _strip_lead = fn (s: str) -> fn (i: int) -> fn (n: int) ->
    if i >= n then ""
    else if ord (char_at s i) <= 0x20 then _strip_lead s (i + 1) n
    else substring s i n;

  let rec _strip_trail = fn (s: str) -> fn (n: int) ->
    if n <= 0 then ""
    else if ord (char_at s (n - 1)) <= 0x20 then _strip_trail s (n - 1)
    else substring s 0 n;

  let clean = fn (s: str) ->
    let a = _strip_lead s 0 (str_len s) in
    let b = _strip_trail a (str_len a) in
    str_replace (str_replace (str_replace b "\t" "") "\n" "") "\r" "";

  // --- scheme ------------------------------------------------------------
  // ALPHA *( ALPHA / DIGIT / "+" / "-" / "." ) ":"  — case-insensitive.
  // Returns the length of the scheme, or -1 when there is not one, which is
  // how a relative reference and `mailto:` tell themselves apart.

  let _is_alpha = fn (b: int) -> (b >= 65 && b <= 90) || (b >= 97 && b <= 122);
  let _is_digit = fn (b: int) -> b >= 48 && b <= 57;

  // Three places below want the LAST occurrence rather than the first: userinfo
  // ends at the last `@` so a password may contain one, the port follows the
  // last `:`, and a path's final segment starts after the last `/`. This used to
  // be a hand-written scan through char_at, which allocates a one-byte str per
  // position on the compiled backends; str_last_index_of (v0.1.302) is a memcmp
  // scan and answers the same thing.

  let rec _scheme_end = fn (s: str) -> fn (i: int) -> fn (n: int) ->
    if i >= n then 0 - 1
    else
      let b = ord (char_at s i) in
      if b == 0x3A then i
      else if _is_alpha b || _is_digit b || b == 0x2B || b == 0x2D || b == 0x2E
      then _scheme_end s (i + 1) n
      else 0 - 1;

  let scheme_len = fn (s: str) ->
    if str_len s == 0 then 0 - 1
    else if not (_is_alpha (ord (char_at s 0))) then 0 - 1
    else _scheme_end s 1 (str_len s);

  // --- IPv4, in every base the Standard allows ---------------------------
  // A part is hex with a 0x prefix, octal with a leading 0, decimal otherwise.
  // -1 for anything else, which makes the host a domain rather than an error.

  let _digit_val = fn (b: int) ->
    if b >= 48 && b <= 57 then b - 48
    else if b >= 65 && b <= 70 then b - 55
    else if b >= 97 && b <= 102 then b - 87
    else 0 - 1;

  let rec _parse_radix = fn (s: str) -> fn (i: int) -> fn (n: int) ->
                         fn (radix: int) -> fn (acc: int) ->
    if i >= n then acc
    else
      let d = _digit_val (ord (char_at s i)) in
      if d < 0 || d >= radix then 0 - 1
      else _parse_radix s (i + 1) n radix (acc * radix + d);

  let _ipv4_number = fn (part: str) ->
    let n = str_len part in
    if n == 0 then 0 - 1
    else if n >= 2 && (char_at part 0) == "0"
            && (to_lower (char_at part 1)) == "x" then
      // 0x with nothing after it is zero, not a failure.
      (if n == 2 then 0 else _parse_radix part 2 n 16 0)
    else if n >= 2 && (char_at part 0) == "0" then _parse_radix part 1 n 8 0
    else _parse_radix part 0 n 10 0;

  let rec _all_numbers = fn (parts) -> fn (acc) ->
    match parts with
    | Nil -> Some (list_rev acc)
    | Cons (h, t) ->
      let v = _ipv4_number h in
      if v < 0 then None else _all_numbers t (Cons (v, acc));

  // The last part absorbs the remaining octets, so `1.2` is 1.0.0.2 and
  // `0x7f.1` is 127.0.0.1. Each earlier part must fit in one octet.
  let rec _fits = fn (nums) -> fn (left: int) ->
    match nums with
    | Nil -> true
    | Cons (h, t) ->
      match t with
      | Nil -> h < left
      | Cons (_, _) -> if h > 255 then false else _fits t left;

  let rec _pow256 = fn (k: int) -> if k <= 0 then 1 else 256 * _pow256 (k - 1);

  let rec _to_octets = fn (nums) -> fn (count: int) -> fn (acc) ->
    match nums with
    | Nil -> list_rev acc
    | Cons (h, t) ->
      match t with
      | Nil ->
        // Spread the final number over the octets nobody claimed.
        let rec spread = fn (v: int) -> fn (k: int) -> fn (out) ->
          if k < 0 then out
          else spread v (k - 1) (Cons ((v / (_pow256 k)) % 256, out)) in
        list_rev (spread h (4 - count) acc)
      | Cons (_, _) -> _to_octets t count (Cons (h, acc));

  // Whether the host is an IPv4 attempt at all, which decides what a failure
  // means. If the last label is a number then the host IS an address and a bad
  // one is invalid; if it is not, the host is a domain and IPv4 never applies.
  //
  // Conflating the two is the bug the oracle caught: `http://256.1.1.1` was
  // being accepted as a hostname called "256.1.1.1", and an allowlist that
  // resolves that name later is not checking what it thinks it is.
  let rec _last_label = fn (parts) -> fn (fallback: str) ->
    match parts with
    | Nil -> fallback
    | Cons (h, t) -> _last_label t h;

  let ends_in_number = fn (host: str) ->
    let trimmed =
      if str_len host > 1 && str_ends_with host "."
      then substring host 0 (str_len host - 1)
      else host in
    let parts = str_split trimmed "." in
    if list_len parts == 0 then false
    else _ipv4_number (_last_label parts "") >= 0;

  // "" when the parse fails. Only meaningful when ends_in_number said yes.
  let try_ipv4 = fn (host: str) ->
    // A single trailing dot is allowed and dropped: `1.2.3.4.` is an address.
    let trimmed =
      if str_len host > 1 && str_ends_with host "."
      then substring host 0 (str_len host - 1)
      else host in
    let parts = str_split trimmed "." in
    let n = list_len parts in
    if n > 4 then ""
    else
      match _all_numbers parts Nil with
      | None -> ""
      | Some nums ->
        if not (_fits nums (_pow256 (5 - n))) then ""
        else
          str_join "." (list_map (_to_octets nums n Nil) (fn (o: int) -> show o));

  // --- host --------------------------------------------------------------

  // The Standard's forbidden host code points. Most of them are delimiters that
  // never reach here — the authority ends at `/`, `?` and `#`, userinfo splits
  // at `@`, the port at `:` — but they are all listed anyway, because after
  // percent-decoding a domain any of them can appear where no delimiter was.
  let _forbidden_host_byte = fn (b: int) ->
    b == 0x00 || b == 0x09 || b == 0x0A || b == 0x0D || b == 0x20
    || b == 0x23 || b == 0x2F || b == 0x3A || b == 0x3C || b == 0x3E
    || b == 0x3F || b == 0x40 || b == 0x5B || b == 0x5C || b == 0x5D
    || b == 0x5E || b == 0x7C;

  let rec _has_forbidden = fn (h: str) -> fn (i: int) -> fn (n: int) ->
    if i >= n then false
    else if _forbidden_host_byte (ord (char_at h i)) then true
    else _has_forbidden h (i + 1) n;

  // An IPv6 literal is parsed and re-serialised into its canonical form, so
  // `[0:0:0:0:0:0:0:1]` and `[::1]` come out as the same host. Comparing the
  // text instead would call them different origins. The brackets are the one
  // place `[` and `]` are allowed.
  let parse_host = fn (h: str) -> fn (special: bool) ->
    if str_len h == 0 then Some ""
    else if str_starts_with h "[" then
      (if str_ends_with h "]"
       then Ipv6.canonical (substring h 1 (str_len h - 1))
       else None)
    else if not special then
      // Opaque: no case folding, no IPv4, and no decoding — but the forbidden
      // code points still are forbidden.
      (if _has_forbidden h 0 (str_len h) then None else Some h)
    else
      // A domain is percent-decoded before anything else looks at it, so `%41`
      // is `a` and `%2e` is a label separator: `http://0x7f%2e1` is
      // `127.0.0.1`. An allowlist that skips this step sees an opaque name
      // where there is an address. A malformed escape is not a domain at all.
      match Percent.decode_strict h with
      | None -> None
      | Some decoded ->
        // Checked after decoding, which is the whole point: `http://a%2fb` has
        // a `/` in its host and is not a URL.
        if _has_forbidden decoded 0 (str_len decoded) then None
        else
          let lowered = to_lower decoded in
          if ends_in_number lowered then
            let v4 = try_ipv4 lowered in
            if v4 == "" then None else Some v4
          else Some lowered;

  // --- port --------------------------------------------------------------
  // Digits only. An empty port after the colon is not an error, it is no port.
  // The scheme's default is elided so two spellings of one address compare
  // equal.

  let rec _all_digits = fn (s: str) -> fn (i: int) -> fn (n: int) ->
    if i >= n then true
    else if _is_digit (ord (char_at s i)) then _all_digits s (i + 1) n
    else false;

  let parse_port = fn (p: str) -> fn (scheme: str) ->
    if str_len p == 0 then Some ""
    else if not (_all_digits p 0 (str_len p)) then None
    else
      let v = _parse_radix p 0 (str_len p) 10 0 in
      if v > 65535 then None
      else
        let canon = show v in
        if canon == default_port scheme then Some "" else Some canon;

  // --- the authority -----------------------------------------------------
  // userinfo is everything before the LAST `@`, so a password may contain one.
  // The host ends at the last `:` that is not inside brackets.

  let _split_userinfo = fn (auth: str) ->
    let at = str_last_index_of auth "@" in
    if at < 0 then ("", "", auth)
    else
      let ui = substring auth 0 at in
      let rest = substring auth (at + 1) (str_len auth) in
      let colon = str_index_of ui ":" in
      if colon < 0 then (ui, "", rest)
      else (substring ui 0 colon,
            substring ui (colon + 1) (str_len ui),
            rest);

  // Where the authority stops: the first of `/`, `?` or `#`, plus `\` for a
  // special scheme. `http://u\p@h/` has host `u` — the backslash ends the
  // authority before the `@` is ever reached, so the `u\p` is not userinfo.
  let rec _auth_end = fn (s: str) -> fn (i: int) -> fn (n: int) ->
                      fn (special: bool) ->
    if i >= n then n
    else
      let c = char_at s i in
      if c == "/" || c == "?" || c == "#" || (special && c == "\\") then i
      else _auth_end s (i + 1) n special;

  // A special scheme takes any run of slashes and backslashes before its
  // authority, including none at all.
  let rec _skip_slashes = fn (s: str) -> fn (i: int) -> fn (n: int) ->
    if i >= n then i
    else
      let c = char_at s i in
      if c == "/" || c == "\\" then _skip_slashes s (i + 1) n else i;

  let _split_port = fn (hostport: str) ->
    if str_starts_with hostport "[" then
      let close = str_index_of hostport "]" in
      if close < 0 then (hostport, "")
      else
        let after = substring hostport (close + 1) (str_len hostport) in
        if str_starts_with after ":" then
          (substring hostport 0 (close + 1),
           substring after 1 (str_len after))
        else (hostport, "")
    else
      let colon = str_last_index_of hostport ":" in
      if colon < 0 then (hostport, "")
      else (substring hostport 0 colon,
            substring hostport (colon + 1) (str_len hostport));

  // --- parse -------------------------------------------------------------
  // Absolute URLs only: without a base there is nothing to resolve a relative
  // reference against, and resolution is the next slice's job.

  let _with_authority = fn (scheme: str) -> fn (special: bool) ->
                        fn (body: str) ->
    let ae = _auth_end body 0 (str_len body) special in
    let auth = substring body 0 ae in
    let tail = substring body ae (str_len body) in
    let (raw_user, raw_pass, hostport) = _split_userinfo auth in
    // `http://a@b@h/` has username `a%40b`: the userinfo set includes `@`, so
    // an unencoded one would re-split differently on the way out.
    let user = Percent.encode Percent.userinfo raw_user in
    let pass = Percent.encode Percent.userinfo raw_pass in
    let (h, p) = _split_port hostport in
    match parse_host h special with
    | None -> None
    | Some host ->
      // A special scheme must have a host; `http://` alone is not a URL. A
      // non-special one may have an empty host — `foo://` is a URL.
      if special && host == "" then None
      else
        match parse_port p scheme with
        | None -> None
        | Some port ->
          let (nofrag, raw_frag, has_frag) = Path.split_fragment tail in
          let (raw_path, raw_query, has_q) = Path.split_query nofrag in
          Some (url_parts {
            scheme = scheme, username = user, password = pass,
            host = host, port = port, has_authority = true,
            path = Path.normalize raw_path special,
            query = Path.encode_query raw_query special, has_query = has_q,
            fragment = Path.encode_fragment raw_frag, has_fragment = has_frag,
            special = special });

  // No authority. The path is opaque only when it does not start with `/`:
  // `foo:/a/../b` is `foo:/b`, but `foo:a/../b` keeps its dots and `mailto:x@y`
  // keeps its `@`.
  let _no_authority = fn (scheme: str) -> fn (after: str) ->
                      fn (is_opaque: bool) ->
    let (nofrag, raw_frag, has_frag) = Path.split_fragment after in
    let (raw_path, raw_query, has_q) = Path.split_query nofrag in
    Some (url_parts {
      scheme = scheme, username = "", password = "",
      host = "", port = "", has_authority = false,
      path = if is_opaque then Path.opaque raw_path
             else Path.normalize raw_path false,
      query = Path.encode_query raw_query false, has_query = has_q,
      fragment = Path.encode_fragment raw_frag, has_fragment = has_frag,
      special = false });

  let parse = fn (input: str) ->
    let s = clean input in
    let slen = scheme_len s in
    if slen <= 0 then None
    else
      let scheme = to_lower (substring s 0 slen) in
      let special = is_special scheme in
      let after = substring s (slen + 1) (str_len s) in
      if special then
        // The authority is not optional for a special scheme, and the slashes
        // before it are: `http:h`, `http:/h`, `http:\\h` and `http:///h` all
        // have host `h`. An empty authority is then rejected below.
        let start = _skip_slashes after 0 (str_len after) in
        _with_authority scheme special (substring after start (str_len after))
      else if str_starts_with after "//" then
        _with_authority scheme special (substring after 2 (str_len after))
      else
        // `\` is not an authority marker for a non-special scheme: `foo:\\h` is
        // an opaque path.
        _no_authority scheme after (not (str_starts_with after "/"));

  // --- resolution against a base -----------------------------------------
  // What every link in a page needs. `resolve base input` is `new URL(input,
  // base)`: the input wins wherever it says anything, and the base fills in the
  // rest.

  // A path is opaque when there is no authority and it does not start with `/`.
  // There is nothing to resolve a reference against in that case — `mailto:x@y`
  // has no directory — so only a fragment may be attached to one.
  let has_opaque_path = fn (u: url_parts) ->
    not u.has_authority && not (str_starts_with u.path "/");

  // Everything up to and including the base's last `/`. A relative path
  // replaces the last segment, so `d` against `/a/b/c` is `/a/b/d`, and against
  // `/a/b/` it is `/a/b/d` as well. An empty base path merges as if it were `/`.
  let _strip_last = fn (p: str) ->
    let i = str_last_index_of p "/" in
    if i < 0 then "/" else substring p 0 (i + 1);

  let _sep = fn (special: bool) -> fn (c: str) ->
    c == "/" || (special && c == "\\");

  // Two or more separators start an authority for a special scheme — and any
  // number beyond two is still one authority, so `\\\h2/d` is `//h2/d`. For
  // anything else only a literal `//` does, and a backslash is an ordinary
  // path character.
  let _starts_authority = fn (rem: str) -> fn (special: bool) ->
    if special then
      str_len rem >= 2 && _sep true (char_at rem 0) && _sep true (char_at rem 1)
    else str_starts_with rem "//";

  // Everything but the fragment, kept from the base. The one resolution an
  // opaque base admits.
  let _base_plus_fragment = fn (base: url_parts) -> fn (raw_frag: str) ->
    Some (url_parts {
      scheme = base.scheme, username = base.username, password = base.password,
      host = base.host, port = base.port, has_authority = base.has_authority,
      path = base.path, query = base.query, has_query = base.has_query,
      fragment = Path.encode_fragment raw_frag, has_fragment = true,
      special = base.special });

  let _relative = fn (base: url_parts) -> fn (rem: str) ->
    let special = base.special in
    // An opaque base has no directory to resolve against, so the Standard
    // admits exactly one reference: one whose FIRST code point is `#`. Not a
    // reference that merely contains one, and not the empty reference. This is
    // checked before anything else because `//h/d` against `mailto:x@y` must
    // fail rather than invent an authority under `mailto`.
    if has_opaque_path base then
      (if str_starts_with rem "#"
       then _base_plus_fragment base (substring rem 1 (str_len rem))
       else None)
    else if _starts_authority rem special then
      // A new authority under the base's scheme.
      let start = if special then _skip_slashes rem 0 (str_len rem) else 2 in
      _with_authority base.scheme special (substring rem start (str_len rem))
    else
      let (nofrag, raw_frag, has_frag) = Path.split_fragment rem in
      let (raw_path, raw_query, has_q) = Path.split_query nofrag in
      // A reference that says nothing about the path keeps the base's, and with
      // it the base's query. One that says anything about the path drops the
      // base's query — `d` against `...?bq` has no query at all.
      let path =
        if raw_path == "" then base.path
        else if _sep special (char_at raw_path 0) then
          Path.normalize raw_path special
        else Path.normalize (_strip_last base.path ++ raw_path) special in
      Some (url_parts {
        scheme = base.scheme, username = base.username,
        password = base.password, host = base.host, port = base.port,
        has_authority = base.has_authority, path = path,
        query = if has_q then Path.encode_query raw_query special
                else if raw_path == "" then base.query else "",
        has_query = if has_q then true
                    else raw_path == "" && base.has_query,
        fragment = Path.encode_fragment raw_frag, has_fragment = has_frag,
        special = special });

  // A reference with a scheme is absolute — except that a special scheme naming
  // the base's own scheme is not. `http:d` against `http://h/a/b/c` is
  // `http://h/a/b/d`, not a host called `d`; `https:d` against the same base IS
  // `https://d/`. Getting this backwards turns a same-origin relative link into
  // a request to a host the page named.
  let resolve = fn (base: url_parts) -> fn (input: str) ->
    let s = clean input in
    let slen = scheme_len s in
    if slen <= 0 then _relative base s
    else
      let sc = to_lower (substring s 0 slen) in
      if is_special sc && sc == base.scheme then
        _relative base (substring s (slen + 1) (str_len s))
      else parse s;

  // --- serialisation -----------------------------------------------------

  let _cred = fn (u: url_parts) ->
    if u.username == "" && u.password == "" then ""
    else if u.password == "" then u.username ++ "@"
    else u.username ++ ":" ++ u.password ++ "@";

  // scheme://user:pass@host:port — what an origin check compares.
  let origin = fn (u: url_parts) ->
    let portpart = if u.port == "" then "" else ":" ++ u.port in
    if not u.has_authority then u.scheme ++ ":"
    else u.scheme ++ "://" ++ _cred u ++ u.host ++ portpart;

  // The whole URL back out. Round-tripping is the honest test of the parse: a
  // field that was dropped or a delimiter that was invented shows up here.
  let href = fn (u: url_parts) ->
    let portpart = if u.port == "" then "" else ":" ++ u.port in
    let auth =
      if u.has_authority then "//" ++ _cred u ++ u.host ++ portpart else "" in
    let q = if u.has_query then "?" ++ u.query else "" in
    let f = if u.has_fragment then "#" ++ u.fragment else "" in
    u.scheme ++ ":" ++ auth ++ u.path ++ q ++ f;

}
