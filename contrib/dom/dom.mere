// contrib/dom — minimal DOM bindings for browser-side Mere code.
//
// Provides four extern fns that the user's HTML host must wire up via
// `contrib/dom/dom.glue.js` (or an equivalent module) before
// instantiating the Wasm module. See `contrib/dom/README.md` for the
// integration recipe.
//
// extern type JsRef is an opaque handle to a JavaScript object. The
// only producers are the extern fns below; the typer prevents code
// from fabricating a JsRef from a plain integer.

extern type JsRef;

// Wrapper around `document.getElementById`. Returns an opaque handle
// to the matched element, or a host-defined sentinel (usually handle
// index 0, treated by the glue as a no-op target) when no element
// matches the id.
extern fn dom_get_by_id: str -> JsRef;

// Equivalent of `element.textContent = s`. The string is read from
// Wasm linear memory and copied into the DOM.
extern fn dom_set_text: JsRef -> str -> unit;

// Equivalent of `element.addEventListener("click", handler)`. The
// closure runs the next time the element is clicked; its env lives in
// the Wasm module's bump arena and survives for the page lifetime, so
// captured values stay alive between event firings.
extern fn dom_on_click: JsRef -> (unit -> unit) -> unit;

// Read `element.value` from `<input>` / `<textarea>`. The returned
// string is copied into a host-managed scratch buffer in linear memory
// and is only valid until the next `dom_input_value` call — copy via
// `str_*` builtins if you need to retain it past that point.
extern fn dom_input_value: JsRef -> str;

// v0.1.22 (2048 dogfood): a global keydown handler. The closure receives
// the pressed key's name (e.g. "ArrowLeft", "a", "Enter") as a str, read
// from a host scratch buffer valid only for that call — copy it if you
// need to keep it. Wires `document.addEventListener("keydown", ...)`, so
// no element handle is needed. The browser-side counterpart to native
// `read_key` (mrog): input for the frontend FFI.
extern fn dom_on_key: (str -> unit) -> unit;

// v0.1.58 (raytracer dogfood): canvas 2D drawing. The handle is the
// <canvas> element (from dom_get_by_id); the glue lazily grabs and
// caches its 2d context. fill_style takes any CSS color string
// (e.g. "rgb(200,30,30)"); fill_rect is x, y, w, h in canvas pixels.
// Together they are the minimal pixel-output surface: a renderer sets
// the style then fills 1x1 rects. Blitting a whole buffer in one call
// (ImageData) needs typed-buffer FFI and is deliberately future work.
extern fn dom_canvas_fill_style: JsRef -> str -> unit;
extern fn dom_canvas_fill_rect: JsRef -> int -> int -> int -> int -> unit;

// A per-frame callback driven by the host's requestAnimationFrame loop: the
// glue calls the `unit -> unit` closure once per animation frame, forever.
// The counterpart to dom_on_key for programs that must advance on their own
// (a real-time emulator, an animation) rather than only on input. Added for
// the CHIP-8 emulator dogfood, which needs a continuous run/redraw loop.
extern fn dom_on_frame: (unit -> unit) -> unit;

// ROM access for emulators: the host holds the fetched cartridge and serves it
// a byte at a time, so a large ROM need not be embedded in the module.
// `dom_rom_size`'s argument is ignored (a placeholder, since the FFI takes an
// int). Added for the Game Boy emulator dogfood.
extern fn dom_rom_size: int -> int;
extern fn dom_rom_byte: int -> int;

// Polled key state for games: returns 1 if the button with the given code is
// currently held (0-3 = right/left/up/down, 4-7 = A/B/select/start), else 0.
// Unlike dom_on_key (keydown only) this reflects press-and-hold, which a game's
// per-frame input poll needs. Added for the Game Boy emulator dogfood.
extern fn dom_key_held: int -> int;

// A tone on one of up to four audio channels: dom_audio_tone(chan, freqHz, vol)
// where vol is 0..15 (0 = silence that channel). The host drives a Web Audio
// oscillator per channel, so an emulator's sound unit can map its channels onto
// real audio. Added for the Game Boy APU dogfood.
extern fn dom_audio_tone: int -> int -> int -> unit;

// ---------------------------------------------------------------------
// v0.1.152 (chat dogfood): the document-shaped web app.
//
// Everything above this line was driven by games and emulators, which
// paint one canvas or rewrite one element's text. A chat client is the
// first browser program whose DOM *structure* changes and that has to
// talk to a server, so it forces three groups the games never needed:
// element construction, request/response, and server push.
// ---------------------------------------------------------------------

// Element construction. `dom_create` wraps `document.createElement` and
// returns a detached handle — nothing renders until `dom_append` puts it
// under a parent that is already in the document.
extern fn dom_create: str -> JsRef;
extern fn dom_append: JsRef -> JsRef -> unit;

// `element.setAttribute(name, value)` and `input.value = s`. Setting
// `value` needs its own fn because it is a property, not an attribute:
// assigning the attribute does not move the caret or clear a typed-in
// field, which is what a form reset needs.
extern fn dom_set_attr: JsRef -> str -> str -> unit;
extern fn dom_set_value: JsRef -> str -> unit;

// Scroll a container to its bottom (`el.scrollTop = el.scrollHeight`).
// The append-only panes of a chat — the message list and the log — both
// want this after every insertion.
extern fn dom_scroll_to_end: JsRef -> unit;

// `form.addEventListener("submit", ...)` with `preventDefault()` already
// applied by the host, since a Mere closure has no handle on the event
// object and a form that navigates away would kill the Wasm instance.
extern fn dom_on_submit: JsRef -> (unit -> unit) -> unit;

// Queue one header for the NEXT dom_fetch / dom_fetch_async call, then
// forget it. Mirrors `http_fetch_add_header` in the native runners so
// that request-building code reads the same on both sides.
extern fn dom_fetch_header: str -> str -> unit;

// Request/response, offered in BOTH shapes on purpose (chat dogfood) —
// the point is to compare what the two do to Mere code, not to bless
// one. Both report status out-of-band through `dom_fetch_status`,
// exactly as the native `http_fetch` / `http_fetch_status` pair does;
// that pattern survives here because a single-threaded event loop runs
// each callback to completion before the next one starts.
//
//   dom_fetch        blocking. Returns the response body, so callers
//                    stay straight-line and identical to native code.
//                    Costs a frozen UI thread for the whole round trip
//                    (synchronous XMLHttpRequest under the hood).
//
//   dom_fetch_async  non-blocking. Hands the body to a callback, so the
//                    continuation has to be written as a closure and
//                    chained requests nest.
//
// `dom_fetch_status` refers to the most recently COMPLETED request: the
// return of `dom_fetch`, or the callback currently running.
extern fn dom_fetch: str -> str -> str -> str;
extern fn dom_fetch_async: str -> str -> str -> (str -> unit) -> unit;
extern fn dom_fetch_status: unit -> int;

// Server push: `new EventSource(url)`. The first closure receives each
// message's `data` field; the second receives connection state changes
// as "open" / "error". No unsubscribe — the stream lives as long as the
// page, which is all a chat client wants. Push cannot be expressed as a
// return value, so this is a callback in every design; it is the reason
// a frontend needs closures even if every request stays blocking.
extern fn dom_sse: str -> (str -> unit) -> (str -> unit) -> unit;

// Minutes to add to UTC to get the viewer's local wall clock (JST =
// 540). Needed because a timestamp rendered in UTC reads as wrong to a
// human, and the conversion itself is ordinary arithmetic that belongs
// in Mere rather than in the host.
extern fn dom_tz_offset: unit -> int;
