// Checked source compilation shared by the CLI and browser. The low-level
// parse_and_emit bootstrap API remains separate from this user-facing entry.
import "../typer/typer.mere";
import "codegen_wasm.mere";

let compile_source_to_wat = fn (src: str) ->
  let toks = tokenize src in
  let (prog, _rest) = parse_decls Nil toks in
  let (decls, main_expr) = flatten_and_resolve prog in
  let (source_env, source_state) = prepare_source_env decls in
  let (decls_r, env1, s1) =
    annotate_decls decls source_env source_state in
  let (main_r, s2) = annotate_expr env1 s1 main_expr in
  let (main_ty, s3) = infer env1 s2 main_expr in
  let resolved_main_ty = apply_subst (subst_of s3) main_ty in
  let annotated_main = EAnnot (main_r, resolved_main_ty) in
  // Q-136 (v0.1.501): a program whose value is unit prints NOTHING. This is
  // the sixth place that decides it -- the OCaml side changed its five in
  // v0.1.494 and the self-hosted compiler kept printing `()`, which is what
  // scripts/selfhost_check.sh caught. `show ()` still answers `()`; the rule
  // is about what a program prints when it ends, not about `show`.
  let wrapped =
    match resolved_main_ty with
    | TyUnit -> ELet (PWild, main_r, EUnit)
    | _ -> ELet (PWild,
                 EApp (EVar "print", EApp (EVar "show", annotated_main)),
                 EUnit) in
  emit_program ((decls_r, wrapped) : program);

()
