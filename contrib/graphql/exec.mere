// contrib/graphql/exec.mere — executing a GraphQL document against data.
//
// The value model is `gvalue`, and the "resolvers" are the data: a field is
// resolved by looking its name up in the parent object, which is what graphql-js
// does by default. That is a deliberate choice for a first executor, and it is
// what makes the parity harness meaningful — with the default resolver on both
// sides, nothing about resolution has to be transcribed, so a difference in the
// output is a difference in EXECUTION rather than in two hand-written resolver
// sets that drifted.
//
// NULL PROPAGATION IS THE HARD PART, and it is why an oracle earns its place here.
// A non-null field that resolves to null is not an error in that field — it is an
// error that destroys the nearest NULLABLE ancestor. `{ nn }` where `nn: Int!`
// answers `"data": null`, not `"data": {"nn": null}`. Every position is therefore
// one of two things, and that is exactly what `gout` says:
//
//   GOk (value, errors)   — a value, possibly null, and whatever went wrong below
//   GBubble errors        — this position could not be null and was; the enclosing
//                          nullable position has to absorb it
//
// A nullable position absorbs a `GBubble` into `GOk (GNull, errors)`; a non-null
// position passes it on. Written that way, the four cases in the specification
// (field, list item, object, top level) all fall out of the same two constructors
// instead of needing exceptions the language does not have.
//
// SCOPE, and each of these is a stated gap rather than a silent one:
//
//   * `locations` in errors are NOT produced. They need source positions the
//     parser does not carry. The harness strips them from the oracle's answer too,
//     and says so.
//   * Field ARGUMENTS reach a resolver only when the field's value IS one: a `GFn`
//     is applied to its coerced arguments. Plain data ignores them, which is what
//     graphql-js's default resolver does too. Three further places read an argument
//     without any resolver being involved, because there the argument IS the question:
//     `@skip` / `@include`, `__type(name:)`, and `includeDeprecated`.
//   * Interfaces and unions ARE resolved, from a `__typename` field in the data —
//     which is graphql-js's own default `resolveType`, so neither side has a
//     hand-written resolver. A value that does not carry one is the oracle's error,
//     with its wording, rather than a guess.
//   * Custom scalars and subscriptions.
//
// INTROSPECTION IS HERE, and it is answered by this same executor: the introspection
// schema is SDL (generated into `introspection_sdl.mere`) appended to the document's
// own definitions, so `__Type` is an object type like any other and nullability,
// null propagation, list handling and enum coercion all apply to it unchanged. The
// one thing that could not be data is the CYCLE — see `GTypeRef`.
//
// Anything outside that is REFUSED with a named message rather than approximated,
// so an unhandled combination shows up as a refusal and not as a wrong answer.

import "ast.mere";
import "lexer.mere";
import "parser.mere";
// The printer, because an input value's `defaultValue` is introspected as a STRING
// — the value printed as GraphQL — so the same printer the document round-trip is
// gated on produces it.
import "printer.mere";
import "introspection_sdl.mere";

type gvalue =
  | GNull
  | GBool of bool
  | GInt of int
  | GFloat of float
  | GStr of str
  | GList of gvalue list
  | GObj of (str * gvalue) list
  // A FIELD THAT IS A FUNCTION OF ITS ARGUMENTS.
  //
  // Everywhere else "the resolvers are the data", which is what makes the execution
  // gate meaningful: with the default resolver on both sides nothing about resolution
  // is transcribed. But `user(id: 5)` cannot be data — its value depends on an argument
  // the document supplies — so a field's value may be a function of the coerced
  // arguments instead.
  //
  // The gate for THIS is necessarily different, and the difference is worth stating: a
  // hand-written resolver exists on both sides and the two could drift. So the harness
  // makes its resolvers ECHO THE ARGUMENTS THEY RECEIVED, which keeps the resolver
  // trivial and puts the comparison back on argument COERCION — defaults, absence,
  // variables — where an oracle earns its place.
  | GFn of ((str * gvalue) list -> gvalue)
  // A LAZY REFERENCE TO A TYPE, and the only non-data value in this model.
  //
  // Introspection is CYCLIC: `__schema.types` lists every type, each type's
  // `fields` name types, whose fields name types. A strict value cannot hold that
  // — building it eagerly does not terminate — and the standard introspection
  // query is what bounds the expansion: it asks for `ofType` exactly nine levels
  // deep and stops.
  //
  // So a type is carried as its type EXPRESSION and its `__Type` fields are
  // computed when the query asks for them. That makes this the first place in this
  // executor where a field is computed rather than looked up, which is worth
  // saying out loud: everywhere else "the resolvers are the data".
  | GTypeRef of gtype;

// A path element is a field name or a list index — the two things the
// specification says a path is made of.
type gpath = PName of str | PIdx of int;
type gerr = GErr of (str * gpath list);

// `GOk` / `GBubble` and not `GOk` / `GBubble`: `GOk` is already a constructor of the
// prelude's `result` type, and reusing it makes every `match` on a `gout` a type
// error about `result` in the prelude — a message that names a file the program
// never mentions.
type gout = GOk of (gvalue * gerr list) | GBubble of gerr list;

module Gexec {

  let rec rev_list = fn (xs, acc) ->
    match xs with
    | [] -> acc
    | [h, ...t] -> rev_list t (Cons (h, acc));

  let rec appl = fn (a, b) ->
    match a with
    | [] -> b
    | [h, ...t] -> Cons (h, appl t b);

  // --- reading the schema -------------------------------------------------
  // Linear lookups. A schema has tens of types, and an index would be a second
  // representation to keep in step with the first.

  let rec find_obj = fn (defs, name: str) ->
    match defs with
    | [] -> []
    | [d, ...rest] ->
      match d with
      | TsDef (ObjectDef (_, n, _, _, fs)) -> if str_eq n name then fs else find_obj rest name
      | _ -> find_obj rest name;

  // Fields live on objects AND interfaces. `find_obj` answers only for objects,
  // which is right for execution — nothing resolves against an interface here —
  // and wrong for introspection, where `__Type.fields` is non-null for both.
  let rec find_obj_or_iface = fn (defs, name: str) ->
    match defs with
    | [] -> []
    | [d, ...rest] ->
      match d with
      | TsDef (ObjectDef (_, n, _, _, fs)) ->
        if str_eq n name then fs else find_obj_or_iface rest name
      | TsDef (InterfaceDef (_, n, _, _, fs)) ->
        if str_eq n name then fs else find_obj_or_iface rest name
      | _ -> find_obj_or_iface rest name;

  let rec find_enum = fn (defs, name: str) ->
    match defs with
    | [] -> []
    | [d, ...rest] ->
      match d with
      | TsDef (EnumDef (_, n, _, vs)) -> if str_eq n name then vs else find_enum rest name
      | _ -> find_enum rest name;

  let rec is_enum_name = fn (defs, name: str) ->
    match defs with
    | [] -> false
    | [d, ...rest] ->
      match d with
      | TsDef (EnumDef (_, n, _, _)) -> if str_eq n name then true else is_enum_name rest name
      | _ -> is_enum_name rest name;

  let rec is_obj_name = fn (defs, name: str) ->
    match defs with
    | [] -> false
    | [d, ...rest] ->
      match d with
      | TsDef (ObjectDef (_, n, _, _, _)) -> if str_eq n name then true else is_obj_name rest name
      | _ -> is_obj_name rest name;

  let rec field_ty_in = fn (fs, name: str) ->
    match fs with
    | [] -> []
    | [f, ...rest] ->
      match f with
      | FieldDef (_, n, _, ty, _) ->
        if str_eq n name then Cons (ty, []) else field_ty_in rest name;

  let rec enum_has = fn (vs, name: str) ->
    match vs with
    | [] -> false
    | [v, ...rest] ->
      match v with
      | EnumVal (_, n, _) -> if str_eq n name then true else enum_has rest name;

  // The root operation type. A `schema { query: X }` names it; without one the
  // convention is a type called `Query`, which is a rule of the specification and
  // not a guess.
  // A `schema { query: X }` names it; without one the convention is a type called
  // `Query` / `Mutation` / `Subscription`, which is a rule of the specification and
  // not a guess. `dflt` is that convention.
  let rec schema_root = fn (defs, kind: str, dflt: str) ->
    match defs with
    | [] -> dflt
    | [d, ...rest] ->
      match d with
      | TsDef (SchemaDef (_, _, ops)) ->
        let rec pick = fn (os) ->
          match os with
          | [] -> schema_root rest kind dflt
          | [o, ...more] ->
            match o with
            | OpTy (k, n) -> if str_eq k kind then n else pick more in
        pick ops
      | _ -> schema_root rest kind dflt;

  let schema_query = fn (defs) -> schema_root defs "query" "Query";

  let rec find_frag = fn (defs, name: str) ->
    match defs with
    | [] -> []
    | [d, ...rest] ->
      match d with
      | FragDef (n, tc, _, sels) ->
        if str_eq n name then Cons ((tc, sels), []) else find_frag rest name
      | _ -> find_frag rest name;

  let rec first_op = fn (defs) ->
    match defs with
    | [] -> fail "graphql: the document has no operation to execute"
    | [d, ...rest] ->
      match d with
      | OpDef (_, _, vardefs, _, sels) -> (vardefs, sels)
      | _ -> first_op rest;

  // --- reading data -------------------------------------------------------
  let rec obj_get = fn (fields, name: str) ->
    match fields with
    | [] -> GNull                       // an absent field is null, not an error
    | [(k, v), ...rest] -> if str_eq k name then v else obj_get rest name;

  let resolve = fn (parent: gvalue, name: str) ->
    match parent with
    | GObj fields -> obj_get fields name
    | GNull -> GNull
    | _ -> fail ("graphql: cannot resolve field '" ++ name
                 ++ "' on a value that is not an object");

  // --- values in the document (arguments, variables) ----------------------
  let rec lookup_var = fn (vars, name: str) ->
    match vars with
    | [] -> GNull
    | [(k, v), ...rest] -> if str_eq k name then v else lookup_var rest name;

  // WHETHER A VARIABLE WAS SUPPLIED, which is not whether its value is non-null. An
  // explicitly-null variable is supplied, and that distinction decides two things:
  //
  //   * an explicit null BEATS the variable's own default. Measured:
  //     `query Q($v: Int = 9)` with `{"v": null}` gives `null`, with `{}` gives `9`.
  //   * an argument whose variable was NOT supplied is treated as not written at all,
  //     so the field's schema default applies to it.
  //
  // `lookup_var` answers `GNull` for both cases, so asking it was the bug.
  let rec has_var = fn (vars, name: str) ->
    match vars with
    | [] -> false
    | [(k, _), ...rest] -> if str_eq k name then true else has_var rest name;

  // A value written in the document, as a runtime value. It serves BOTH directive
  // arguments and field arguments now, and the difference is why lists and input
  // objects are here: a directive's `if:` is a scalar, so this used to refuse them with
  // a message about directives — which became wrong the moment field arguments started
  // reaching resolvers.
  //
  // An ENUM becomes a string, matching how the executor coerces enum values everywhere
  // else. An input object keeps the document's key order, which is what the harness
  // compares.
  let rec doc_value = fn (v: gval, vars) ->
    match v with
    | VVar n -> lookup_var vars n
    | VBool b -> GBool b
    | VNull -> GNull
    | VInt lex -> GInt (int_of_str lex)
    | VStr s -> GStr s
    | VBlock s -> GStr s
    | VEnum n -> GStr n
    | VFloat lex -> GFloat (float_of_str lex)
    | VList xs -> GList (list_map xs (fn (x) -> doc_value x vars))
    | VObj fs ->
      GObj (list_map fs (fn (kv) -> let (k, x) = kv in (k, doc_value x vars)));

  let truthy = fn (v: gvalue) ->
    match v with | GBool b -> b | _ -> false;

  // --- @skip / @include ---------------------------------------------------
  // `@skip(if: true)` removes the field ENTIRELY — the response has no key for it,
  // which is different from a null. Measured, because "null or absent" is exactly
  // the kind of thing a reader assumes.
  let rec arg_of = fn (args, name: str) ->
    match args with
    | [] -> []
    | [(k, v), ...rest] -> if str_eq k name then Cons (v, []) else arg_of rest name;

  // --- the arguments a resolver receives ----------------------------------
  //
  // NOT the argument list the document wrote. Every rule below was measured against
  // graphql-js, and every one of them is a distinction something could get wrong:
  //
  //   * a schema DEFAULT applies when the argument is omitted — `b: Int = 7` makes `b`
  //     present and 7
  //   * a default of `null` applies too: `e: Boolean = null` gives `e: null`, which is
  //     how "the default is null" differs from "there is no default"
  //   * an argument with NO default that is not supplied is ABSENT, not null
  //   * an explicit `null` in the document is present and null
  //   * A VARIABLE THAT WAS NOT SUPPLIED MEANS THE ARGUMENT WAS NOT WRITTEN, so the
  //     schema default applies to it. The sharpest case: `f(a: $v, b: $v)` with no `v`
  //     gives `{b: 7}` — `b` falls back to its default and `a`, which has none, is
  //     absent. One variable, two different outcomes, decided by the field definition.
  //   * the ORDER is the FIELD DEFINITION's argument order, not the document's.
  //     `f(c: "s", d: [1,2])` comes back `{b, c, d, e}`.
  let rec arg_defs_of = fn (fs, fname: str) ->
    match fs with
    | [] -> []
    | [FieldDef (_, n, args, _, _), ...rest] ->
      if str_eq n fname then args else arg_defs_of rest fname;

  // Was this argument written with a value that actually arrived? A variable the caller
  // did not supply counts as NOT written — see the rule above.
  let arg_supplied = fn (args, name: str, vars) ->
    match arg_of args name with
    | [] -> []
    | [v, ..._] ->
      match v with
      | VVar vn -> if has_var vars vn then Cons (doc_value v vars, []) else []
      | _ -> Cons (doc_value v vars, []);

  let coerce_args = fn (argdefs, args, vars) ->
    list_fold argdefs [] (fn (acc, iv) ->
      match iv with
      | InputVal (_, an, _, dflt, _) ->
        match arg_supplied args an vars with
        | [v, ..._] -> appl acc (Cons ((an, v), []))
        | [] ->
          match dflt with
          | [d, ..._] -> appl acc (Cons ((an, doc_value d vars), []))
          | [] -> acc);


  let rec included = fn (dirs, vars) ->
    match dirs with
    | [] -> true
    | [d, ...rest] ->
      match d with
      | Dir (n, args) ->
        if str_eq n "skip" then
          match arg_of args "if" with
          | [] -> included rest vars
          | [v, ..._] -> if truthy (doc_value v vars) then false else included rest vars
        else if str_eq n "include" then
          match arg_of args "if" with
          | [] -> included rest vars
          | [v, ..._] -> if truthy (doc_value v vars) then included rest vars else false
        else included rest vars;

  // --- introspection ------------------------------------------------------
  //
  // Answered by the ORDINARY executor against ordinary type definitions. The
  // introspection schema is SDL — generated from graphql-js into
  // `introspection_sdl.mere` and appended to the document's own definitions — so
  // field lookup, nullability, null propagation, list handling and enum coercion
  // all apply to `__Type` exactly as they do to a user's type. There is no second
  // executor, and that is the reason the schema is a file rather than a data
  // structure.
  //
  // What IS special is two fields and one value:
  //
  //   * `__schema` and `__type` are not declared in anybody's SDL. The
  //     specification says the schema PROVIDES them, and graphql-js adds them
  //     implicitly too, so they are a branch beside `__typename` rather than an
  //     injection into the user's Query type.
  //   * `GTypeRef` is lazy, because introspection is cyclic (see the type above).
  //
  // INTROSPECTION IS ALSO WHERE FIELD ARGUMENTS START MATTERING. Everywhere else
  // this executor ignores them, matching graphql-js's default resolver. Two places
  // here cannot:
  //
  //   * `__type(name:)` — without its argument it is not a field, it is a different
  //     question.
  //   * `includeDeprecated` on `fields` / `enumValues` / `inputFields` / `args`,
  //     whose default is FALSE. The standard introspection query passes `true`, so
  //     every gate section that uses it agreed while this was missing; it took a
  //     hand-written `__type(name: "Colour") { enumValues }` to disagree.

  // The four introspection fields the specification gives an `includeDeprecated`
  // argument. Named as a list so the rule has one spelling.
  let deprecatable = fn (name: str) ->
    str_eq name "fields" || str_eq name "enumValues"
    || str_eq name "inputFields" || str_eq name "args";

  let include_deprecated = fn (args, vars) ->
    match arg_of args "includeDeprecated" with
    | [] -> false                       // the argument's default is false
    | [v, ..._] -> truthy (doc_value v vars);

  let filter_deprecated = fn (v: gvalue, keep: bool) ->
    if keep then v
    else
      match v with
      | GList xs ->
        GList (list_filter xs (fn (x: gvalue) ->
          match x with
          | GObj fs -> (match obj_get fs "isDeprecated" with
                        | GBool true -> false
                        | _ -> true)
          | _ -> true))
      | _ -> v;

  let gstr_or_null = fn (xs) ->
    match xs with | [] -> GNull | [x, ..._] -> GStr x;

  // A definition's name, for the ones that have one.
  let tsdef_name = fn (d: gtsdef) ->
    match d with
    | ScalarDef (_, n, _) -> Cons (n, [])
    | ObjectDef (_, n, _, _, _) -> Cons (n, [])
    | InterfaceDef (_, n, _, _, _) -> Cons (n, [])
    | UnionDef (_, n, _, _) -> Cons (n, [])
    | EnumDef (_, n, _, _) -> Cons (n, [])
    | InputDef (_, n, _, _) -> Cons (n, [])
    | _ -> [];

  let rec find_tsdef = fn (defs, name: str) ->
    match defs with
    | [] -> []
    | [d, ...rest] ->
      match d with
      | TsDef td ->
        (match tsdef_name td with
         | [n, ..._] -> if str_eq n name then Cons (td, []) else find_tsdef rest name
         | [] -> find_tsdef rest name)
      | _ -> find_tsdef rest name;

  // The five built-in scalars. They are part of every schema whether or not the
  // document declares them, so they are named here rather than found in `defs`.
  let builtin_scalars = ["Int", "Float", "String", "Boolean", "ID"];

  let rec is_declared = fn (defs, n: str) ->
    match find_tsdef defs n with | [] -> false | _ -> true;

  // The named type at the bottom of a type expression.
  let rec base_name = fn (t: gtype) ->
    match t with
    | TyNamed n -> n
    | TyList inner -> base_name inner
    | TyNonNull inner -> base_name inner;

  // Every type name MENTIONED anywhere: field types, argument types, input field
  // types, directive argument types, union members, `implements` lists.
  //
  // This exists for the built-in scalars and nothing else. A built-in scalar belongs
  // to a schema only if something refers to it — measured against the oracle, whose
  // type map for `type Query \{ a: Int }` is `Query Int Boolean String` and NOT the
  // other two. `Boolean` and `String` are always there because the BUILT-IN
  // DIRECTIVES refer to them: `@skip(if: Boolean!)`, `@deprecated(reason: String!)`.
  // That falls out here rather than being special-cased, because those directives
  // are in the appended introspection SDL and get walked like anything else.
  let referenced_names = fn (defs) ->
    let iv_names = fn (ivs, acc) ->
      list_fold ivs acc (fn (a, iv) ->
        match iv with | InputVal (_, _, ty, _, _) -> Cons (base_name ty, a)) in
    let field_names = fn (fs, acc) ->
      list_fold fs acc (fn (a, f) ->
        match f with
        | FieldDef (_, _, args, ty, _) -> iv_names args (Cons (base_name ty, a))) in
    list_fold defs [] (fn (acc, d) ->
      match d with
      | TsDef (ObjectDef (_, _, ifs, _, fs)) -> field_names fs (appl ifs acc)
      | TsDef (InterfaceDef (_, _, ifs, _, fs)) -> field_names fs (appl ifs acc)
      | TsDef (InputDef (_, _, _, ivs)) -> iv_names ivs acc
      | TsDef (UnionDef (_, _, _, members)) -> appl members acc
      | TsDef (DirectiveDef (_, _, args, _, _)) -> iv_names args acc
      | _ -> acc);

  // Every declared type in declaration order, then the built-in scalars something
  // refers to. Order is not load-bearing: the gate sorts `types` by name on both
  // sides, and its main comparison goes through graphql-js's own
  // `buildClientSchema`, which is order-blind.
  let all_type_names = fn (defs) ->
    let refs = referenced_names defs in
    let rec declared = fn (ds, acc) ->
      match ds with
      | [] -> rev_list acc []
      | [d, ...rest] ->
        match d with
        | TsDef td ->
          (match tsdef_name td with
           | [n, ..._] -> declared rest (Cons (n, acc))
           | [] -> declared rest acc)
        | _ -> declared rest acc in
    let rec add_missing = fn (bs, acc) ->
      match bs with
      | [] -> rev_list acc []
      | [b, ...rest] ->
        if is_declared defs b || not (list_member refs b) then add_missing rest acc
        else add_missing rest (Cons (b, acc)) in
    appl (declared defs []) (add_missing builtin_scalars []);

  let intro_kind = fn (defs, n: str) ->
    match find_tsdef defs n with
    | [] -> "SCALAR"                      // a built-in scalar has no definition
    | [td, ..._] ->
      match td with
      | ScalarDef (_, _, _) -> "SCALAR"
      | ObjectDef (_, _, _, _, _) -> "OBJECT"
      | InterfaceDef (_, _, _, _, _) -> "INTERFACE"
      | UnionDef (_, _, _, _) -> "UNION"
      | EnumDef (_, _, _, _) -> "ENUM"
      | InputDef (_, _, _, _) -> "INPUT_OBJECT"
      | _ -> "SCALAR";

  // `isDeprecated` / `deprecationReason` come from `@deprecated`, whose `reason`
  // has a DEFAULT of "No longer supported" — so an argumentless `@deprecated` still
  // reports a reason, and reporting null there would differ from the oracle.
  let rec find_dir = fn (dirs, name: str) ->
    match dirs with
    | [] -> []
    | [d, ...rest] ->
      match d with
      | Dir (n, args) -> if str_eq n name then Cons (args, []) else find_dir rest name;

  let deprecation = fn (dirs) ->
    match find_dir dirs "deprecated" with
    | [] -> (GBool false, GNull)
    | [args, ..._] ->
      (GBool true,
       match arg_of args "reason" with
       | [] -> GStr "No longer supported"
       | [v, ..._] -> (match v with
                       | VStr sv -> GStr sv
                       | VBlock sv -> GStr sv
                       | VNull -> GNull
                       | _ -> GStr "No longer supported"));

  // An input value's `defaultValue` is a STRING — the value printed as GraphQL —
  // and not the value itself. `Gprint.pval` is what prints it, so the same printer
  // the document round-trip is gated on produces this.
  let intro_input = fn (iv: ginpval) ->
    match iv with
    | InputVal (_, n, ty, dflt, dirs) ->
      let (dep, reason) = deprecation dirs in
      GObj ([("name", GStr n),
            ("description", GNull),
            ("type", GTypeRef ty),
            ("defaultValue", match dflt with
                             | [] -> GNull
                             | [d, ..._] -> GStr (Gprint.pval d)),
            ("isDeprecated", dep),
            ("deprecationReason", reason)]);

  let intro_field = fn (f: gfield) ->
    match f with
    | FieldDef (_, n, args, ty, dirs) ->
      let (dep, reason) = deprecation dirs in
      GObj ([("name", GStr n),
            ("description", GNull),
            ("args", GList (list_map args intro_input)),
            ("type", GTypeRef ty),
            ("isDeprecated", dep),
            ("deprecationReason", reason)]);

  let intro_enumval = fn (v: genumv) ->
    match v with
    | EnumVal (_, n, dirs) ->
      let (dep, reason) = deprecation dirs in
      GObj ([("name", GStr n),
            ("description", GNull),
            ("isDeprecated", dep),
            ("deprecationReason", reason)]);

  // Which object and interface types declare a given interface. `possibleTypes` on
  // an interface is exactly this, and on a union it is the members it lists.
  let implementors_of = fn (defs, iface: str) ->
    let rec go = fn (ds, acc) ->
      match ds with
      | [] -> rev_list acc []
      | [d, ...rest] ->
        match d with
        | TsDef (ObjectDef (_, n, ifs, _, _)) ->
          if list_member ifs iface then go rest (Cons (GTypeRef (TyNamed n), acc))
          else go rest acc
        | TsDef (InterfaceDef (_, n, ifs, _, _)) ->
          if list_member ifs iface then go rest (Cons (GTypeRef (TyNamed n), acc))
          else go rest acc
        | _ -> go rest acc in
    go defs [];

  // --- interfaces and unions, at run time ---------------------------------
  //
  // An abstract position has to name a CONCRETE object type before its fields can be
  // selected, and with data as the resolver the question is where that name comes from.
  // It comes from a `__typename` FIELD IN THE DATA — which is not an invention here:
  // it is graphql-js's own default `resolveType`, which looks at `value.__typename`
  // before it tries anything else. Keeping the same default is what lets the harness
  // stay meaningful, because neither side has a hand-written resolver to drift.
  //
  // So the header's old claim -- "with data as the resolver there is nothing to resolve
  // a concrete type from" -- was wrong about the oracle rather than about the design.
  // There was something to resolve it from; nobody had looked.
  let dquote = fn (s: str) -> "\"" ++ s ++ "\"";

  let rec is_abstract_name = fn (defs, name: str) ->
    match find_tsdef defs name with
    | [InterfaceDef (_, _, _, _, _), ..._] -> true
    | [UnionDef (_, _, _, _), ..._] -> true
    | _ -> false;

  let rec obj_implements = fn (defs, obj: str, iface: str) ->
    match find_tsdef defs obj with
    | [ObjectDef (_, _, ifs, _, _), ..._] -> list_member ifs iface
    // An interface may implement an interface; an object still has to DECLARE every
    // interface it implements transitively, so the list above is the whole answer.
    | [InterfaceDef (_, _, ifs, _, _), ..._] -> list_member ifs iface
    | _ -> false;

  // Is `concrete` one of the types `abs` can be at run time? For an interface that is
  // the implements list; for a union, its members. Anything else answers false, which
  // makes this safe to ask about a plain object type as well — the fragment-matching
  // test below does exactly that.
  let possible_type = fn (defs, abs: str, concrete: str) ->
    match find_tsdef defs abs with
    | [InterfaceDef (_, _, _, _, _), ..._] -> obj_implements defs concrete abs
    | [UnionDef (_, _, _, members), ..._] -> list_member members concrete
    | _ -> false;

  // A fragment's type condition matches when the condition IS the current type or when
  // the current type is one of the condition's possible types. With `tname` already
  // concrete at an abstract position, `... on Node` on a `Post` goes through the second
  // arm and `... on User` matches neither.
  let cond_matches = fn (defs, tname: str, tc: str) ->
    str_eq tc "" || str_eq tc tname || possible_type defs tc tname;

  // The concrete type NAME carried by a value, or nothing. Only an object can carry
  // one, and only as a string.
  let runtime_type_of = fn (v: gvalue) ->
    match v with
    | GObj fields ->
      (match obj_get fields "__typename" with
       | GStr n -> Cons (n, [])
       | _ -> [])
    | _ -> [];

  // The four ways naming a runtime type can go wrong, each with the oracle's wording.
  // They are DISTINCT on purpose: "no name at all", "a name that is not in the schema",
  // "a name that is not an object" and "an object that this abstract type cannot be"
  // are four different mistakes by whoever produced the data, and collapsing them into
  // one message would make the common one (a missing `__typename`) unrecognisable.
  let abstract_type_error = fn (defs, abs: str, label: str, v: gvalue, path) ->
    match runtime_type_of v with
    | [] ->
      Cons (GErr ("Abstract type " ++ dquote abs
                  ++ " must resolve to an Object type at runtime for field "
                  ++ dquote label ++ ". Either the " ++ dquote abs
                  ++ " type should provide a " ++ dquote "resolveType"
                  ++ " function or each possible type should provide an "
                  ++ dquote "isTypeOf" ++ " function.", path), [])
    | [rt, ..._] ->
      if not (list_member (all_type_names defs) rt) then
        Cons (GErr ("Abstract type " ++ dquote abs ++ " was resolved to a type "
                    ++ dquote rt ++ " that does not exist inside the schema.", path), [])
      else if not (is_obj_name defs rt) then
        Cons (GErr ("Abstract type " ++ dquote abs
                    ++ " was resolved to a non-object type " ++ dquote rt ++ ".", path), [])
      else
        Cons (GErr ("Runtime Object type " ++ dquote rt
                    ++ " is not a possible type for " ++ dquote abs ++ ".", path), []);

  let abstract_ok = fn (defs, abs: str, v: gvalue) ->
    match runtime_type_of v with
    | [] -> []
    | [rt, ..._] ->
      if is_obj_name defs rt && possible_type defs abs rt then Cons (rt, []) else [];

  // One field of one `__Type`. This is where the laziness lives: a wrapper answers
  // `ofType` with another `GTypeRef` and the recursion goes exactly as deep as the
  // query asked.
  let intro_type_field = fn (defs, t: gtype, name: str) ->
    match t with
    | TyList inner ->
      if str_eq name "kind" then GStr "LIST"
      else if str_eq name "ofType" then GTypeRef inner
      else GNull
    | TyNonNull inner ->
      if str_eq name "kind" then GStr "NON_NULL"
      else if str_eq name "ofType" then GTypeRef inner
      else GNull
    | TyNamed n ->
      let kind = intro_kind defs n in
      if str_eq name "kind" then GStr kind
      else if str_eq name "name" then GStr n
      else if str_eq name "description" then GNull
      else if str_eq name "ofType" then GNull
      else if str_eq name "specifiedByURL" then GNull
      else if str_eq name "fields" then
        (if str_eq kind "OBJECT" || str_eq kind "INTERFACE" then
           GList (list_map (find_obj_or_iface defs n) intro_field)
         else GNull)
      else if str_eq name "inputFields" then
        (match find_tsdef defs n with
         | [InputDef (_, _, _, ivs), ..._] -> GList (list_map ivs intro_input)
         | _ -> GNull)
      else if str_eq name "enumValues" then
        (match find_tsdef defs n with
         | [EnumDef (_, _, _, vs), ..._] -> GList (list_map vs intro_enumval)
         | _ -> GNull)
      else if str_eq name "interfaces" then
        (match find_tsdef defs n with
         | [ObjectDef (_, _, ifs, _, _), ..._] ->
           GList (list_map ifs (fn (i: str) -> GTypeRef (TyNamed i)))
         | [InterfaceDef (_, _, ifs, _, _), ..._] ->
           GList (list_map ifs (fn (i: str) -> GTypeRef (TyNamed i)))
         | _ -> GNull)
      else if str_eq name "possibleTypes" then
        (match find_tsdef defs n with
         | [InterfaceDef (_, _, _, _, _), ..._] -> GList (implementors_of defs n)
         | [UnionDef (_, _, _, members), ..._] ->
           GList (list_map members (fn (m: str) -> GTypeRef (TyNamed m)))
         | _ -> GNull)
      else if str_eq name "isOneOf" then
        (if str_eq kind "INPUT_OBJECT" then GBool false else GNull)
      else
        fail ("graphql: __Type has no field '" ++ name ++ "'");

  let intro_directive = fn (d: gtsdef) ->
    match d with
    | DirectiveDef (_, n, args, rep, locs) ->
      GObj ([("name", GStr n),
            ("description", GNull),
            ("isRepeatable", GBool rep),
            ("locations", GList (list_map locs (fn (l: str) -> GStr l))),
            ("args", GList (list_map args intro_input)),
            ("isDeprecated", GBool false),
            ("deprecationReason", GNull)])
    | _ -> fail "graphql: intro_directive on something that is not a directive";

  let rec all_directives = fn (defs, acc) ->
    match defs with
    | [] -> rev_list acc []
    | [d, ...rest] ->
      match d with
      | TsDef (DirectiveDef (a, b, c, e, f)) ->
        all_directives rest (Cons (intro_directive (DirectiveDef (a, b, c, e, f)), acc))
      | _ -> all_directives rest acc;

  // A root operation type is reported only if it EXISTS. `mutationType` is null on
  // a schema with no mutations, and reporting a `__Type` for a type nobody declared
  // would make `buildClientSchema` fail on the other side rather than disagree.
  let root_or_null = fn (defs, n: str) ->
    if is_declared defs n then GTypeRef (TyNamed n) else GNull;

  let intro_schema = fn (defs) ->
    GObj ([("description", GNull),
          ("types", GList (list_map (all_type_names defs)
                                    (fn (n: str) -> GTypeRef (TyNamed n)))),
          ("queryType", GTypeRef (TyNamed (schema_query defs))),
          ("mutationType", root_or_null defs (schema_root defs "mutation" "Mutation")),
          ("subscriptionType",
             root_or_null defs (schema_root defs "subscription" "Subscription")),
          ("directives", GList (all_directives defs []))]);

  // --- leaf coercion ------------------------------------------------------
  // The messages are graphql-js's, verbatim, for the cases here. That couples this
  // to the reference implementation's wording, which is the useful direction for a
  // differential gate: the specification does not fix the prose, so matching the
  // oracle is the only way to compare messages at all — and the oracle's version
  // is pinned and printed by the harness.
  let show_gv = fn (v: gvalue) ->
    match v with
    | GNull -> "null"
    | GBool b -> if b then "true" else "false"
    | GInt n -> str_of_int n
    | GFloat f -> str_of_float f
    | GStr s -> "\"" ++ s ++ "\""
    | _ -> "value";


  let coerce_leaf = fn (defs, tyname: str, v: gvalue, path) ->
    match v with
    | GNull -> GOk (GNull, [])
    | _ ->
      if str_eq tyname "Int" then
        match v with
        | GInt n -> GOk (GInt n, [])
        | GStr s -> GOk (GInt (int_of_str s), [])
        | GFloat f ->
          if f == float_of_int (int_of_float f) then GOk (GInt (int_of_float f), [])
          else GOk (GNull, Cons (GErr ("Int cannot represent non-integer value: "
                                      ++ str_of_float f, path), []))
        | _ -> fail "graphql: unsupported coercion to Int"
      else if str_eq tyname "Float" then
        match v with
        | GFloat f -> GOk (GFloat f, [])
        | GInt n -> GOk (GFloat (float_of_int n), [])
        | _ -> fail "graphql: unsupported coercion to Float"
      else if str_eq tyname "String" || str_eq tyname "ID" then
        match v with
        | GStr s -> GOk (GStr s, [])
        | GInt n -> GOk (GStr (str_of_int n), [])
        | _ -> fail "graphql: unsupported coercion to String"
      else if str_eq tyname "Boolean" then
        match v with
        | GBool b -> GOk (GBool b, [])
        | _ -> fail "graphql: unsupported coercion to Boolean"
      else if is_enum_name defs tyname then
        match v with
        | GStr s ->
          if enum_has (find_enum defs tyname) s then GOk (GStr s, [])
          else GOk (GNull, Cons (GErr ("Enum \"" ++ tyname ++ "\" cannot represent value: "
                                      ++ "\"" ++ s ++ "\"", path), []))
        | _ -> fail ("graphql: unsupported coercion to enum " ++ tyname)
      else fail ("graphql: no coercion for leaf type " ++ tyname);

  let rec ty_name_of = fn (t: gtype) ->
    match t with
    | TyNamed n -> n
    | TyList inner -> ty_name_of inner
    | TyNonNull inner -> ty_name_of inner;

  // --- execution ----------------------------------------------------------
  //
  // `complete` and `exec_fields` are mutually recursive because a field's value
  // may be an object whose fields are values. `label` is the "Type.field" a
  // non-null violation names, and it has to be threaded because the message is
  // written where the field is known, not where the constraint is checked.
  // NULLABILITY BELONGS TO THE POSITION, AND ABSORPTION HAS TO HAPPEN THERE.
  //
  // The first version absorbed a bubble in the object and list arms, which is
  // right for a nullable position and wrong inside a `!`. `{ o2 { nnx } }` with
  // `o2: O!` then produced TWO errors — the real one about `O.nnx` and an invented
  // one about `Query.o2` — where the oracle produces one. When a non-null position
  // is null BECAUSE AN ERROR ALREADY PROPAGATED, no second error is raised: the
  // check that would raise it is never reached, because the propagation went past.
  //
  // So the two jobs are split. `raw` completes a position without any absorbing,
  // and `complete` decides what the position's nullability means:
  //
  //   TyNonNull inner  — take `raw inner`; a bubble passes through UNCHANGED, and
  //                      only a plain null becomes the "cannot return null" error
  //   anything else    — take `raw` of it; a bubble is absorbed into null here
  //
  // A list ITEM goes through `complete inner`, so `[O]` nulls the item and `[O!]`
  // nulls the list. That falls out rather than being special-cased.
  let rec raw = fn (defs, t: gtype, v: gvalue, sels, vars, path, label: str) ->
    match t with
    | TyNonNull inner -> complete defs inner v sels vars path label
    | TyList inner ->
      (match v with
       | GNull -> GOk (GNull, [])
       | GList items ->
         let rec go = fn (xs, i: int, acc, errs) ->
           match xs with
           | [] -> GOk (GList (rev_list acc []), errs)
           | [x, ...rest] ->
             let ip = appl path (Cons (PIdx i, [])) in
             (match complete defs inner x sels vars ip label with
              | GBubble e2 -> GBubble (appl errs e2)
              | GOk (xv, e2) -> go rest (i + 1) (Cons (xv, acc)) (appl errs e2)) in
         go items 0 [] []
       | _ -> fail "graphql: a list field resolved to something that is not a list")
    | TyNamed n ->
      if is_obj_name defs n then
        (match v with
         | GNull -> GOk (GNull, [])
         | _ -> exec_fields defs n v sels vars path)
      // AN ABSTRACT POSITION RESOLVES FIRST, THEN SELECTS. The error is a `GBubble`,
      // which is what makes the nullability fall out instead of being special-cased:
      // a nullable `n: Node` absorbs it into `"n": null`, and a `nn: Node!` passes it
      // on and nulls its parent. Both match the oracle without either being written.
      else if is_abstract_name defs n then
        (match v with
         | GNull -> GOk (GNull, [])
         | _ ->
           match abstract_ok defs n v with
           | [] -> GBubble (abstract_type_error defs n label v path)
           | [rt, ..._] -> exec_fields defs rt v sels vars path)
      else coerce_leaf defs n v path
  and complete = fn (defs, t: gtype, v: gvalue, sels, vars, path, label: str) ->
    match t with
    | TyNonNull inner ->
      (match raw defs inner v sels vars path label with
       | GBubble errs -> GBubble errs
       | GOk (x, errs) ->
         match x with
         | GNull ->
           GBubble (appl errs
             (Cons (GErr ("Cannot return null for non-nullable field " ++ label ++ ".",
                          path), [])))
         | _ -> GOk (x, errs))
    | _ ->
      (match raw defs t v sels vars path label with
       | GBubble errs -> GOk (GNull, errs)
       | GOk (x, errs) -> GOk (x, errs))
  and exec_fields = fn (defs, tname: str, v: gvalue, sels, vars, path) ->
    // Selections are flattened in order: a fragment contributes its fields where
    // the spread appears. Duplicate response keys are NOT merged — that needs
    // field-set merging, and the harness's corpus does not contain a case where
    // the difference shows, which is stated rather than left to be discovered.
    let rec go = fn (ss, acc, errs) ->
      match ss with
      | [] -> GOk (GObj (rev_list acc []), errs)
      | [s, ...rest] ->
        match s with
        | Field (alias, name, fargs, dirs, sub) ->
          if not (included dirs vars) then go rest acc errs
          else
            let key = if str_eq alias "" then name else alias in
            if str_eq name "__typename" then
              go rest (Cons ((key, GStr tname), acc)) errs
            // `__schema` and `__type` are provided BY THE SCHEMA rather than
            // declared in it, so they are handled beside `__typename` instead of
            // being injected into the user's Query type. Both are only legal on the
            // query root, and asking for them elsewhere is a field that does not
            // exist — which is what the branch below already reports.
            else if str_eq name "__schema" && str_eq tname (schema_query defs) then
              (match complete defs (TyNonNull (TyNamed "__Schema")) (intro_schema defs)
                       sub vars (appl path (Cons (PName key, []))) "Query.__schema" with
               | GBubble e2 -> GBubble (appl errs e2)
               | GOk (cv, e2) -> go rest (Cons ((key, cv), acc)) (appl errs e2))
            else if str_eq name "__type" && str_eq tname (schema_query defs) then
              // An unknown name answers null, which is what the oracle does; it is
              // not an error.
              let tn = match arg_of fargs "name" with
                       | [] -> fail "graphql: __type requires a 'name' argument"
                       | [av, ..._] -> (match doc_value av vars with
                                        | GStr sv -> sv
                                        | _ -> fail "graphql: __type's 'name' must be a string") in
              // `is_declared` is not the test: a built-in scalar has no definition
              // and is still a type. `all_type_names` is the schema's type list, so
              // asking it is asking the same question `__schema.types` answers.
              let tv = if list_member (all_type_names defs) tn
                       then GTypeRef (TyNamed tn) else GNull in
              (match complete defs (TyNamed "__Type") tv
                       sub vars (appl path (Cons (PName key, []))) "Query.__type" with
               | GBubble e2 -> GBubble (appl errs e2)
               | GOk (cv, e2) -> go rest (Cons ((key, cv), acc)) (appl errs e2))
            else
              (match field_ty_in (find_obj_or_iface defs tname) name with
               | [] -> fail ("graphql: " ++ tname ++ " has no field '" ++ name ++ "'")
               | [fty, ..._] ->
                 // A `GTypeRef` computes its fields instead of carrying them — see
                 // the constructor's comment for why introspection cannot be data.
                 let fv0 = match v with
                           | GTypeRef tr -> intro_type_field defs tr name
                           | _ -> resolve v name in
                 // `includeDeprecated` DEFAULTS TO FALSE, and the four fields that
                 // take it are the four the specification gives it to: `fields`,
                 // `enumValues`, `inputFields` and `args`.
                 //
                 // Filtered here, in one place, rather than at the four producers —
                 // because two of them build a `GObj` (a `__Field`'s `args`) and two
                 // answer from a `GTypeRef`, so filtering at the source would mean
                 // the same rule written twice in two different shapes.
                 //
                 // The standard introspection query passes `includeDeprecated: true`,
                 // so every section that uses it agreed while this was missing. It
                 // took a hand-written `__type(name: "Colour") \{ enumValues }` — no
                 // argument, hence the default — to disagree.
                 let fv1 = if str_starts_with tname "__" && deprecatable name
                           then filter_deprecated fv0 (include_deprecated fargs vars)
                           else fv0 in
                 // A field whose value is a FUNCTION is applied to its coerced
                 // arguments here — the one place resolution stops being a lookup.
                 let fv = match fv1 with
                          | GFn rf ->
                            rf (coerce_args
                                  (arg_defs_of (find_obj_or_iface defs tname) name)
                                  fargs vars)
                          | _ -> fv1 in
                 let fpath = appl path (Cons (PName key, [])) in
                 let lbl = tname ++ "." ++ name in
                 match complete defs fty fv sub vars fpath lbl with
                 | GBubble e2 -> GBubble (appl errs e2)
                 | GOk (cv, e2) -> go rest (Cons ((key, cv), acc)) (appl errs e2))
        | Spread (fname, dirs) ->
          if not (included dirs vars) then go rest acc errs
          else
            (match find_frag defs fname with
             | [] -> fail ("graphql: no fragment named '" ++ fname ++ "'")
             | [(tc, fsels), ..._] ->
               if cond_matches defs tname tc then
                 match go fsels acc errs with
                 | GBubble e2 -> GBubble e2
                 | GOk (GObj inner, e2) -> go rest (rev_list inner []) e2
                 | GOk (_, e2) -> go rest acc e2
               else go rest acc errs)
        | Inline (tc, dirs, isels) ->
          if not (included dirs vars) then go rest acc errs
          else if cond_matches defs tname tc then
            (match go isels acc errs with
             | GBubble e2 -> GBubble e2
             | GOk (GObj inner, e2) -> go rest (rev_list inner []) e2
             | GOk (_, e2) -> go rest acc e2)
          else go rest acc errs in
    go sels [] [];

  // --- the response -------------------------------------------------------
  //
  // Variable defaults are applied for a variable the caller did not supply, which
  // is what makes `query Q($v: Boolean = true)` behave without one.
  let rec with_defaults = fn (vardefs, vars) ->
    match vardefs with
    | [] -> vars
    | [vd, ...rest] ->
      match vd with
      | VarDef (n, _, dflt, _) ->
        let have = has_var vars n in
        (match dflt with
         | [d, ..._] ->
           if have then with_defaults rest vars
           else with_defaults rest (Cons ((n, doc_value d vars), vars))
         | [] -> with_defaults rest vars);

  // --- serialising --------------------------------------------------------
  //
  // JSON prints an integral float without its fraction — `1`, not `1.0` — and
  // `str_of_float` prints `1.0`. So the trailing `.0` comes off, or every Float
  // field differs from the oracle for a reason that has nothing to do with GraphQL.
  let float_json = fn (f: float) ->
    let s = str_of_float f in
    if str_ends_with s ".0" then str_replace s ".0" "" else s;

  let rec esc_at = fn (s: str, i: int, buf) ->
    if i >= str_len s then strbuf_to_str buf
    else
      let c = char_at s i in
      let b = ord c in
      let _ =
        if c == "\"" then strbuf_push buf "\\\""
        else if c == "\\" then strbuf_push buf "\\\\"
        else if c == "\n" then strbuf_push buf "\\n"
        else if b == 13 then strbuf_push buf "\\r"
        else if b == 9 then strbuf_push buf "\\t"
        else strbuf_push buf c in
      esc_at s (i + 1) buf;

  let jstr = fn (s: str) -> "\"" ++ esc_at s 0 (strbuf_new ()) ++ "\"";

  let rec to_json = fn (v: gvalue) ->
    match v with
    | GNull -> "null"
    | GBool b -> if b then "true" else "false"
    | GInt n -> str_of_int n
    | GFloat f -> float_json f
    | GStr s -> jstr s
    // A `GTypeRef` here means a `__Type` was asked for WITHOUT a selection of
    // subfields — `\{ __type(name: "Query") }`. graphql-js reports that as a
    // validation error before execution starts; there is no validator here, so it
    // is named at the point it becomes unanswerable rather than left as a
    // non-exhaustive match.
    | GTypeRef _ ->
      fail "graphql: a field of type __Type must have a selection of subfields"
    // Unreachable through `exec_fields`, which applies a `GFn` before completing the
    // field. It is here because a resolver may RETURN one, and a function is not a
    // value a response can carry.
    | GFn _ ->
      fail "graphql: a resolver returned a function, which is not a serialisable value"
    | GList xs -> "[" ++ str_join "," (list_map xs to_json) ++ "]"
    | GObj fs ->
      "\{" ++ str_join "," (list_map fs (fn (kv) ->
        let (k, x) = kv in jstr k ++ ":" ++ to_json x)) ++ "}";

  let path_json = fn (p) ->
    "[" ++ str_join "," (list_map p (fn (e: gpath) ->
      match e with | PName n -> jstr n | PIdx i -> str_of_int i)) ++ "]";

  let err_json = fn (e: gerr) ->
    match e with
    | GErr (msg, p) -> "\{" ++ jstr "message" ++ ":" ++ jstr msg
                       ++ "," ++ jstr "path" ++ ":" ++ path_json p ++ "}";

  // graphql-js puts `errors` BEFORE `data`, and the response's field order is
  // observable, so this matches rather than sorting.
  let response_json = fn (r: gout) ->
    match r with
    | GOk (v, errs) ->
      (match errs with
       | [] -> "\{" ++ jstr "data" ++ ":" ++ to_json v ++ "}"
       | _ -> "\{" ++ jstr "errors" ++ ":[" ++ str_join "," (list_map errs err_json)
              ++ "]," ++ jstr "data" ++ ":" ++ to_json v ++ "}")
    | GBubble errs ->
      "\{" ++ jstr "errors" ++ ":[" ++ str_join "," (list_map errs err_json)
      ++ "]," ++ jstr "data" ++ ":null}";

  // THE INTROSPECTION SCHEMA IS APPENDED TO THE DOCUMENT'S OWN DEFINITIONS, and
  // that one line is what makes introspection need no second executor: `__Type` is
  // an object type like any other from here on, so field lookup, nullability, null
  // propagation, list handling and enum coercion all apply to it unchanged.
  //
  // Appended rather than prepended, so a document's own definitions are found first
  // — the built-in directives are `@skip` / `@include` / `@deprecated` /
  // `@specifiedBy` / `@oneOf`, and a schema is free to redeclare one.
  let with_introspection = fn (defs) ->
    appl defs (Gparse.document Gintro.sdl);

  let run = fn (defs0, root: gvalue, vars) ->
    let defs = with_introspection defs0 in
    let (vardefs, sels) = first_op defs in
    let vars2 = with_defaults vardefs vars in
    exec_fields defs (schema_query defs) root sels vars2 [];

  let run_json = fn (defs, root: gvalue, vars) -> response_json (run defs root vars);
}
