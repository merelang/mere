// contrib/graphql/lexer.mere — GraphQL source text into tokens.
//
// GraphQL's lexical grammar is small but it has three parts that are easy to get
// subtly wrong, and each of them is a place where a wrong answer still parses:
//
//  1. COMMAS ARE IGNORED, exactly like whitespace. `{a,b}` and `{a b}` are the
//     same document. A lexer that treats a comma as a separator will accept
//     `{a,,b}` and `{,a}` too — which is correct here, and is worth knowing is
//     correct rather than discovering by accident.
//
//  2. A NUMBER'S SHAPE DECIDES ITS KIND. `1` is an IntValue and `1.0`, `1e2`,
//     `1.0e2` are FloatValues. The distinction survives into the AST, so a lexer
//     that returns "number" loses information the printer needs back.
//
//  3. A BLOCK STRING IS DEDENTED BY ITS OWN RULE. The common indentation of
//     every line after the first is removed, leading and trailing blank lines
//     go, and the only escape is `\"""`. Applying the plain-string escape rules
//     to a block string turns `\n` inside it into a newline that was never there.
//
// Usage:
//   import "contrib/graphql/lexer.mere";
//   Glex.tokens "{ a b }"        // (int * gtok) list, ending in TEof

module Glex {

  let is_name_start = fn (c: str) -> is_alpha c || c == "_";
  let is_name_cont = fn (c: str) -> is_alpha c || is_digit c || c == "_";

  // Commas and the UTF-8 BOM are ignorable, and a comment runs to the end of
  // the line. `is_space` covers space, tab, CR and LF.
  let rec skip = fn (s: str, i: int) ->
    if i >= str_len s then i
    else
      let c = char_at s i in
      if is_space c || c == "," then skip s (i + 1)
      else if c == "#" then
        let rec to_eol = fn (j: int) ->
          if j >= str_len s then j
          else if char_at s j == "\n" || char_at s j == "\r" then j
          else to_eol (j + 1) in
        skip s (to_eol (i + 1))
      else i;

  let rec take_while = fn (s: str, i: int, pred, buf) ->
    if i >= str_len s then (strbuf_to_str buf, i)
    else if pred (char_at s i) then
      let _ = strbuf_push buf (char_at s i) in
      take_while s (i + 1) pred buf
    else (strbuf_to_str buf, i);

  let read_name = fn (s: str, i: int) ->
    take_while s i is_name_cont (strbuf_new ());

  // A number, and which kind it is. The kind is decided by whether a fraction or
  // an exponent appeared — not by whether the value happens to be integral.
  let read_number = fn (s: str, i0: int) ->
    let buf = strbuf_new () in
    let i1 =
      if i0 < str_len s && char_at s i0 == "-" then
        let _ = strbuf_push buf "-" in i0 + 1
      else i0 in
    let (_, i2) = take_while s i1 is_digit buf in
    let (frac, i3) =
      if i2 < str_len s && char_at s i2 == "." then
        let _ = strbuf_push buf "." in
        let (_, j) = take_while s (i2 + 1) is_digit buf in
        (true, j)
      else (false, i2) in
    let (expo, i4) =
      if i3 < str_len s && (char_at s i3 == "e" || char_at s i3 == "E") then
        let _ = strbuf_push buf (char_at s i3) in
        let j0 =
          if i3 + 1 < str_len s
             && (char_at s (i3 + 1) == "+" || char_at s (i3 + 1) == "-") then
            let _ = strbuf_push buf (char_at s (i3 + 1)) in i3 + 2
          else i3 + 1 in
        let (_, j) = take_while s j0 is_digit buf in
        (true, j)
      else (false, i3) in
    let lex = strbuf_to_str buf in
    if frac || expo then (TFloat lex, i4) else (TInt lex, i4);

  // \uXXXX — four hex digits, emitted as UTF-8 by `str_of_codepoint`. Surrogate
  // pairs are not joined here; the specification's SourceCharacter rules make a
  // lone surrogate invalid input rather than something to repair.
  let hex_val = fn (c: str) ->
    if is_digit c then ord c - 48
    else if c >= "a" && c <= "f" then ord c - 87
    else if c >= "A" && c <= "F" then ord c - 55
    else fail ("graphql: bad hex digit in \\u escape: " ++ c);

  let rec read_str = fn (s: str, i: int, buf) ->
    if i >= str_len s then fail "graphql: unterminated string"
    else
      let c = char_at s i in
      if c == "\"" then (strbuf_to_str buf, i + 1)
      else if c == "\n" || c == "\r" then fail "graphql: newline in a string"
      else if c == "\\" then
        if i + 1 >= str_len s then fail "graphql: unterminated escape"
        else
          let e = char_at s (i + 1) in
          if e == "u" then
            if i + 5 >= str_len s then fail "graphql: truncated \\u escape"
            else
              let cp = hex_val (char_at s (i + 2)) * 4096
                     + hex_val (char_at s (i + 3)) * 256
                     + hex_val (char_at s (i + 4)) * 16
                     + hex_val (char_at s (i + 5)) in
              let _ = strbuf_push buf (str_of_codepoint cp) in
              read_str s (i + 6) buf
          else
            let d =
              if e == "\"" then "\""
              else if e == "\\" then "\\"
              else if e == "/" then "/"
              else if e == "b" then chr 8
              else if e == "f" then chr 12
              else if e == "n" then "\n"
              else if e == "r" then chr 13
              else if e == "t" then chr 9
              else fail ("graphql: unknown escape \\" ++ e) in
            let _ = strbuf_push buf d in
            read_str s (i + 2) buf
      else
        let _ = strbuf_push buf c in
        read_str s (i + 1) buf;

  // The raw body of a block string, up to the closing `"""`. The only escape is
  // `\"""`, which stands for a literal `"""` — every other backslash is itself.
  let rec read_block_raw = fn (s: str, i: int, buf) ->
    if i + 2 < str_len s && char_at s i == "\"" && char_at s (i + 1) == "\""
       && char_at s (i + 2) == "\"" then
      (strbuf_to_str buf, i + 3)
    else if i + 3 < str_len s && char_at s i == "\\" && char_at s (i + 1) == "\""
            && char_at s (i + 2) == "\"" && char_at s (i + 3) == "\"" then
      let _ = strbuf_push buf "\"\"\"" in
      read_block_raw s (i + 4) buf
    else if i >= str_len s then fail "graphql: unterminated block string"
    else
      let _ = strbuf_push buf (char_at s i) in
      read_block_raw s (i + 1) buf;

  // --- block string dedent (BlockStringValue in the specification) ----------
  // Common indentation is computed over every line EXCEPT the first, counting
  // only lines that have a non-whitespace character. Then blank leading and
  // trailing lines are dropped.

  let rec indent_of = fn (line: str, k: int) ->
    if k >= str_len line then 0 - 1                 // all whitespace: no opinion
    else if char_at line k == " " || char_at line k == "\t" then indent_of line (k + 1)
    else k;

  let rec common_indent = fn (lines, first: bool, best: int) ->
    match lines with
    | [] -> best
    | [l, ...rest] ->
      if first then common_indent rest false best
      else
        let n = indent_of l 0 in
        if n < 0 then common_indent rest false best
        else if best < 0 || n < best then common_indent rest false n
        else common_indent rest false best;

  let rec drop_chars = fn (line: str, n: int, k: int, buf) ->
    if k >= str_len line then strbuf_to_str buf
    else
      if k < n then drop_chars line n (k + 1) buf
      else
        let _ = strbuf_push buf (char_at line k) in
        drop_chars line n (k + 1) buf;

  let is_blank = fn (l: str) -> indent_of l 0 < 0;

  let rec drop_leading_blank = fn (lines) ->
    match lines with
    | [] -> []
    | [l, ...rest] -> if is_blank l then drop_leading_blank rest else lines;

  let rec rev_list = fn (xs, acc) ->
    match xs with
    | [] -> acc
    | [h, ...t] -> rev_list t (Cons (h, acc));

  let trim_blank_ends = fn (lines) ->
    let a = drop_leading_blank lines in
    let b = drop_leading_blank (rev_list a []) in
    rev_list b [];

  let rec dedent_all = fn (lines, n: int, first: bool, acc) ->
    match lines with
    | [] -> rev_list acc []
    | [l, ...rest] ->
      let out = if first then l else drop_chars l n 0 (strbuf_new ()) in
      dedent_all rest n false (Cons (out, acc));

  let block_value = fn (raw: str) ->
    // CRLF and CR both count as line terminators, so normalise before splitting.
    let norm = str_replace (str_replace raw (chr 13 ++ "\n") "\n") (chr 13) "\n" in
    let lines = str_split norm "\n" in
    let n = common_indent lines true (0 - 1) in
    let n2 = if n < 0 then 0 else n in
    str_join "\n" (trim_blank_ends (dedent_all lines n2 true []));

  // --- the punctuators -----------------------------------------------------
  // `...` is three characters and must be tried before `.`; there is no other
  // multi-character punctuator in GraphQL.
  let punct_at = fn (s: str, i: int) ->
    let c = char_at s i in
    if c == "." then
      if i + 2 < str_len s && char_at s (i + 1) == "." && char_at s (i + 2) == "." then
        Some ("...", i + 3)
      else fail "graphql: a lone '.' is not a token"
    else if c == "!" || c == "$" || c == "&" || c == "(" || c == ")" || c == ":"
         || c == "=" || c == "@" || c == "[" || c == "]" || c == "\{" || c == "}"
         || c == "|" then
      Some (c, i + 1)
    else None;

  let rec lex = fn (s: str, i0: int, acc) ->
    let i = skip s i0 in
    if i >= str_len s then rev_list (Cons ((i, TEof), acc)) []
    else
      let c = char_at s i in
      if is_name_start c then
        let (nm, j) = read_name s i in
        lex s j (Cons ((i, TName nm), acc))
      else if is_digit c || c == "-" then
        let (t, j) = read_number s i in
        lex s j (Cons ((i, t), acc))
      else if c == "\"" then
        if i + 2 < str_len s && char_at s (i + 1) == "\"" && char_at s (i + 2) == "\"" then
          let (raw, j) = read_block_raw s (i + 3) (strbuf_new ()) in
          lex s j (Cons ((i, TBlock (block_value raw)), acc))
        else
          let (v, j) = read_str s (i + 1) (strbuf_new ()) in
          lex s j (Cons ((i, TStr v), acc))
      else
        match punct_at s i with
        | Some (p, j) -> lex s j (Cons ((i, TPunct p), acc))
        | None -> fail ("graphql: unexpected character: " ++ c);

  let tokens = fn (s: str) -> lex s 0 [];
}
