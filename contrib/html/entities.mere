000000zopf;                           01d56b000000zscr;                           01d4cf000000zwj;                            00200d000000zwnj;                           00200c000000";

module Entities {
  let _hex4 = fn (s: str) -> fn (off: int) ->
    let d = fn (k: int) ->
      let c = char_at s (off + k) in
      if c >= "0" && c <= "9" then ord c - 48 else ord c - 87 in
    let rec go = fn (k: int) -> fn (acc: int) ->
      if k >= 6 then acc else go (k + 1) (acc * 16 + d k) in
    go 0 0;

  let _name_at = fn (i: int) ->
    str_trim (substring _ent_table (i * _ent_w) (i * _ent_w + 32));

  // The longest name that is a prefix of `cand`. The standard matches greedily —
  // `&notin;` is one reference and not `&not` followed by "in;" — so a search that
  // stopped at the first match would be a different tokenizer.
  //
  // Names are searched longest-first because a binary search answers "is this
  // exact string here", and the question is "which of my prefixes is here".
  let longest_match = fn (cand: str) ->
    let find = fn (want: str) ->
      let rec bs = fn (lo: int) -> fn (hi: int) ->
        if lo >= hi then 0 - 1
        else
          let mid = (lo + hi) / 2 in
          let nm = _name_at mid in
          if nm == want then mid
          else if nm < want then bs (mid + 1) hi
          else bs lo mid in
      bs 0 _ent_n in
    let rec try_len = fn (l: int) ->
      if l <= 0 then (0 - 1, 0)
      else if l > str_len cand then try_len (str_len cand)
      else
        let idx = find (substring cand 0 l) in
        if idx >= 0 then (idx, l) else try_len (l - 1) in
    try_len 32;

  // The characters a record stands for. One code point, or two.
  let chars_at = fn (idx: int) ->
    let a = _hex4 _ent_table (idx * _ent_w + 32) in
    let b = _hex4 _ent_table (idx * _ent_w + 38) in
    if b == 0 then str_of_codepoint a
    else str_of_codepoint a ++ str_of_codepoint b;
}
