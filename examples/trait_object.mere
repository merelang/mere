// Trait objects (`dyn Trait`) — a heterogeneous collection of values that all
// implement a trait, with dynamic dispatch. `dyn Shape (Circ 2)` packs a value
// into a `dyn Shape`; a trait method called on a `dyn Shape` (`area o`) is
// dispatched dynamically. Under the hood a `dyn Trait` is a record of
// self-capturing closures (auto-generated by the elaborator), so it needs no
// special backend support and works on interp / C / LLVM / Wasm alike.
//
// Object-safety: a trait supports `dyn` only if every method takes the trait
// parameter as its single `self` argument and does not otherwise mention it
// (so `area : 'a -> int` is fine; `eq : 'a -> 'a -> bool` is not).
trait Shape 'a { area : 'a -> int; name : 'a -> str; }

type circ = Circ of int;      // radius (area uses r*r*3)
type rect = Rect of int;      // side   (area uses w*w)
impl Shape circ { area = fn s -> (match s with Circ r -> r * r * 3); name = fn s -> "circle"; }
impl Shape rect { area = fn s -> (match s with Rect w -> w * w);     name = fn s -> "square"; }

// A heterogeneous list: circles and squares side by side, all `dyn Shape`.
let shapes = [dyn Shape (Circ 2), dyn Shape (Rect 3), dyn Shape (Circ 1)];

// A consumer over trait objects: annotate the parameter as `dyn Shape` (a
// function inferred as `Shape 'a => ...` would instead expect a concrete
// dictionary-carrying value, not an object).
let describe = fn (o : dyn Shape) -> name o ++ "(" ++ str_of_int (area o) ++ ") ";

let total_area = fn (os : (dyn Shape) list) ->
  list_fold os 0 (fn acc -> fn o -> acc + area o);

let _ = print (list_fold shapes "" (fn acc -> fn o -> acc ++ describe o)) in
print ("total area = " ++ str_of_int (total_area shapes))
