// examples/plugin/host.mere — the side of the boundary that has to keep
// running.
//
// The host loads plugins written by somebody else and must survive all of
// them: the one that never returns, the one that allocates until the
// machine complains, the one that asks for the filesystem, the one that
// calls a builtin with the wrong type, the one that does not parse.
//
// The plugin runs as a CHILD, and the boundary is a process. An earlier version
// of this comment said that was forced -- that Mere has no way to recover from
// `fail`. THAT WAS WRONG. `try_or : (unit -> 'a) -> 'a -> 'a` catches
// `Eval_error` on all four backends and is documented in stdlib-reference.md,
// and wrapping `parse_and_eval` in it does survive the corpus in-process: the
// type error, the parse error and the unbound name are all caught and the host
// goes on to the next plugin.
//
// What survives of the reason for a process is narrower and still holds:
//
//   `try_or` returns a DEFAULT, not the message. A host built on it learns that
//   a plugin failed and nothing about why -- no `unbound variable: write_file`,
//   which is the line this host reports and acts on.
//
//   `try_or` does not stop a plugin that does not stop. loops_forever and
//   allocates_without_end are unaffected by it and need the OS either way.
//
// So the boundary is a process to keep the diagnostic and to bound the runaway,
// not because failure could not be survived.
//
// Two things here are the shell's rather than Mere's, and that is the point
// of the file. `ulimit -t` bounds the plugin's CPU because the language has
// no step budget and no cap on a region. And the child's output comes back
// through files because `run` returns a status and nothing else -- the
// capability that returns a child's stdout, `subprocess_run`, exists only on
// the Node host, so no native program can have it.
//
// Usage:
//   MERE=<mere binary> mere examples/plugin/host.mere <plugin.mere>...

let mere_bin =
  match env_var "MERE" with
    | Some v -> v
    | None -> "mere"
  in

let cpu_seconds = "2" in

// What this host hands a plugin. Two names, written down in one place, passed
// to the runner rather than compiled into it -- the point of saying it out loud
// is that a request for anything else can be named as such.
let granted = "print,show" in
let out_path = "/tmp/mere_plugin_out.txt" in
let err_path = "/tmp/mere_plugin_err.txt" in
let val_path = "/tmp/mere_plugin_value.txt" in

// What the child's exit status means. A plugin that returns is the only case
// with a value; every other line is the host still standing.
//
// `st > 128` is the shell's convention for a signalled child, and it is a
// convention rather than a fact -- a program is free to exit(137). It is also
// the reason this file found Q-088: under the interpreter `run` used to answer
// 101 for a plugin killed at its CPU limit, which lands in the last branch.
//
// `3` is the runner's, and it is the verdict this host most wants: the plugin
// asked for something it was not granted, and that was decided by reading it
// rather than by running it, so the answer covers branches the plugin would
// never have taken.
let verdict = fn (st: int) -> fn (out: str) -> fn (err: str) ->
  if st == 0 then "returned   " ++ str_trim out
  else if st == 3 then "denied     " ++ str_trim err
  else if st > 128 then "stopped    killed by signal " ++ str_of_int (st - 128)
  else "refused    " ++ str_trim err
  in

// What the plugin PRINTED, which is not what it returned. Keeping the two
// apart is why runner.mere writes the value to its own path instead of to
// stdout: a plugin that prints is not thereby returning anything.
//
// The last line is dropped because it is not the plugin's. A Mere program
// prints the value of its main expression, so the runner signs off with `()`
// on the same stream the plugin has been writing to, and there is no way for
// it not to.
let strip_runners_own_line = fn (s: str) ->
  let t = str_trim s in
  if str_ends_with t "()" then str_trim (substring t 0 (str_len t - 2)) else t
  in

let printed = fn (out: str) ->
  let p = strip_runners_own_line out in
  if str_len p == 0 then "" else "  [printed: " ++ p ++ "]"
  in

let call = fn (path: str) ->
  // `exec 2>/dev/null` first, because the shell that waits on the plugin
  // announces "Cputime limit exceeded" on ITS stderr, which is the host's --
  // the host reports the deaths here, in its own words. The plugin's own stderr
  // is redirected separately below and survives this.
  //
  // An earlier version wrote `exec mere` instead, so that no shell of ours was
  // left to announce anything. That one word is what exposed Q-088: with no
  // shell in between, `run` reported the death itself, and reported it wrong.
  let cmd = "exec 2>/dev/null; ulimit -t " ++ cpu_seconds ++ "; " ++ mere_bin
            ++ " examples/plugin/runner.mere " ++ path ++ " " ++ val_path
            ++ " " ++ granted
            ++ " > " ++ out_path ++ " 2> " ++ err_path in
  let _ = run ("rm -f " ++ val_path) in
  let st = run cmd in
  // Only a plugin that returned leaves a value behind; reading a file that
  // is not there would end the host, which is the failure this file exists
  // to avoid.
  let value = if file_exists val_path then read_file val_path else "" in
  let out = read_file out_path in
  let err = read_file err_path in
  print (path ++ "  ->  " ++ verdict st value err ++ printed out)
  in

let rec each = fn (xs: str list) ->
  match xs with
    | Nil -> ()
    | Cons (x, rest) -> let _ = call x in each rest
  in

let argv = args () in
let _ =
  match argv with
    | Nil -> print "usage: host <plugin.mere>..."
    | _ -> each argv
  in
0
