// parallel_compute: data-parallel fan-out / fan-in (the CPU-parallel workload)
//
// The interpreter and native C / LLVM backends use native threads. The Node
// Wasm host uses workers over shared memory; RISC-V uses coroutine-based green
// threads. Parallel execution depends on the backend and host. See
// docs/memory-model.md for the sharing rules and runtime coverage limits.
//
// Here four workers each fold a CPU-heavy function over their share of the
// work and post a partial sum to a channel; the main thread sums the four
// partials. A multicore host can run the workers in parallel; scheduling and
// communication overhead determine the speedup.

let rec fib = fn n -> if n < 2 then n else fib (n - 1) + fib (n - 2);

// One worker's share: sum fib(28) over `count` iterations (a CPU-work proxy).
// A single argument keeps the worker call free of an intermediate curried
// closure. The Node Wasm host gives each worker a separate allocation range.
let rec partial = fn count ->
  if count < 1 then 0 else fib 28 + partial (count - 1);

// The program's result is the combined total — 4 workers *
// 10 * fib(28) = 40 * 317811 = 12712440.
let results = channel_new () in
// Fan out: four workers, each on its own thread. They share `results` and
// `partial` (both Sync), so nothing is moved.
let h1 = spawn (fn u -> channel_send results (partial 10)) in
let h2 = spawn (fn u -> channel_send results (partial 10)) in
let h3 = spawn (fn u -> channel_send results (partial 10)) in
let h4 = spawn (fn u -> channel_send results (partial 10)) in
// Join before receiving: a worker that failed would otherwise leave the
// receives below waiting for a message it will never send (since v0.1.586 a
// thread's failure does not end the program). Joined, it is raised here.
let _ = join h1 in
let _ = join h2 in
let _ = join h3 in
let _ = join h4 in
// Fan in: collect the four partials and combine.
let r1 = channel_recv results in
let r2 = channel_recv results in
let r3 = channel_recv results in
let r4 = channel_recv results in
r1 + r2 + r3 + r4
