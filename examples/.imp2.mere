import "../contrib/proto/descriptor.mere";
let rec arg_at = fn (xs, k: int, d: str) -> match xs with [] -> d | [h,...t] -> if k==0 then h else arg_at t (k-1) d;
let a = args ();
let dir = arg_at a 0 "";
let tgt = arg_at a 1 "";
let load = fn (n: str) -> (n, read_file (dir ++ "/" ++ n));
let deps = list_map (list_drop a 2) load;
print (hex_of_bytes (Pdesc.of_sources tgt (read_file (dir ++ "/" ++ tgt)) deps))
