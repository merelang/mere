// examples/profile/app.mere — a settings form that knows what you changed.
//
// The three browser clients before this one were lists. A list is edited
// one item at a time, every keystroke is worth acting on, and the only
// question the UI ever asks is "what is on screen". A form is a different
// animal: it is a set of fields with a shape. It is valid or it is not.
// It differs from what was loaded or it does not. Answering either
// question means holding two versions of the same record at once — what
// the server gave you, and what the user has done to it since — and
// comparing them.
//
// That is the point of this example. The state here is not a list that
// grows; it is a small structured value with a history of exactly one
// step, and every interaction reads it, derives something from it, and
// writes a modified copy back.
//
// It also needs controls a list does not. `input` fires for text as it is
// typed, but a <select> produces no keystrokes and a checkbox has no
// value — it has a checked-ness. And validating on every keystroke scolds
// you in the middle of typing your own email address, so the check has to
// happen when you leave the field and be taken back down when you return
// to fix it. contrib/dom v0.1.170 (blur / focus / change / checked /
// removeAttribute) is what this app forced.
//
// Build:
//   mere -w examples/profile/app.mere > /tmp/profile_app.wat
//   wat2wasm --enable-tail-call /tmp/profile_app.wat -o examples/profile/app.wasm
//
// Verify without a browser:
//   node scripts/run_dom_headless.mjs examples/profile/app.wasm \
//     http://localhost:8080 --type name=Ada --fire name:blur --wait 300

import "../../contrib/dom/dom.mere";

type Profile = { name: str, email: str, bio: str, theme: str, notify: bool };

// A field, described once and then used generically: painted, compared,
// validated and reverted by the same code. Without the get/set pair there
// is no way to say "this field" as a value — a record field cannot be
// named at runtime — and every one of those loops would have to be
// written out five times.
type Field = {
  id: str,
  label: str,
  get: Profile -> str,
  set: Profile -> str -> Profile,
  check: str -> str          // "" when the value is acceptable
};

// ---- state ----------------------------------------------------------
//
// Mere has no mutable cell, so state is one slot of a vec allocated once;
// the arena is page-lifetime, so it survives across event firings. This
// app holds three of them, and the interesting one is the pair:
//
//   saved    what the server last confirmed
//   current  what the user has done since
//
// Nearly everything on screen is derived from the difference between
// those two. "3 unsaved changes" is a comparison. Whether Save is enabled
// is a comparison. Revert is an assignment of one to the other. Keeping
// the pair is what makes those one-liners instead of bookkeeping.

let blank = Profile {
  name = "", email = "", bio = "", theme = "system", notify = false
} in

let saved = vec_new () in
let _ = vec_push saved blank in
let current = vec_new () in
let _ = vec_push current blank in
// (field id, message) for every field currently complaining. An assoc
// list rather than a record so the generic loops keep working: a record
// of errors would need its own five getters and setters.
let errors = vec_new () in
let _ = vec_push errors Nil in

let status_el = dom_get_by_id "status" in
let summary_el = dom_get_by_id "summary" in
let save_btn = dom_get_by_id "save" in
let revert_btn = dom_get_by_id "revert" in
let notify_box = dom_get_by_id "notify" in

let set_status = fn (s: str) -> dom_set_text status_el s in

// ---- validation -----------------------------------------------------

let need = fn (label: str) -> fn (v: str) ->
  if str_eq (str_trim v) "" then label ++ " is required" else ""
in

let check_name = fn (v: str) ->
  let e = need "Name" v in
  if not (str_eq e "") then e
  else if str_len v > 40 then "Name is longer than 40 characters"
  else ""
in

let check_email = fn (v: str) ->
  let at = str_index_of v "@" in
  let e = need "Email" v in
  if not (str_eq e "") then e
  else if at < 1 || at >= str_len v - 1 then
    "Email needs an @ with something on both sides"
  else ""
in

let check_bio = fn (v: str) ->
  if str_len v > 200 then "Bio is longer than 200 characters" else ""
in

let check_none = fn (v: str) -> "" in

// ---- the fields -----------------------------------------------------

let fields =
  Cons (Field { id = "name", label = "Name",
                get = fn (p: Profile) -> p.name,
                set = fn (p: Profile) -> fn (v: str) -> { p | name = v },
                check = check_name },
  Cons (Field { id = "email", label = "Email",
                get = fn (p: Profile) -> p.email,
                set = fn (p: Profile) -> fn (v: str) -> { p | email = v },
                check = check_email },
  Cons (Field { id = "bio", label = "Bio",
                get = fn (p: Profile) -> p.bio,
                set = fn (p: Profile) -> fn (v: str) -> { p | bio = v },
                check = check_bio },
  Cons (Field { id = "theme", label = "Theme",
                get = fn (p: Profile) -> p.theme,
                set = fn (p: Profile) -> fn (v: str) -> { p | theme = v },
                check = check_none },
  Nil)))) in

// ---- assoc list helpers ---------------------------------------------

let rec assoc = fn (xs: (str * str) list) -> fn (k: str) ->
  match xs with
  | Nil -> ""
  | Cons ((key, v), rest) -> if str_eq key k then v else assoc rest k
in

let rec without = fn (xs: (str * str) list) -> fn (k: str) ->
  match xs with
  | Nil -> Nil
  | Cons ((key, v), rest) ->
    if str_eq key k then without rest k else Cons ((key, v), without rest k)
in

let rec any_error = fn (xs: (str * str) list) ->
  match xs with
  | Nil -> false
  | Cons ((_, v), rest) -> if str_eq v "" then any_error rest else true
in

// ---- painting -------------------------------------------------------

let show_error = fn (id: str) -> fn (msg: str) ->
  let el = dom_get_by_id ("err-" ++ id) in
  let _ = dom_set_text el msg in
  let input = dom_get_by_id id in
  if str_eq msg "" then dom_remove_attr input "aria-invalid"
  else dom_set_attr input "aria-invalid" "true"
in

let set_error = fn (id: str) -> fn (msg: str) ->
  let next =
    if str_eq msg "" then without (vec_get errors 0) id
    else Cons ((id, msg), without (vec_get errors 0) id) in
  let _ = vec_set errors 0 next in
  show_error id msg
in

// Count the fields whose current value differs from the saved one. This
// is the whole reason both records are kept: "unsaved changes" is not a
// flag anyone sets, it is a fact about two values.
let rec diff_count = fn (fs: Field list) -> fn (cur: Profile) -> fn (sav: Profile) ->
  match fs with
  | Nil -> if cur.notify == sav.notify then 0 else 1
  | Cons (f, rest) ->
    let d = if str_eq (f.get cur) (f.get sav) then 0 else 1 in
    d + diff_count rest cur sav
in

// Save is offered when there is something to save and nothing to fix.
// Both halves are derived, neither is stored.
let refresh_summary = fn (u: unit) ->
  let n = diff_count fields (vec_get current 0) (vec_get saved 0) in
  let bad = any_error (vec_get errors 0) in
  let _ = dom_set_text summary_el
    (if n == 0 then "No unsaved changes"
     else if n == 1 then "1 unsaved change"
     else show n ++ " unsaved changes") in
  let _ =
    if n == 0 || bad then dom_set_attr save_btn "disabled" "true"
    else dom_remove_attr save_btn "disabled" in
  if n == 0 then dom_set_attr revert_btn "disabled" "true"
  else dom_remove_attr revert_btn "disabled"
in

// Push a whole profile into the controls. Used on load and on revert —
// the two moments where the DOM is behind the state rather than ahead of
// it. Ordinary editing never calls this: the field the user is typing in
// is already correct, and writing to it would move the caret.
let rec paint_fields = fn (fs: Field list) -> fn (p: Profile) ->
  match fs with
  | Nil -> ()
  | Cons (f, rest) ->
    let _ = dom_set_value (dom_get_by_id f.id) (f.get p) in
    let _ = set_error f.id "" in
    paint_fields rest p
in

let paint = fn (p: Profile) ->
  let _ = paint_fields fields p in
  let _ = dom_set_checked notify_box p.notify in
  refresh_summary ()
in

// ---- server ---------------------------------------------------------

let split1 = fn (s: str) ->
  let i = str_index_of s "\t" in
  if i < 0 then (s, "") else (substring s 0 i, substring s (i + 1) (str_len s))
in

let rec parse_pairs = fn (xs: str list) ->
  match xs with
  | Nil -> Nil
  | Cons (line, rest) ->
    if str_eq line "" then parse_pairs rest
    else let (k, v) = split1 line in Cons ((k, v), parse_pairs rest)
in

let profile_of_pairs = fn (ps) ->
  Profile {
    name = assoc ps "name",
    email = assoc ps "email",
    bio = assoc ps "bio",
    theme = if str_eq (assoc ps "theme") "" then "system" else assoc ps "theme",
    notify = str_eq (assoc ps "notify") "1"
  }
in

let serialize = fn (p: Profile) ->
  "name\t" ++ p.name ++ "\n" ++
  "email\t" ++ p.email ++ "\n" ++
  "bio\t" ++ p.bio ++ "\n" ++
  "theme\t" ++ p.theme ++ "\n" ++
  "notify\t" ++ (if p.notify then "1" else "0") ++ "\n"
in

// The server validates too, and says which field it objected to. Its
// answer lands in the same error state the client's own checks use, so a
// rejection looks identical whichever side noticed.
let rec show_server_errors = fn (ps: (str * str) list) ->
  match ps with
  | Nil -> ()
  | Cons ((k, v), rest) -> let _ = set_error k v in show_server_errors rest
in

let load = fn (u: unit) ->
  dom_fetch_async "GET" "/api/profile" "" (fn (body: str) ->
    if dom_fetch_status () != 200 then set_status "could not load the profile"
    else
      let p = profile_of_pairs (parse_pairs (str_split body "\n")) in
      let _ = vec_set saved 0 p in
      let _ = vec_set current 0 p in
      let _ = paint p in
      set_status "loaded")
in

let save = fn (u: unit) ->
  let p = vec_get current 0 in
  let _ = set_status "saving…" in
  let _ = dom_fetch_header "Content-Type" "text/plain" in
  dom_fetch_async "POST" "/api/profile" (serialize p) (fn (body: str) ->
    let st = dom_fetch_status () in
    if st == 200 then
      // The save is what makes current the new baseline. Until this
      // line runs, every "unsaved changes" count on screen was true.
      let _ = vec_set saved 0 p in
      let _ = refresh_summary () in
      set_status "saved"
    else if st == 422 then
      let _ = show_server_errors (parse_pairs (str_split body "\n")) in
      let _ = refresh_summary () in
      set_status "the server rejected some fields"
    else set_status ("save failed (" ++ show st ++ ")"))
in

let revert = fn (u: unit) ->
  let p = vec_get saved 0 in
  let _ = vec_set current 0 p in
  let _ = vec_set errors 0 Nil in
  let _ = paint p in
  set_status "reverted to the last saved version"
in

// ---- wiring ---------------------------------------------------------
//
// Three events per text field, and each is a different question.
//   input  — the user changed something; record it and recount.
//   blur   — the user is done with this field; now is a fair time to
//            judge it.
//   focus  — the user came back to fix it; stop complaining.
// Doing validation on input instead would tell someone their email is
// invalid while they are still typing the part before the @.

let rec wire = fn (fs: Field list) ->
  match fs with
  | Nil -> ()
  | Cons (f, rest) ->
    let el = dom_get_by_id f.id in
    let _ = dom_on_input el (fn (text: str) ->
      let _ = vec_set current 0 (f.set (vec_get current 0) text) in
      refresh_summary ()) in
    let _ = dom_on_blur el (fn (text: str) ->
      let _ = set_error f.id (f.check text) in
      refresh_summary ()) in
    let _ = dom_on_focus el (fn (u: unit) ->
      // Take the complaint down but keep it in state: the field is
      // still wrong until it is left again and re-checked.
      let _ = show_error f.id "" in
      ()) in
    // A <select> emits change and no keystrokes at all, so without this
    // the theme picker would be inert.
    let _ = dom_on_change el (fn (text: str) ->
      let _ = vec_set current 0 (f.set (vec_get current 0) text) in
      refresh_summary ()) in
    wire rest
in

let _ = wire fields in

let _ = dom_on_change notify_box (fn (text: str) ->
  let _ = vec_set current 0 { (vec_get current 0) | notify = str_eq text "1" } in
  refresh_summary ()) in

let _ = dom_on_click save_btn (fn (u: unit) -> save ()) in
let _ = dom_on_click revert_btn (fn (u: unit) -> revert ()) in

let _ = set_status "loading…" in
let _ = load () in
0
